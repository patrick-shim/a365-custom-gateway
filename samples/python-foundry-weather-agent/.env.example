# Gateway endpoint and user context (server-side only).
# Enter the external agent ID and its matching registration key in the Flask UI.
GATEWAY_BASE_URL=http://127.0.0.1:5080
GATEWAY_TENANT_USER_ID=

# Microsoft Foundry resource endpoint and deployment. Authentication uses
# DefaultAzureCredential; run `az login` for local development. Only root HTTPS
# hosts ending in .cognitiveservices.azure.com or .openai.azure.com are accepted.
# Example: https://YOUR-RESOURCE.cognitiveservices.azure.com/
FOUNDRY_ENDPOINT=
FOUNDRY_MODEL=gpt-5.6-sol
FOUNDRY_API_VERSION=2024-12-01-preview

# Separately supervised weather MCP container
MCP_SERVER_URL=http://127.0.0.1:5091/mcp
WEATHER_TIMEOUT_SECONDS=10

# Local Flask listener (lexical loopback only)
FLASK_HOST=127.0.0.1
FLASK_PORT=5090

# Bounded dependency timeouts in seconds
GATEWAY_TIMEOUT_SECONDS=10
FOUNDRY_TIMEOUT_SECONDS=60
MCP_TIMEOUT_SECONDS=15
CHAT_TURN_TIMEOUT_SECONDS=90
