# Reference only. `gateway up` writes `.env.runtime`, which is the supported
# Compose environment file. Never copy real values from `.env.runtime` here or
# commit credentials.

COMPOSE_PROJECT_NAME=a365-gateway
GATEWAY_API_IMAGE=a365-gateway-api:dev
GATEWAY_WORKER_IMAGE=a365-gateway-worker:dev
GATEWAY_CONSOLE_IMAGE=a365-gateway-console:dev
GATEWAY_API_HOST_PORT=5080
GATEWAY_CONSOLE_HOST_PORT=5081

# Public Console settings. Bootstrap fills these from the owned Entra apps.
CONSOLE_CLIENT_ID=00000000-0000-0000-0000-000000000000
CONSOLE_TENANT_ID=00000000-0000-0000-0000-000000000000
CONSOLE_API_SCOPE=api://00000000-0000-0000-0000-000000000000/access_as_user

# Application configuration uses .NET's double-underscore environment names,
# for example EntraId__TenantId, ConnectionStrings__GatewayDb,
# RabbitMq__ConnectionUri and ObjectStorage__ServiceUrl. Bootstrap supplies the
# complete reviewed set, including secrets and optional provider settings.
