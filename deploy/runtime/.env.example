# Copy to deploy/runtime/.env (gitignored). Never commit real secrets.
# Microsoft product APIs (Entra / Graph / Agent 365 / Purview / Prompt Shields)
# use these when you exercise live tenant features. Infrastructure stays local Docker.

INFRASTRUCTURE_PROVIDER=Runtime

# Local infra (matches docker-compose.yml)
GATEWAY_DB=Host=localhost;Port=5432;Database=gateway;Username=gateway;Password=gateway
RABBITMQ_URI=amqp://gateway:gateway@localhost:5672/
# zenko/cloudserver S3 API (compose service "s3")
S3_SERVICE_URL=http://localhost:9000
S3_ACCESS_KEY=gateway
S3_SECRET_KEY=gatewaysecret
S3_BUCKET=a365-gateway-interactions
VAULT_ADDR=http://localhost:8200
VAULT_TOKEN=gateway-dev-token

# Essential Microsoft product tenant (fill from your app registrations — do not paste passwords into git)
ENTRA_TENANT_ID=
ENTRA_API_CLIENT_ID=
ENTRA_API_AUDIENCE=
# Prefer device code / interactive / certificate auth locally. Do not commit passwords.
