@page "/setup/finish"
@rendermode InteractiveServer
@inject BootstrapExecutionCoordinator Execution
@inject SetupActivityTracker Activity
@inject IHostApplicationLifetime Lifetime
@inject NavigationManager Navigation

<PageTitle>Finish · A365 Gateway Setup</PageTitle>

@if (snapshot.HasVerifiedDeployment && snapshot.VerifiedEndpoints is { } endpoints)
{
    <div class="finish-hero">
        <span class="finish-mark" aria-hidden="true">✓</span>
        <p class="eyebrow">Step 6 of 6</p>
        <h1>Deployment readbacks are verified</h1>
        <p>The canonical bootstrap exited successfully and supplied exactly one validated endpoint result. This confirms the configured infrastructure and control-plane readbacks; it does not prove registration admission, an Active agent, a canary, or production support for the beta Agent 365 Registry dependency.</p>
    </div>

    <div class="review-grid finish-grid">
        <section class="setup-card">
            <div class="card-section">
                <h2>Open Setup Center</h2>
                <p>Continue in the hosted Admin UI to review API-advertised admission and the remaining administrator handoffs.</p>
                <FluentAnchor Appearance="Appearance.Accent" Href="@endpoints.AdminSetupAddress.AbsoluteUri" Target="_blank" rel="noopener noreferrer">Open Setup Center</FluentAnchor>
            </div>
            <div class="card-section">
                <dl class="summary-list">
                    <div><dt>Admin UI base URL</dt><dd><code>@endpoints.AdminUiBaseAddress.AbsoluteUri</code></dd></div>
                    <div><dt>Gateway API base URL</dt><dd><code>@endpoints.ApiBaseAddress.AbsoluteUri</code></dd></div>
                    <div><dt>API health URL</dt><dd><code>@endpoints.ApiHealthAddress.AbsoluteUri</code></dd></div>
                </dl>
            </div>
        </section>

        <section class="setup-card">
            <div class="card-section">
                <h2>First use</h2>
                <ol class="next-list">
                    <li><strong>Sign in as the bootstrap administrator</strong><span>Use the administrator account authorized during bootstrap.</span></li>
                    <li><strong>Register the first agent when authorized</strong><span>Proceed only when Setup Center reports provisioning admission is open for this deployment.</span></li>
                    <li><strong>Save the one-time Gateway key</strong><span>It is shown once and cannot be retrieved later.</span></li>
                    <li><strong>Verify Active state and the canary separately</strong><span>A submitted registration is not proof of completed Agent 365 provisioning or data-plane behavior.</span></li>
                </ol>
            </div>
        </section>
    </div>

    <div class="terminal-fallback">
        <strong>Read-only verification</strong>
        <code>pwsh ./bootstrap/bootstrap.ps1 -Mode Verify -Config ./bootstrap/config.json</code>
        <span>The local setup server will shut down automatically after two minutes. Configuration and safe bootstrap state remain ignored on this computer.</span>
    </div>

    <div class="page-actions">
        <span>No cloud credentials, tokens, or one-time Gateway keys were stored by this wizard.</span>
        <FluentButton Appearance="Appearance.Neutral" OnClick="Close">Close local setup</FluentButton>
    </div>
}
else
{
    <div class="finish-hero">
        <p class="eyebrow">Verification required</p>
        <h1>The Gateway is not marked ready</h1>
        <p>Finish requires a successful bootstrap exit plus exactly one validated deployment-endpoints result. Return to Progress to review the safe status.</p>
    </div>
    <div class="page-actions">
        <FluentAnchor Appearance="Appearance.Accent" Href="/setup/progress">Return to Progress</FluentAnchor>
    </div>
}

@code {
    private BootstrapExecutionSnapshot snapshot = new(null, BootstrapExecutionStatus.NotStarted, [], null, false, null);

    protected override void OnInitialized()
    {
        snapshot = Execution.Snapshot();
        if (!snapshot.HasVerifiedDeployment)
        {
            Navigation.NavigateTo("/setup/progress");
            return;
        }

        Activity.MarkCompleted();
    }

    private void Close() => Lifetime.StopApplication();
}
