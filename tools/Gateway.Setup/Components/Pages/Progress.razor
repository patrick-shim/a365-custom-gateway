@page "/setup/progress"
@implements IDisposable
@inject SetupWizardState State
@inject BootstrapExecutionCoordinator Execution
@inject SetupActivityTracker Activity
@inject NavigationManager Navigation

<PageTitle>Progress · A365 Gateway Setup</PageTitle>

<div class="page-heading">
    <p class="eyebrow">Step 5 of 6</p>
    <h1>@Heading</h1>
    <p>@Description</p>
</div>

<section class="setup-card progress-card" aria-live="polite">
    <div class="progress-header">
        <div>
            <span class="run-status @snapshot.Status.ToString().ToLowerInvariant()">@FormatStatus(snapshot.Status)</span>
            <h2>@FormatCommand(snapshot.Command)</h2>
        </div>
        @if (snapshot.Events.LastOrDefault(item => item.ProgressPercent is not null)?.ProgressPercent is { } progress)
        {
            <span class="progress-value">@progress%</span>
        }
    </div>

    @if (snapshot.Events.LastOrDefault(item => item.ProgressPercent is not null)?.ProgressPercent is { } percent)
    {
        <progress class="progress-bar" max="100" value="@percent"><span>@percent%</span></progress>
    }

    <ol class="event-list" aria-label="Sanitized bootstrap events">
        @foreach (var item in snapshot.Events)
        {
            <li class="event-item @item.Kind.ToString().ToLowerInvariant()">
                <span class="event-dot" aria-hidden="true"></span>
                <div>
                    <strong>@(item.DisplayLabel ?? item.Step ?? FormatKind(item.Kind))</strong>
                    <p>@item.Message</p>
                    <time datetime="@item.TimestampUtc.ToString("O")">@item.TimestampUtc.ToLocalTime().ToString("HH:mm:ss")</time>
                </div>
            </li>
        }
    </ol>
</section>

@if (snapshot.Command == BootstrapCommand.Plan && snapshot.Status == BootstrapExecutionStatus.Succeeded)
{
    <section class="setup-card confirmation-card">
        <h2>The reviewed plan is ready to deploy</h2>
        <p>Deploy / continue starts a new deployment or safely continues checkpoints already owned by this exact plan. Setup supplies the reviewed fingerprint, and bootstrap stops before mutation if source, configuration, or What-If predictions changed.</p>
        <label class="confirm-check">
            <InputCheckbox @bind-Value="mutationConfirmed" />
            <span><strong>I authorize Azure, Entra, Agent 365, SQL, and optional policy changes bound to this Plan fingerprint.</strong><small>I understand interactive administrator handoffs may appear and no production support claim is created.</small></span>
        </label>
        <div class="inline-actions">
            <FluentButton Appearance="Appearance.Accent" Disabled="@(!mutationConfirmed)" OnClick="() => StartMutation(BootstrapCommand.Apply)">Deploy / continue</FluentButton>
        </div>
    </section>
}
else if (snapshot.Command == BootstrapCommand.Plan && snapshot.Status is BootstrapExecutionStatus.Failed or BootstrapExecutionStatus.Cancelled)
{
    <div class="notice error" role="alert"><strong>Plan did not pass</strong><span>Use the specific stopped boundary shown above, then return to review so Setup can prepare and bind the current configuration again. Apply and Resume remain unavailable until Plan succeeds.</span></div>
    <div class="page-actions">
        <FluentAnchor Appearance="Appearance.Accent" Href="/setup/permissions">Review and run Plan again</FluentAnchor>
    </div>
}
else if (StoppedDeploymentAwaitsReview)
{
    <section class="setup-card confirmation-card">
        <h2>@(StoppedRunObserved ? "Review the stopped deployment" : "Review the preserved deployment state")</h2>
        <p>Do not delete <code>.bootstrap</code> state. Setup first runs a read-only resume review in its own process. That review reads the canonical checkpoints, installs nothing, changes no Azure, Entra, Agent 365, SQL, or policy resource, and returns the accepted plan fingerprint plus a single-use authorization. Resume stays unavailable until it does, and the review reports honestly when there is no remaining step to continue.</p>
        <div class="inline-actions">
            <FluentButton Appearance="Appearance.Accent" OnClick="StartResumeReview">Run the read-only review</FluentButton>
            <FluentAnchor Appearance="Appearance.Neutral" Href="/setup/permissions">Review a fresh Plan</FluentAnchor>
        </div>
    </section>
}
else if (snapshot.Command == BootstrapCommand.ResumeReview && snapshot.Status is BootstrapExecutionStatus.Failed or BootstrapExecutionStatus.Cancelled)
{
    <div class="notice error" role="alert"><strong>The resume review authorized nothing</strong><span>Keep <code>.bootstrap</code> state intact. The read-only review stopped at the specific boundary shown above, so Setup holds no resume authorization and no mutation was attempted.</span></div>
    <div class="page-actions">
        <FluentButton Appearance="Appearance.Accent" OnClick="StartResumeReview">Review the stopped deployment again</FluentButton>
        <FluentAnchor Appearance="Appearance.Neutral" Href="/setup/permissions">Review a fresh Plan</FluentAnchor>
    </div>
}
else if (snapshot.ResumeAuthorizationReady)
{
    <section class="setup-card confirmation-card">
        <h2>The reviewed resume is ready to continue</h2>
        <p>The read-only review returned one accepted plan fingerprint and one authorization for the checkpoint it validated. Setup supplies both to the canonical bootstrap, which stops before mutation if source, configuration, or checkpoint state no longer matches. The authorization is spent by this single confirmation and is never replayed.</p>
        <label class="confirm-check">
            <InputCheckbox @bind-Value="resumeConfirmed" />
            <span><strong>I authorize Azure, Entra, Agent 365, SQL, and optional policy changes for the remaining steps bound to this reviewed authorization.</strong><small>I understand interactive administrator handoffs may appear, and the bootstrap remains responsible for deciding which checkpoint can safely continue.</small></span>
        </label>
        <div class="inline-actions">
            <FluentButton Appearance="Appearance.Accent" Disabled="@(!resumeConfirmed)" OnClick="() => StartMutation(BootstrapCommand.Resume)">Resume with the reviewed authorization</FluentButton>
            <FluentAnchor Appearance="Appearance.Neutral" Href="/setup/permissions">Review a fresh Plan</FluentAnchor>
        </div>
    </section>
}
else if (snapshot.HasVerifiedDeployment)
{
    <div class="notice success" role="status"><strong>Deployment completed and verified</strong><span>Bootstrap exited successfully and supplied exactly one validated Admin UI/API endpoint result. Continue to the hosted Setup Center.</span></div>
    <div class="page-actions"><FluentButton Appearance="Appearance.Accent" OnClick="ContinueToFinish">Continue</FluentButton></div>
}

<div class="terminal-fallback">
    <strong>Terminal fallback</strong>
    <span>If this local UI closes, rerun it or use the same ignored configuration with the canonical commands:</span>
    <code>pwsh ./bootstrap/bootstrap.ps1 -Mode Plan -Config ./bootstrap/config.json</code>
    @if (StoppedDeploymentAwaitsReview || snapshot.Command == BootstrapCommand.ResumeReview || snapshot.ResumeAuthorizationReady)
    {
        <code>pwsh ./bootstrap/bootstrap.ps1 -Mode Resume -Config ./bootstrap/config.json</code>
    }
</div>

@code {
    private BootstrapExecutionSnapshot snapshot = new(null, BootstrapExecutionStatus.NotStarted, [], null, false, null);
    private bool mutationConfirmed;
    private bool resumeConfirmed;

    private string Heading => snapshot.IsRunning
        ? $"Running {FormatCommand(snapshot.Command)}"
        : snapshot.Status == BootstrapExecutionStatus.NotStarted
            ? "No command is running"
            : $"{FormatCommand(snapshot.Command)} {FormatStatus(snapshot.Status).ToLowerInvariant()}";

    private string Description => snapshot.IsRunning
        ? "Structured bootstrap events are streamed through a strict redaction boundary. Keep this page and the launch terminal open."
        : "No command is retried automatically. Every mutation requires a fresh explicit action.";

    private bool StoppedRunObserved =>
        snapshot.Command is BootstrapCommand.Apply or BootstrapCommand.Resume &&
        snapshot.Status is BootstrapExecutionStatus.Failed or BootstrapExecutionStatus.Cancelled;

    private bool StoppedDeploymentAwaitsReview =>
        StoppedRunObserved ||
        (snapshot.Status == BootstrapExecutionStatus.NotStarted && State.ExistingConfigurationLoaded);

    protected override void OnInitialized()
    {
        snapshot = Execution.Snapshot();
        Execution.Changed += HandleChanged;
        if (!State.ConfigurationWritten && snapshot.Status == BootstrapExecutionStatus.NotStarted)
        {
            Navigation.NavigateTo("/setup/permissions");
        }
    }

    private void HandleChanged()
    {
        _ = InvokeAsync(() =>
        {
            snapshot = Execution.Snapshot();
            StateHasChanged();
        });
    }

    private void StartMutation(BootstrapCommand command)
    {
        var confirmed = command == BootstrapCommand.Resume
            ? resumeConfirmed
            : mutationConfirmed;
        if (Execution.TryStart(command, confirmed))
        {
            mutationConfirmed = false;
            resumeConfirmed = false;
            Activity.Touch();
            snapshot = Execution.Snapshot();
        }
    }

    private void StartResumeReview()
    {
        if (Execution.TryStartResumeReview())
        {
            mutationConfirmed = false;
            resumeConfirmed = false;
            Activity.Touch();
            snapshot = Execution.Snapshot();
        }
    }

    private void ContinueToFinish() => Navigation.NavigateTo("/setup/finish");

    private static string FormatCommand(BootstrapCommand? value) => value switch
    {
        BootstrapCommand.Plan => "Plan",
        BootstrapCommand.Apply => "Apply",
        BootstrapCommand.Resume => "Resume",
        BootstrapCommand.ResumeReview => "Resume review",
        _ => "Waiting for Plan"
    };

    private static string FormatStatus(BootstrapExecutionStatus value) => value switch
    {
        BootstrapExecutionStatus.NotStarted => "Not started",
        BootstrapExecutionStatus.Running => "Running",
        BootstrapExecutionStatus.Succeeded => "Succeeded",
        BootstrapExecutionStatus.Failed => "Stopped",
        BootstrapExecutionStatus.Cancelled => "Interrupted",
        _ => "Unknown"
    };

    private static string FormatKind(BootstrapProgressKind value) => value switch
    {
        BootstrapProgressKind.Information => "Information",
        BootstrapProgressKind.Step => "Step",
        BootstrapProgressKind.Success => "Verified event",
        BootstrapProgressKind.Warning => "Warning",
        BootstrapProgressKind.Error => "Safe error",
        BootstrapProgressKind.Withheld => "Redacted output",
        _ => "Event"
    };

    public void Dispose() => Execution.Changed -= HandleChanged;
}
