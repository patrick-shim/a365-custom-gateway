@page "/setup/profile"
@implements IDisposable
@inject SetupWizardState State
@inject IAzureAccountDiscovery Discovery
@inject SetupActivityTracker Activity
@inject NavigationManager Navigation

<PageTitle>Profile and capabilities · A365 Gateway Setup</PageTitle>

<div class="page-heading">
    <p class="eyebrow">Step 3 of 6</p>
    <h1>Choose the deployment profile</h1>
    <p>Setup fills safe defaults and keeps paid or preview capabilities explicit. You can review every public value before a file is written.</p>
</div>

@if (State.ExistingConfigurationLoaded)
{
    <div class="notice neutral" role="status">
        <strong>Existing deployment identity is locked for recovery.</strong>
        <span>Review these imported public values, then create a fresh Plan and explicitly Resume or Apply. Setup will not silently change a configuration that may already own resumable state.</span>
    </div>
    @if (State.ExistingConfigurationMigrationNotice is not null)
    {
        <div class="notice warning" role="status">
            <strong>Legacy Purview fields are migration information only.</strong>
            <span>@State.ExistingConfigurationMigrationNotice Preserve this configuration and its <code>.bootstrap/</code> state; use the recovery path shown on Progress rather than rewriting it here.</span>
        </div>
    }
}

<EditForm Model="State.Form" OnValidSubmit="Continue" class="setup-card form-card">
    <DataAnnotationsValidator />
    <ValidationSummary />

    <section class="card-section" aria-labelledby="profile-heading">
        <div class="section-heading"><div><h2 id="profile-heading">Profile</h2><p>The profile controls environment safety defaults; it does not bypass backend authorization.</p></div></div>
        <div class="field-grid">
            <div class="field full">
                <label for="profile">Deployment profile</label>
                <select id="profile" class="control" value="@State.Form.Profile" @onchange="ChangeProfile" disabled="@State.ExistingConfigurationLoaded">
                    @foreach (var profile in Enum.GetValues<DeploymentProfile>())
                    {
                        <option value="@profile">@profile.DisplayName()</option>
                    }
                </select>
                <small>@ProfileDescription</small>
            </div>
            <div class="field">
                <label for="project-name">Project name</label>
                <InputText id="project-name" class="control" @bind-Value="State.Form.ProjectName" @oninput="ProjectNameChanged" autocomplete="off" disabled="@State.ExistingConfigurationLoaded" />
                <ValidationMessage For="@(() => State.Form.ProjectName)" />
                <small>2–8 lowercase letters or numbers; starts with a letter.</small>
            </div>
            <div class="field">
                <label for="location">Azure region</label>
                @if (locationDiscoveryRunning)
                {
                    <div class="loading-row" role="status"><FluentProgressRing /> <span>Reading available regions for the selected subscription…</span></div>
                }
                else if (State.LocationDiscoveryGuidance is not null)
                {
                    <div class="notice warning" role="alert"><strong>Regions could not be loaded</strong><span>@State.LocationDiscoveryGuidance</span></div>
                    <FluentButton Type="ButtonType.Button" Appearance="Appearance.Neutral" OnClick="DiscoverLocationsAsync">Retry region discovery</FluentButton>
                }
                else if (State.Locations.Count > 0)
                {
                    <select id="location" class="control" value="@State.Form.Location" @onchange="SelectLocation" disabled="@State.ExistingConfigurationLoaded">
                        <option value="" disabled>Choose an available Azure region…</option>
                        @foreach (var location in State.Locations)
                        {
                            <option value="@location.Name">@location.DisplayName · @location.Name</option>
                        }
                    </select>
                }
                <ValidationMessage For="@(() => State.Form.Location)" />
                @if (State.LocationSelectionIssue is not null)
                {
                    <div class="notice error" role="alert"><strong>Selected region unavailable</strong><span>@State.LocationSelectionIssue</span></div>
                }
                @if (locationSelectionRequired)
                {
                    <div class="notice error" role="alert"><strong>Region selection required</strong><span>Choose one of the regions returned for the exact selected subscription.</span></div>
                }
                <small>The label is for people; Setup stores the canonical Azure name shown after the separator, such as <code>koreacentral</code>.</small>
            </div>
            <div class="field">
                <label for="resource-group">Resource group</label>
                <InputText id="resource-group" class="control" @bind-Value="State.Form.ResourceGroupName" @oninput="eventArgs => State.Form.ResourceGroupName = eventArgs.Value?.ToString() ?? string.Empty" autocomplete="off" disabled="@State.ExistingConfigurationLoaded" />
                <ValidationMessage For="@(() => State.Form.ResourceGroupName)" />
            </div>
            <div class="field">
                <label for="alert-email">Alert email</label>
                <InputText id="alert-email" class="control" type="email" @bind-Value="State.Form.AlertEmail" @oninput="eventArgs => State.Form.AlertEmail = eventArgs.Value?.ToString() ?? string.Empty" autocomplete="email" disabled="@State.ExistingConfigurationLoaded" />
                <ValidationMessage For="@(() => State.Form.AlertEmail)" />
                <small>Stored only in ignored bootstrap configuration and Azure alert settings.</small>
            </div>
            <div class="field full" role="group" aria-labelledby="manager-authority-heading">
                <h3 id="manager-authority-heading">Agent 365 manager authority</h3>
                <small>Setup reads existing typed Agent ID blueprints and exact tenant service-principal metadata through Microsoft Graph v1.0. Discovery is read-only; it never authorizes a returned ID.</small>

                @if (managerDiscoveryRunning)
                {
                    <div class="loading-row" role="status"><FluentProgressRing /> <span>Reading the bounded typed-blueprint and service-principal inventory…</span></div>
                }
                else if (State.ManagerApplicationsAccepted)
                {
                    <div class="notice success" role="status">
                        <strong>Exact manager application set accepted</strong>
                        <span>@State.ManagerApplicationProvenance for subscription <code>@State.Form.SubscriptionId</code> and tenant <code>@State.Form.TenantId</code>. Bootstrap will still require exact seed-blueprint equality and later API/worker compatibility checks.</span>
                    </div>
                    <ul class="permission-list" aria-label="Accepted Agent 365 manager application IDs">
                        @foreach (var managerId in State.Form.GetReviewedManagerApplicationIds())
                        {
                            <li><strong><code>@managerId</code></strong><span>Accepted for tenant <code>@State.Form.TenantId</code>; this is not a universal Gateway constant.</span></li>
                        }
                    </ul>
                    @if (!State.ExistingConfigurationLoaded)
                    {
                        <FluentButton Type="ButtonType.Button" Appearance="Appearance.Neutral" OnClick="DiscoverManagerApplicationsAsync">Discover again</FluentButton>
                    }
                }
                else
                {
                    @if (State.ManagerApplicationDiscoveryGuidance is not null)
                    {
                        <div class="notice warning" role="alert"><strong>Discovery did not produce an acceptable set</strong><span>@State.ManagerApplicationDiscoveryGuidance</span></div>
                    }

                    @if (State.ManagerApplicationCandidates.Count > 0)
                    {
                        <div class="notice neutral" role="status">
                            <strong>Review the proposed tenant set</strong>
                            <span>Provenance: @State.ManagerApplicationProvenance for subscription <code>@State.Form.SubscriptionId</code> and tenant <code>@State.Form.TenantId</code>. Confirm the provider identity below before accepting; observed blueprint values are evidence, not authority by themselves.</span>
                        </div>
                        <ul class="permission-list" aria-label="Discovered Agent 365 manager application candidates">
                            @foreach (var candidate in State.ManagerApplicationCandidates)
                            {
                                <li>
                                    <strong>@candidate.DisplayName · <code>@candidate.ApplicationId</code></strong>
                                    <span>Tenant service principal <code>@candidate.ServicePrincipalObjectId</code>; @PublisherSummary(candidate); type @candidate.ServicePrincipalType; observed on @candidate.BlueprintReferenceCount typed blueprint(s)@BlueprintSummary(candidate).</span>
                                </li>
                            }
                        </ul>
                        <FluentButton Type="ButtonType.Button" Appearance="Appearance.Accent" OnClick="AcceptManagerApplications">Accept this exact reviewed set</FluentButton>
                    }
                    else
                    {
                        <FluentButton Type="ButtonType.Button" Appearance="Appearance.Neutral" OnClick="DiscoverManagerApplicationsAsync">Discover from selected tenant</FluentButton>
                    }
                }

                <ValidationMessage For="@(() => State.Form.ReviewedManagerApplicationIds)" />
                @if (managerReviewRequired)
                {
                    <div class="notice error" role="alert"><strong>Explicit acceptance required</strong><span>Discover and accept the exact tenant manager application set before continuing.</span></div>
                }
            </div>
        </div>
    </section>

    <section class="card-section" aria-labelledby="features-heading">
        <div class="section-heading"><div><h2 id="features-heading">Capabilities to install</h2><p>Choose shared deployment capabilities. A checked capability does not enable every agent or prove provider readiness.</p></div></div>
        <div class="feature-grid" role="radiogroup" aria-label="Capability preset">
            <label class="feature-card @(State.Form.CapabilityPreset == CapabilityPreset.FullEvaluation ? "selected" : string.Empty)">
                <input type="radio" name="capability-preset" value="@CapabilityPreset.FullEvaluation" checked="@(State.Form.CapabilityPreset == CapabilityPreset.FullEvaluation)" @onchange="ChangeCapabilityPreset" disabled="@(State.ExistingConfigurationLoaded || State.Form.Profile != DeploymentProfile.QuickDevelopment)" />
                <span><strong>Full evaluation</strong><small>Recommended and selected by default for Quick development. Includes Agent 365 Registry beta, Prompt Shields infrastructure, and Purview prerequisites.</small></span>
            </label>
            <label class="feature-card @(State.Form.CapabilityPreset == CapabilityPreset.CoreGateway ? "selected" : string.Empty)">
                <input type="radio" name="capability-preset" value="@CapabilityPreset.CoreGateway" checked="@(State.Form.CapabilityPreset == CapabilityPreset.CoreGateway)" @onchange="ChangeCapabilityPreset" disabled="@State.ExistingConfigurationLoaded" />
                <span><strong>Core Gateway</strong><small>Installs the Gateway and, for Quick development only, its explicitly acknowledged registration beta capability. It does not install Prompt Shields or Purview prerequisites.</small></span>
            </label>
            <label class="feature-card @(State.Form.CapabilityPreset == CapabilityPreset.Custom ? "selected" : string.Empty)">
                <input type="radio" name="capability-preset" value="@CapabilityPreset.Custom" checked="@(State.Form.CapabilityPreset == CapabilityPreset.Custom)" @onchange="ChangeCapabilityPreset" disabled="@State.ExistingConfigurationLoaded" />
                <span><strong>Custom</strong><small>Independently include or exclude Prompt Shields infrastructure and Purview prerequisites. Registry beta remains impossible in staging and production.</small></span>
            </label>
        </div>

        <div class="feature-grid">
            <label class="feature-card @(State.Form.AllowDevelopmentRegistryPreview ? "selected" : string.Empty)">
                <input type="checkbox" checked="@State.Form.AllowDevelopmentRegistryPreview" disabled />
                <span><strong>Agent 365 Registry beta</strong><small>Development only. Microsoft does not support this beta for production, and every registration still requires a signed-in Gateway Administrator OBO action.</small></span>
            </label>
            <label class="feature-card @(State.Form.PromptShieldEnabled ? "selected" : string.Empty)">
                <input type="checkbox" checked="@State.Form.PromptShieldEnabled" @onchange="ChangePromptShieldEnabled" disabled="@(State.ExistingConfigurationLoaded || State.Form.CapabilityPreset != CapabilityPreset.Custom)" />
                <span><strong>Prompt Shields infrastructure</strong><small>Creates Azure AI Content Safety with local keys disabled and managed-identity RBAC. F0 has limited subscription quota; S0 and usage can incur Azure cost. Per-agent enablement happens later in Gateway Settings.</small></span>
            </label>
            <label class="feature-card @(State.Form.PurviewEnabled ? "selected" : string.Empty)">
                <input type="checkbox" checked="@State.Form.PurviewEnabled" @onchange="ChangePurviewEnabled" disabled="@(State.ExistingConfigurationLoaded || State.Form.CapabilityPreset != CapabilityPreset.Custom)" />
                <span><strong>Microsoft Purview prerequisites</strong><small>Prepares identities, exact Graph/compliance RBAC, certificate and Key Vault access, and runtime wiring. Bootstrap does not discover a sensitive information type, author policy, or claim readiness.</small></span>
            </label>
        </div>

        @if (State.Form.AllowDevelopmentRegistryPreview)
        {
            <label class="confirm-check">
                <InputCheckbox @bind-Value="State.Form.RegistryBetaAcknowledged" disabled="@State.ExistingConfigurationLoaded" />
                <span><strong>I acknowledge the Agent 365 Registry beta boundary.</strong><small>This capability is unsupported for production and cannot be enabled in staging or production.</small></span>
            </label>
        }

        @if (State.Form.PromptShieldEnabled)
        {
            <div class="field compact-field">
                <label for="prompt-sku">Prompt Shields SKU</label>
                <InputSelect id="prompt-sku" class="control" @bind-Value="State.Form.PromptShieldSkuName" disabled="@State.ExistingConfigurationLoaded">
                    <option value="F0">F0 · limited free quota when available</option>
                    <option value="S0">S0 · paid</option>
                </InputSelect>
            </div>
            <label class="confirm-check">
                <InputCheckbox @bind-Value="State.Form.PromptShieldCostAndQuotaAcknowledged" disabled="@State.ExistingConfigurationLoaded" />
                <span><strong>I reviewed Prompt Shields quota and cost.</strong><small>F0 is limited to one available free Content Safety account per subscription and soft-deleted accounts can retain that quota; S0 and service usage incur Azure charges.</small></span>
            </label>
        }

        @if (State.Form.PurviewEnabled)
        {
            <label class="confirm-check">
                <InputCheckbox @bind-Value="State.Form.PurviewAuthorityRequirementsAcknowledged" disabled="@State.ExistingConfigurationLoaded" />
                <span><strong>I reviewed the Purview authority requirements.</strong><small>Capability preparation needs tenant-approved identity and RBAC authority. After deployment, a signed-in Gateway Administrator uses Settings; any Security &amp; Compliance PowerShell companion remains interactive and Windows-only.</small></span>
            </label>
        }
    </section>

    <div class="form-footer">
        <FluentAnchor Appearance="Appearance.Neutral" Href="/setup/account">Back</FluentAnchor>
        <FluentButton Type="ButtonType.Submit" Appearance="Appearance.Accent" Disabled="@(State.ExistingConfigurationMigrationNotice is not null || !State.HasValidSelectedLocation || !State.ManagerApplicationsAccepted || !State.Form.HasRequiredCapabilityAcknowledgements || locationDiscoveryRunning || managerDiscoveryRunning)">Review permissions</FluentButton>
    </div>
</EditForm>

@code {
    private readonly CancellationTokenSource disposeCts = new();
    private bool locationDiscoveryRunning;
    private bool locationSelectionRequired;
    private bool managerDiscoveryRunning;
    private bool managerReviewRequired;

    private string ProfileDescription => State.Form.Profile switch
    {
        DeploymentProfile.QuickDevelopment => "Complete development foundation. Full evaluation is recommended by default; acknowledge the Registry beta boundary before Plan.",
        DeploymentProfile.StagingFoundation => "Staging foundation with Registry creation closed and no production-readiness claim.",
        DeploymentProfile.ProductionSafeFoundation => "Production-safe foundation only; the preview Registry boundary remains closed.",
        _ => string.Empty
    };

    protected override async Task OnInitializedAsync()
    {
        if (!State.HasEnabledSelectedSubscription)
        {
            Navigation.NavigateTo("/setup/account");
            return;
        }

        if (!State.HasCurrentLocationInventory)
        {
            await DiscoverLocationsAsync();
        }
    }

    private async Task DiscoverLocationsAsync()
    {
        locationDiscoveryRunning = true;
        locationSelectionRequired = false;
        State.BeginLocationDiscovery();
        Activity.Touch();
        try
        {
            var result = await Discovery.DiscoverLocationsAsync(
                State.Form.SubscriptionId,
                disposeCts.Token);
            State.ApplyLocationDiscovery(result);
        }
        catch (OperationCanceledException) when (disposeCts.IsCancellationRequested)
        {
        }
        finally
        {
            locationDiscoveryRunning = false;
        }
    }

    private void SelectLocation(ChangeEventArgs args)
    {
        locationSelectionRequired = !State.SelectLocation(args.Value?.ToString());
        if (!locationSelectionRequired)
        {
            Activity.Touch();
        }
    }

    private void ChangeProfile(ChangeEventArgs args)
    {
        if (Enum.TryParse<DeploymentProfile>(args.Value?.ToString(), out var profile))
        {
            State.Form.ApplyProfile(profile);
            Activity.Touch();
        }
    }

    private void ChangeCapabilityPreset(ChangeEventArgs args)
    {
        if (Enum.TryParse<CapabilityPreset>(args.Value?.ToString(), out var preset))
        {
            State.Form.ApplyCapabilityPreset(preset);
            Activity.Touch();
        }
    }

    private void ChangePromptShieldEnabled(ChangeEventArgs args)
    {
        State.Form.PromptShieldEnabled = args.Value is bool value && value;
        if (!State.Form.PromptShieldEnabled)
        {
            State.Form.PromptShieldCostAndQuotaAcknowledged = false;
        }
        Activity.Touch();
    }

    private void ProjectNameChanged(ChangeEventArgs args)
    {
        State.Form.ApplyProjectName(args.Value?.ToString() ?? string.Empty);
    }

    private void ChangePurviewEnabled(ChangeEventArgs args)
    {
        var enabled = args.Value is bool value && value;
        State.Form.PurviewEnabled = enabled;
        if (!enabled)
        {
            State.Form.PurviewAuthorityRequirementsAcknowledged = false;
        }
        Activity.Touch();
    }

    private async Task DiscoverManagerApplicationsAsync()
    {
        managerDiscoveryRunning = true;
        managerReviewRequired = false;
        State.BeginManagerApplicationDiscovery();
        Activity.Touch();
        try
        {
            var result = await Discovery.DiscoverManagerApplicationsAsync(
                State.Form.SubscriptionId,
                State.Form.TenantId,
                disposeCts.Token);
            State.ApplyManagerApplicationDiscovery(result);
        }
        catch (OperationCanceledException) when (disposeCts.IsCancellationRequested)
        {
        }
        finally
        {
            managerDiscoveryRunning = false;
        }
    }

    private void AcceptManagerApplications()
    {
        managerReviewRequired = !State.AcceptDiscoveredManagerApplications();
        Activity.Touch();
    }

    private static string PublisherSummary(ManagerApplicationCandidate candidate) =>
        $"publisher {candidate.PublisherName}; verified publisher {candidate.VerifiedPublisherName}";

    private static string BlueprintSummary(ManagerApplicationCandidate candidate) =>
        candidate.ReferencingBlueprintNames.Count == 0
            ? string.Empty
            : $" ({string.Join(", ", candidate.ReferencingBlueprintNames)})";

    private void Continue()
    {
        if (!State.HasValidSelectedLocation)
        {
            locationSelectionRequired = true;
            return;
        }

        if (!State.ManagerApplicationsAccepted)
        {
            managerReviewRequired = true;
            return;
        }

        if (!State.Form.HasRequiredCapabilityAcknowledgements)
        {
            return;
        }

        Activity.Touch();
        Navigation.NavigateTo("/setup/permissions");
    }

    public void Dispose()
    {
        disposeCts.Cancel();
        disposeCts.Dispose();
    }
}
