#!/usr/bin/env bash
set -euo pipefail

gateway_root="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
bootstrap_entry="$gateway_root/bootstrap/bootstrap.ps1"

show_help() {
  cat <<'EOF'
A365 Custom Gateway

Usage:
  ./gateway [command] [options]

Commands:
  setup       Start the temporary loopback-only Fluent setup UI
  up          Configure (when needed), plan, confirm, deploy/resume, and verify
  init        Create a reviewed non-secret configuration interactively
  doctor      Check local tools, configuration, and Azure sign-in readiness
  plan        Compile bootstrap Bicep, show operations, and run Azure What-If
  apply       Apply an accepted, current plan
  resume      Resume an interrupted accepted plan
  recover-database
              Run the reviewed, one-time recovery for an eligible failed database bootstrap
  repair-database
              Run the one-shot manual repair after both automatic database recoveries failed
  continue-bootstrap
              Continue only pending steps after an exact completed database recovery
  upgrade-admin-ui
              Build and promote only the Admin UI of a completed bootstrap deployment
  status      Show checkpoint and truthful readiness status without Azure calls
  verify      Rerun the read-only deployment verification gate
  open        Open the recorded verified Admin UI HTTPS endpoint
  diagnose    Write a sanitized local diagnostic bundle

Common options:
  --config PATH          Use a specific non-secret configuration file
  --json                 Emit structured JSON results/events
  --non-interactive      Refuse interactive authentication or prompts
  --yes                  Explicitly accept the exact plan for automated plan/up/resume/recovery
  --expected-plan-fingerprint SHA256
                        Require the fresh plan to match an external approval
  --event-stream-only    With --json, emit bounded typed progress events only
  --force                Replace configuration during `init`
  --open                 Open the Admin UI after successful deployment
  --no-install           Do not install missing supported prerequisites
  --diagnostic-path PATH Write the diagnostic bundle to PATH
  -h, --help             Show this help

There is intentionally no destroy, Registry replay, retained-message, or cleanup command.
EOF
}

check_setup_prerequisites() {
  local ready=1
  local dotnet_version=''

  if ! command -v dotnet >/dev/null 2>&1; then
    printf 'Setup requires the .NET 10 SDK. Install: https://dotnet.microsoft.com/download/dotnet/10.0\n' >&2
    ready=0
  elif ! dotnet_version="$(dotnet --version 2>/dev/null)" || [[ ! "$dotnet_version" =~ ^10\. ]]; then
    printf 'Setup requires the .NET 10 SDK. Install: https://dotnet.microsoft.com/download/dotnet/10.0\n' >&2
    ready=0
  fi

  if ! command -v pwsh >/dev/null 2>&1 ||
     ! pwsh -NoLogo -NoProfile -NonInteractive -Command 'if ($PSVersionTable.PSVersion.Major -ge 7) { exit 0 }; exit 1' >/dev/null 2>&1; then
    printf 'Setup requires PowerShell 7 (pwsh). Install: https://aka.ms/powershell-release?tag=stable\n' >&2
    ready=0
  fi

  if ! command -v az >/dev/null 2>&1 || ! az version >/dev/null 2>&1; then
    printf 'Setup requires Azure CLI (az). Install: https://learn.microsoft.com/cli/azure/install-azure-cli\n' >&2
    ready=0
  fi

  if ((ready == 0)); then
    printf 'Install or repair the listed tools, open a new terminal, and rerun ./gateway setup.\n' >&2
    return 1
  fi
}

command_name="${1:-up}"
if (($# > 0)); then shift; fi
if [[ "$command_name" == 'continue-bootstrap' ]]; then
  continuation_entry="$gateway_root/operations/continue-bootstrap-after-database-recovery.ps1"
  continuation_args=(-NoLogo -NoProfile -File "$continuation_entry")
  while (($# > 0)); do
    case "$1" in
      --config)
        (($# >= 2)) || { echo '--config requires a path.' >&2; exit 2; }
        continuation_args+=(-Config "$2")
        shift 2
        ;;
      --yes) continuation_args+=(-Yes); shift ;;
      --non-interactive) continuation_args+=(-NonInteractive); shift ;;
      --expected-continuation-fingerprint)
        (($# >= 2)) || { echo '--expected-continuation-fingerprint requires sha256:<64 lowercase hex>.' >&2; exit 2; }
        continuation_args+=(-ExpectedContinuationFingerprint "$2")
        shift 2
        ;;
      --json) shift ;;
      -h|--help)
        printf 'Usage: ./gateway continue-bootstrap --config PATH [--yes --expected-continuation-fingerprint SHA256] [--non-interactive]\n'
        exit 0
        ;;
      *) printf 'Unknown continue-bootstrap option: %s\n' "$1" >&2; exit 2 ;;
    esac
  done
  if ! command -v pwsh >/dev/null 2>&1; then
    printf 'PowerShell 7 is required to continue the recovered bootstrap.\n' >&2
    exit 1
  fi
  exec pwsh "${continuation_args[@]}"
fi
if [[ "$command_name" == 'upgrade-admin-ui' ]]; then
  upgrade_entry="$gateway_root/operations/upgrade-bootstrap-admin-ui.ps1"
  upgrade_args=(-NoLogo -NoProfile -File "$upgrade_entry")
  while (($# > 0)); do
    case "$1" in
      --config)
        (($# >= 2)) || { echo '--config requires a path.' >&2; exit 2; }
        upgrade_args+=(-Config "$2")
        shift 2
        ;;
      --yes) upgrade_args+=(-Yes); shift ;;
      --non-interactive) upgrade_args+=(-NonInteractive); shift ;;
      -h|--help)
        printf 'Usage: ./gateway upgrade-admin-ui --config PATH --yes [--non-interactive]\n'
        exit 0
        ;;
      *) printf 'Unknown upgrade-admin-ui option: %s\n' "$1" >&2; exit 2 ;;
    esac
  done
  if ! command -v pwsh >/dev/null 2>&1; then
    printf 'PowerShell 7 is required to run the Admin UI upgrade.\n' >&2
    exit 1
  fi
  exec pwsh "${upgrade_args[@]}"
fi
case "$command_name" in
  setup)
    setup_args=(--repo-root "$gateway_root")
    while (($# > 0)); do
      case "$1" in
        --no-open) setup_args+=(--no-open); shift ;;
        -h|--help)
          printf 'Usage: ./gateway setup [--no-open]\n'
          exit 0
          ;;
        *) printf 'Unknown setup option: %s\n' "$1" >&2; exit 2 ;;
      esac
    done
    check_setup_prerequisites || exit 1
    exec dotnet run --project "$gateway_root/tools/Gateway.Setup/Gateway.Setup.csproj" -- "${setup_args[@]}"
    ;;
  up) mode='Up' ;;
  init) mode='Init' ;;
  doctor) mode='Doctor' ;;
  plan) mode='Plan' ;;
  apply) mode='Apply' ;;
  resume) mode='Resume' ;;
  recover-database) mode='RecoverDatabase' ;;
  repair-database) mode='RepairDatabase' ;;
  status) mode='Status' ;;
  verify) mode='Verify' ;;
  open) mode='Open' ;;
  diagnose) mode='Diagnose' ;;
  help|-h|--help) show_help; exit 0 ;;
  *)
    printf 'Unknown command: %s\n\n' "$command_name" >&2
    show_help >&2
    exit 2
    ;;
esac

if ! command -v pwsh >/dev/null 2>&1; then
  cat >&2 <<'EOF'
PowerShell 7 is required to run the Gateway bootstrap.
  macOS: brew install powershell
  Windows: run gateway.cmd (it can install PowerShell with winget)
  Linux: https://learn.microsoft.com/powershell/scripting/install/installing-powershell-on-linux
EOF
  exit 1
fi

pwsh_args=(-NoLogo -NoProfile -File "$bootstrap_entry" -Mode "$mode")
while (($# > 0)); do
  case "$1" in
    --config)
      (($# >= 2)) || { echo '--config requires a path.' >&2; exit 2; }
      pwsh_args+=(-Config "$2")
      shift 2
      ;;
    --json)
      pwsh_args+=(-OutputFormat Json)
      shift
      ;;
    --non-interactive)
      pwsh_args+=(-NonInteractive)
      shift
      ;;
    --yes)
      pwsh_args+=(-Yes)
      shift
      ;;
    --expected-plan-fingerprint)
      (($# >= 2)) || { echo '--expected-plan-fingerprint requires sha256:<64 lowercase hex>.' >&2; exit 2; }
      pwsh_args+=(-ExpectedPlanFingerprint "$2")
      shift 2
      ;;
    --event-stream-only)
      pwsh_args+=(-EventStreamOnly)
      shift
      ;;
    --force)
      pwsh_args+=(-Force)
      shift
      ;;
    --open)
      pwsh_args+=(-OpenBrowser)
      shift
      ;;
    --no-install)
      pwsh_args+=('-InstallPrerequisites:$false')
      shift
      ;;
    --diagnostic-path)
      (($# >= 2)) || { echo '--diagnostic-path requires a path.' >&2; exit 2; }
      pwsh_args+=(-DiagnosticPath "$2")
      shift 2
      ;;
    -h|--help)
      show_help
      exit 0
      ;;
    *)
      printf 'Unknown option: %s\n' "$1" >&2
      exit 2
      ;;
  esac
done

exec pwsh "${pwsh_args[@]}"
