@using System.Text
@using Gateway.Contracts.Dtos

<details class="operation-panel protection-technical-details">
    <summary>Technical operation details</summary>
<section aria-labelledby="protection-operation-heading">
    <div class="operation-heading">
        <div>
            <h3 id="protection-operation-heading">Latest protection operation</h3>
            <span class="section-caption">Saved Gateway steps for this operation, not a live view of Microsoft activity. Skipped means not run, not a passed check. The result and next action are explained above.</span>
        </div>
        <StatusPill Value="@DisplayStatus(Operation.Status)" />
    </div>
    @if (Operation.RuntimeTest is { } runtime && RuntimeTestUiProtocol.IsSafeReport(runtime, Operation.Id))
    {
        <PurviewRuntimeTestReport Report="runtime" />
    }

    @if (Operation.Blockers.Count > 0)
    {
        <div class="deployment-callout">
            <strong>@(Operation.RequiresManualIntervention ? "Administrator attention is required." : "The operation is waiting.")</strong>
            <ul>
                @foreach (var blocker in Operation.Blockers.Select(ExplainBlocker).Distinct())
                {
                    <li>@blocker</li>
                }
            </ul>
        </div>
    }

    @if (!string.IsNullOrWhiteSpace(NextActionOverride) || !string.IsNullOrWhiteSpace(Operation.RequiredAction))
    {
        <p class="operation-next-action"><strong>Next step:</strong> @(NextActionOverride ?? ExplainRequiredAction(Operation))</p>
    }

    @if (!string.IsNullOrWhiteSpace(Operation.FailureCode))
    {
        <p class="operation-failure-code">Failure reference: <code>@Operation.FailureCode</code>. Include this reference and the correlation ID when requesting support.</p>
    }

    <ol class="timeline operation-timeline" aria-label="Protection operation steps">
        @foreach (var step in Operation.Steps.OrderBy(item => item.OrderIndex))
        {
            <li class="timeline-item">
                <span class="timeline-dot" aria-hidden="true"></span>
                <div class="timeline-title">
                    @ProtectionOperationPresentation.StepTitle(Operation.Type, step.Step)
                    <StatusPill Value="@DisplayStatus(step.Status)" />
                </div>
                <p class="field-help">@ProtectionOperationPresentation.StepExplanation(Operation.Type, step)</p>
                <div class="timeline-meta">
                    @if (step.CompletedAtUtc is { } completed)
                    {
                        <span>Finished <time datetime="@AsUtc(completed).ToString("O")">@FormatUtc(completed)</time></span>
                    }
                    else if (step.StartedAtUtc is { } started)
                    {
                        <span>Started <time datetime="@AsUtc(started).ToString("O")">@FormatUtc(started)</time></span>
                    }
                    else
                    {
                        <span>Not started</span>
                    }
                    @if (step.AttemptCount > 1)
                    {
                        <span> · Attempt @step.AttemptCount</span>
                    }
                </div>
            </li>
        }
    </ol>

    <div class="operation-meta">
        <span>Updated <time datetime="@AsUtc(Operation.UpdatedAtUtc).ToString("O")">@FormatUtc(Operation.UpdatedAtUtc)</time></span>
        <span>Correlation ID: <code>@Operation.CorrelationId</code></span>
    </div>
</section>
</details>

@code {
    [Parameter, EditorRequired] public ProtectionAdminOperationDto Operation { get; set; } = default!;
    [Parameter] public string? NextActionOverride { get; set; }

    private static string DisplayStatus(string status) => status switch
    {
        "AwaitingAdministrator" or "AwaitingAdministratorAction" => "Awaiting admin",
        "WaitingForPropagation" or "PendingPropagation" => "Pending propagation",
        "VerificationFailed" or "RequiresManualIntervention" => "Failed",
        "Succeeded" or "Completed" => "Completed",
        _ => SplitWords(status)
    };

    private static string ExplainRequiredAction(ProtectionAdminOperationDto operation)
    {
        if (operation.RequiredAction == "CompletePurviewTenantConnection" ||
            operation is
            {
                Type: "ConnectPurviewTenant",
                Status: "AwaitingAdministrator"
            })
        {
            return "On Windows, follow the current Gateway companion instructions. Copy its complete result line into Paste companion result, then review and submit it for independent verification of this existing connection. No text file is required.";
        }

        return operation.RequiredAction switch
        {
            "WaitForPropagation" =>
                "Wait for Microsoft Purview propagation, then refresh or reconcile.",
            "Reconcile" =>
                "Ask a Gateway Administrator to run a fresh exact-state check.",
            "ValidateRuntime" =>
                "Use Test protection after registration to review approved examples for the saved profile and a clean negative. Results verify behavior in effective policy scope, not matched-SIT attribution.",
            "ReviewRuntimeSamples" =>
                "Use Verify shared profile for a fresh approved suite or the remaining reviewed batch; never replay content automatically. For simulation this continues optional diagnostics and is not required to use the configured policy.",
            "AwaitBlueprint" or "WaitForBlueprint" or "ResolveBlueprint" =>
                "Wait for this registration's exact blueprint to resolve. Deferred policy configuration is not effective protection yet.",
            "Retry" =>
                "Retry only when the Gateway enables the reviewed action.",
            _ => "Follow the safe guidance shown by the Gateway or contact a Gateway Administrator."
        };
    }

    private static string ExplainBlocker(string blocker) => blocker switch
    {
        "AwaitingAdministrator" or "AdministratorActionRequired" =>
            "A Gateway Administrator must complete the next reviewed step.",
        "PropagationPending" =>
            "Microsoft Purview has not made the reviewed change available everywhere yet.",
        "TokenRefreshPending" or "TokenRolesPending" =>
            "The Gateway runtime is waiting for updated permissions.",
        "RuntimeValidationRequired" =>
            "Approved sample behavior has not been verified in the effective policy scope.",
        "InventoryExpired" =>
            "The sensitive information type inventory has expired. Renew the connection and review the exact configuration again.",
        "AwaitingBlueprint" =>
            "The reviewed policy is waiting for this registration's exact new blueprint.",
        _ => "The Gateway reports a blocker that requires administrator review."
    };

    private static string SplitWords(string value)
    {
        if (string.IsNullOrWhiteSpace(value))
        {
            return "Not reported";
        }

        var builder = new StringBuilder(value.Length + 8);
        for (var index = 0; index < value.Length; index++)
        {
            var character = value[index];
            if (index > 0 && char.IsUpper(character) &&
                (char.IsLower(value[index - 1]) ||
                 index + 1 < value.Length && char.IsLower(value[index + 1])))
            {
                builder.Append(' ');
            }

            builder.Append(character);
        }

        return builder.ToString();
    }

    private static string FormatUtc(DateTime value) =>
        AsUtc(value).ToString("MMM d, yyyy h:mm tt 'UTC'", System.Globalization.CultureInfo.InvariantCulture);

    private static DateTime AsUtc(DateTime value) => value.Kind switch
    {
        DateTimeKind.Utc => value,
        DateTimeKind.Local => value.ToUniversalTime(),
        _ => DateTime.SpecifyKind(value, DateTimeKind.Utc)
    };
}
