@using Gateway.Contracts.Dtos

<div class="readiness-panel" aria-label="@($"{Label} readiness")">
    <div class="readiness-summary">
        <strong>@Label</strong>
        <StatusPill Value="@OverallStatus" />
    </div>
    <dl class="readiness-list">
        <div>
            <dt>Shared capability</dt>
            <dd><StatusPill Value="@CapabilityStatus" /></dd>
        </div>
        <div>
            <dt>Exact policy check</dt>
            <dd><StatusPill Value="@ReadbackStatus" /></dd>
        </div>
        <div>
            <dt>Changes available in Microsoft Purview</dt>
            <dd><StatusPill Value="@PropagationStatus" /></dd>
        </div>
        <div>
            <dt>Gateway runtime permissions</dt>
            <dd><StatusPill Value="@TokenRoleStatus" /></dd>
        </div>
        <div>
            <dt>@(IsSimulation ? "Enforcement certification" : PolicyMode == "Disabled" ? "Policy enforcement" : "Approved sample behavior check")</dt>
            <dd><StatusPill Value="@RuntimeStatus" /></dd>
        </div>
    </dl>
    @if (!IsSimulation && PolicyMode != "Disabled" && EvidenceExpiresAtUtc is { } expires)
    {
        <p class="field-help">Approved behavioral evidence expires <time datetime="@expires.ToUniversalTime().ToString("O")">@expires.ToUniversalTime().ToString("u")</time>. Historical reports do not extend this validity.</p>
    }
    @if (IsSimulation)
    {
        <p class="field-help">Configured simulation is non-enforcing. The Gateway's IsReady flag describes enforcement readiness; blocking samples and enforcement certification are not prerequisites for using simulation.</p>
    }
    @if (!Readiness.IsReady && ActionableBlockers.Count > 0)
    {
        <div class="readiness-blockers" role="status">
            <strong>What still needs attention</strong>
            <ul>
                @foreach (var blocker in ActionableBlockers.Select(ExplainBlocker).Distinct())
                {
                    <li>@blocker</li>
                }
            </ul>
        </div>
    }
</div>

@code {
    [Parameter, EditorRequired] public ProtectionReadinessDto Readiness { get; set; } = default!;
    [Parameter] public string Label { get; set; } = "Profile";
    [Parameter] public string? PolicyMode { get; set; }
    [Parameter] public string? ProfileStatus { get; set; }
    [Parameter] public DateTime? EvidenceExpiresAtUtc { get; set; }
    private bool IsSimulation => AgentProtectionUiMapping.IsSimulation(PolicyMode);
    private bool IsNonEnforcing => IsSimulation || PolicyMode == "Disabled";
    private IReadOnlyList<string> ActionableBlockers => AgentProtectionUiMapping.ActionableReadinessBlockers(Readiness, PolicyMode);

    private string OverallStatus => PolicyMode == "Disabled" ? "Configured off" :
        IsSimulation && AgentProtectionUiMapping.SimulationCapabilityUnavailable(Readiness) ? "Simulation unavailable" :
        AgentProtectionUiMapping.ConfiguredSimulationFacts(Readiness, ProfileStatus, PolicyMode) ? "Configured simulation" :
        IsSimulation ? "Simulation gap" :
        !IsSimulation && EvidenceExpiresAtUtc <= DateTime.UtcNow ? "Expired" :
        Readiness.IsReady && !IsSimulation
        ? "Ready"
        : IsUnavailable(Readiness.Capability)
            ? "Unavailable"
            : IsFailed(Readiness)
                ? "Failed"
                : IsPending(Readiness)
                    ? "Pending propagation"
                    : "Awaiting admin";

    private string CapabilityStatus => Readiness.Capability switch
    {
        "Installed" => "Installed",
        "PendingPropagation" => "Pending propagation",
        _ => "Unavailable"
    };

    private string ReadbackStatus => Readiness.Readback switch
    {
        "Ready" => "Ready",
        "Pending" => "Pending",
        "NotChecked" => "Awaiting admin",
        _ => "Failed"
    };

    private string PropagationStatus => IsNonEnforcing && Readiness.Propagation == "NotChecked"
        ? "Not required for this mode" : Readiness.Propagation switch
    {
        "Ready" => "Ready",
        "Pending" => "Pending propagation",
        "NotChecked" => "Awaiting admin",
        _ => "Failed"
    };

    private string TokenRoleStatus => IsNonEnforcing && Readiness.TokenRoles == "NotChecked"
        ? "Not required for this mode" : Readiness.TokenRoles switch
    {
        "Ready" => "Ready",
        "PendingRefresh" => "Pending propagation",
        "NotChecked" => "Awaiting admin",
        _ => "Failed"
    };

    private string RuntimeStatus => PolicyMode == "Disabled" ? "Off" :
        IsSimulation ? "Not required for simulation" :
        EvidenceExpiresAtUtc <= DateTime.UtcNow ? "Expired" :
        !Readiness.IsReady && Readiness.RuntimeVerdict == "Ready" ? "Reverification required" :
        Readiness.RuntimeVerdict switch
    {
        "Ready" => "Ready",
        "Pending" => "Pending",
        "NotChecked" => "Awaiting admin",
        "Unsupported" => "Unavailable",
        _ => "Failed"
    };

    private static bool IsUnavailable(string status) =>
        status is "NotInstalled" or "Unavailable";

    private static bool IsPending(ProtectionReadinessDto readiness) =>
        readiness.Capability == "PendingPropagation" ||
        readiness.Readback == "Pending" ||
        readiness.Propagation == "Pending" ||
        readiness.TokenRoles == "PendingRefresh" ||
        readiness.RuntimeVerdict == "Pending";

    private static bool IsFailed(ProtectionReadinessDto readiness) =>
        readiness.Readback is "Mismatch" or "Failed" or "Stale" ||
        readiness.Propagation == "Failed" ||
        readiness.TokenRoles is "MissingRequiredRoles" or "Failed" ||
        readiness.RuntimeVerdict == "Failed";

    private string ExplainBlocker(string blocker) => blocker switch
    {
        "CapabilityNotInstalled" or "CapabilityUnavailable" or "PROTECTION_CAPABILITY_UNAVAILABLE" =>
            "The shared Purview capability is not available in this deployment.",
        "PURVIEW_RUNTIME_PROVIDER_UNAVAILABLE" =>
            "Provider evaluation is unavailable. The configured simulation mode has not become Disabled or enforcing protection.",
        "PolicyReadbackPending" or "PURVIEW_POLICY_READBACK_NOT_READY" =>
            "The Gateway has not finished checking the exact policy.",
        "PolicyReadbackMismatch" or "PolicyMismatch" =>
            "The exact policy no longer matches the reviewed settings.",
        "PropagationPending" or "PURVIEW_POLICY_PROPAGATION_NOT_READY" =>
            "Microsoft Purview has not made the reviewed change available everywhere yet.",
        "TokenRolesPending" or "TokenRefreshPending" or "PURVIEW_TOKEN_ROLES_NOT_READY" =>
            "The Gateway runtime is waiting for its updated permissions.",
        "MissingRequiredRoles" =>
            "The Gateway runtime does not currently have all required permissions.",
        "RuntimeValidationRequired" or "RuntimeNotTested" =>
            "Approved sample behavior has not been verified in the effective policy scope.",
        "PURVIEW_RUNTIME_CONTEXT_CHANGED" or "PURVIEW_RUNTIME_SAMPLES_REQUIRED" or "RuntimeBindingChanged" =>
            IsSimulation
                ? "The runtime context changed. Refresh the current configuration and evaluation availability; simulation does not require enforcement certification."
                : "The current runtime context requires fresh approved-sample verification. A previous completed operation does not establish current readiness.",
        "RuntimeValidationFailed" =>
            "The latest approved runtime check did not pass.",
        "InventoryExpired" or "SensitiveInformationTypeStale" or "PURVIEW_INVENTORY_STALE" =>
            "The sensitive information type inventory must be refreshed and reviewed again.",
        "PURVIEW_SIT_THRESHOLDS_REVIEW_REQUIRED" =>
            "Review the exact SIT thresholds. Unknown values require an explicitly acknowledged shared-policy replacement, not assumed defaults.",
        _ => "The Gateway reports that this profile still needs administrator attention."
    };
}
