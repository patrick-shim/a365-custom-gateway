@inject TimeProvider Clock

<ReadinessExpiryBoundary UntilUtc="@(Profile?.Readiness.ValidUntilUtc ?? Features?.PurviewReadiness?.ValidUntilUtc)">
    <div class="protection-snapshot @(Compact ? "compact" : "")" aria-label="Saved choices and current protection">
        @if (Profile is null)
        {
            @State("Prompt Shields", ProtectionStateProjection.PromptShields(Features, RegistrationStatus))
        }
        @State("Microsoft Purview", Profile is null
            ? ProtectionStateProjection.Purview(Features, RegistrationStatus, Clock.GetUtcNow().UtcDateTime)
            : ProtectionStateProjection.Profile(Profile, Clock.GetUtcNow().UtcDateTime))
        @if (!Compact)
        {
            <p class="field-help">This is the latest server snapshot, not a guarantee about future requests or downstream telemetry delivery. Refresh after changing the registration or shared policy.</p>
        }
    </div>
</ReadinessExpiryBoundary>

@code {
    [Parameter] public AgentFeaturesDto? Features { get; set; }
    [Parameter] public string? RegistrationStatus { get; set; }
    [Parameter] public PurviewDlpProfileDto? Profile { get; set; }
    [Parameter] public bool Compact { get; set; }

    private RenderFragment State(string label, ProtectionStateView state) => @<section class="protection-fact" data-protection="@label">
        <strong>@label</strong>
        @if (Compact)
        {
            <span>Capability: @state.Capability</span>
            <span>Requested: @state.Requested</span>
            <span>Current: <StatusPill Value="@state.Current" /></span>
        }
        else
        {
            <dl>
                <div><dt>Installed capability</dt><dd>@state.Capability</dd></div>
                <div><dt>Saved choice</dt><dd>@state.Requested</dd></div>
                <div><dt>Current protection</dt><dd><StatusPill Value="@state.Current" /></dd></div>
            </dl>
            <p>@state.Explanation</p>
        }
    </section>;
}
