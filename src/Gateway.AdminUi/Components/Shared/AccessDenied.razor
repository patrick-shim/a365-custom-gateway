<div class="centered-state">
    <span class="state-code">403</span>
    @if (Embedded)
    {
        <h2>This task needs another role</h2>
    }
    else
    {
        <h1 tabindex="-1">This task needs another role</h1>
    }
    <p>Your identity is valid, but this task requires @RequiredAccess. Ask a Gateway Administrator about the required access; your permitted reading paths remain available.</p>
    <FluentAnchor Appearance="Appearance.Accent" Href="/agents">Back to agents</FluentAnchor>
</div>

@code {
    [Parameter] public string RequiredAccess { get; set; } = "the appropriate Gateway permissions";
    [Parameter] public bool Embedded { get; set; }
}
