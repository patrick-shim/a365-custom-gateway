@inject TimeProvider Clock

@if (Loading && Operation is null && Error is null)
{
    <LoadingState Label="Loading protection operation..." />
}
else if (Error is not null)
{
    <ErrorState Title="Protection operation progress could not be loaded" Message="@Error.Message"
                CorrelationId="@Error.CorrelationId" OnRetry="OnRefresh" />
}
@if (HasRetainedOperation)
{
    <div class="operation-update-controls" data-observation-state="@ObservationState">
        @if (ShowActivity && Operation is not null)
        {
            <ActivityIndicator Label="@ObservationLabel" />
        }
        else
        {
            <p class="observation-label"><strong>@ObservationLabel</strong></p>
        }
        <p class="observation-explanation">@ObservationExplanation</p>
        @if (Notice is not null)
        {
            <p class="operation-notice">@Notice</p>
        }
        @if (SavedStep is { } step && Operation is { } operation)
        {
            <p class="operation-current-step">
                <strong>@SavedStepLabel:</strong> @ProtectionOperationPresentation.StepTitle(operation.Type, step.Step).
            </p>
        }
        <dl class="operation-observation-facts">
            @if (Operation is { } saved)
            {
                <div>
                    <dt>Time since request was saved</dt>
                    <dd>@ElapsedSince(saved.CreatedAtUtc)</dd>
                </div>
                @if (SavedStep?.StartedAtUtc is { } started)
                {
                    <div>
                        <dt>Step recorded as started</dt>
                        <dd><time datetime="@AsUtc(started).ToString("O")">@FormatUtc(started)</time></dd>
                    </div>
                }
            }
            <div>
                <dt>Status last checked</dt>
                <dd>
                    @if (LastCheckedAtUtc is { } lastChecked)
                    {
                        <time datetime="@AsUtc(lastChecked).ToString("O")">@FormatUtc(lastChecked)</time>
                        <span> · @(AsUtc(lastChecked) > viewUpdatedAtUtc ? ElapsedSince(lastChecked) : $"{ElapsedSince(lastChecked)} before this view update")</span>
                    }
                    else
                    {
                        <span>No successful status check is recorded in this view yet.</span>
                    }
                </dd>
            </div>
        </dl>
        @if (LastCheckIsOld)
        {
            <p class="operation-stale-check">There has been no recent successful status check in this view. Saved details may be out of date; this does not tell us whether Microsoft is still working.</p>
        }
        @if (SavedUpdateIsUnchanged && Operation is { } unchangedOperation)
        {
            <p class="operation-unchanged">
                No newer saved update was returned by the last check. The saved record was last updated
                <time datetime="@AsUtc(unchangedOperation.UpdatedAtUtc).ToString("O")">@FormatUtc(unchangedOperation.UpdatedAtUtc)</time>.
                A long wait alone does not tell us whether Microsoft is still working. Read this same operation; do not submit it again.
            </p>
        }
        <p class="observation-as-of">Time context shown as of <time datetime="@viewUpdatedAtUtc.ToString("O")">@FormatUtc(viewUpdatedAtUtc)</time>; it updates when this view refreshes.</p>
        <div class="journey-actions">
            <FluentButton OnClick="OnRefresh" Disabled="@(Loading || !RendererInfo.IsInteractive)">Refresh operation</FluentButton>
            @if (Polling)
            {
                <FluentButton OnClick="OnStop" Disabled="@(!RendererInfo.IsInteractive)">Stop automatic updates</FluentButton>
            }
            else if (ProtectionOperationPresentation.IsInProgress(Operation?.Status))
            {
                <FluentButton OnClick="OnResume" Disabled="@(Loading || !RendererInfo.IsInteractive)">Resume automatic updates</FluentButton>
            }
        </div>
    </div>
}
@if (Operation is not null && Error is null)
{
    <ProtectionOperationTimeline Operation="Operation" NextActionOverride="@NextActionOverride" />
}

@code {
    [Parameter] public ProtectionAdminOperationDto? Operation { get; set; }
    [Parameter] public UiErrorInfo? Error { get; set; }
    [Parameter] public bool HasRetainedOperation { get; set; }
    [Parameter] public bool Loading { get; set; }
    [Parameter] public bool Polling { get; set; }
    [Parameter] public string? Notice { get; set; }
    [Parameter] public string? NextActionOverride { get; set; }
    [Parameter] public DateTime? LastCheckedAtUtc { get; set; }
    [Parameter] public EventCallback OnRefresh { get; set; }
    [Parameter] public EventCallback OnResume { get; set; }
    [Parameter] public EventCallback OnStop { get; set; }

    private DateTime viewUpdatedAtUtc;
    private bool InProgress => ProtectionOperationPresentation.IsInProgress(Operation?.Status);
    private bool ShowActivity => Error is null && (Operation is null ? Loading : InProgress && (Loading || Polling));
    private bool LastCheckIsOld => InProgress && LastCheckedAtUtc is { } checkedAt &&
        viewUpdatedAtUtc - AsUtc(checkedAt) >= TimeSpan.FromMinutes(1);
    private bool SavedUpdateIsUnchanged => InProgress && Operation is { } saved && LastCheckedAtUtc is { } checkedAt &&
        AsUtc(checkedAt) - AsUtc(saved.UpdatedAtUtc) >= TimeSpan.FromMinutes(1);

    private string ObservationState => Error is not null ? "read-error" : Operation?.Status switch
    {
        "Completed" or "Succeeded" => "completed",
        "Failed" or "VerificationFailed" or "RequiresManualIntervention" => "attention",
        "Cancelled" or "Canceled" => "cancelled",
        "AwaitingAdministrator" or "AwaitingAdministratorAction" or "AwaitingConfirmation" or "AwaitingBlueprint" => "waiting",
        _ when ShowActivity => Loading ? "checking" : "monitoring",
        _ when InProgress => "paused",
        _ => "unconfirmed"
    };

    private string ObservationLabel => ObservationState switch
    {
        "read-error" => "The latest status check failed",
        "completed" => "The saved operation is complete",
        "attention" => "The saved operation needs attention",
        "cancelled" => "The saved operation was cancelled",
        "waiting" => "The operation is waiting for the next step",
        "checking" => "Checking saved Gateway status",
        "monitoring" => "Automatic read-only updates are active",
        "paused" => "Automatic updates are paused",
        _ => "The saved result is not confirmed"
    };

    private string ObservationExplanation => ObservationState switch
    {
        "read-error" => "The latest status could not be read. Earlier saved details may be out of date. Refresh this same operation without resubmitting it.",
        "completed" => "A final result is saved. Current protection is checked separately; follow the result and next step above.",
        "attention" => "Automatic observation does not resolve this result. Follow the recorded guidance; no retry or new request is being submitted.",
        "cancelled" => "This is the saved operation result, not the effect of stopping automatic updates. Review the result before taking another action.",
        "waiting" => "Follow the reviewed next step above. A status refresh only reads this operation; it does not complete the required action.",
        "checking" or "monitoring" => "This page is checking saved Gateway status, not confirming progress in Microsoft. No operation is being resubmitted.",
        "paused" => "Only observation is paused; the operation itself was not cancelled. Saved details may be out of date. Refresh or resume to read this same operation.",
        _ => "Keep the existing operation reference and refresh its saved status. Do not create another operation to recover an unknown result."
    };

    private ProtectionAdminOperationStepDto? SavedStep => Operation?.Steps
        .OrderBy(step => step.OrderIndex)
        .FirstOrDefault(step => step.Status is not ("Pending" or "Completed" or "Succeeded" or "Skipped" or "Cancelled" or "Canceled"))
        ?? (InProgress
            ? Operation?.Steps.OrderBy(step => step.OrderIndex).FirstOrDefault(step => step.Status == "Pending")
            : Operation?.Steps.OrderByDescending(step => step.OrderIndex).FirstOrDefault(step => step.StartedAtUtc is not null));

    private string SavedStepLabel => Error is null && InProgress && SavedStep?.Status == "Pending"
        ? "Next recorded step (not started)" : "Last recorded step";

    protected override void OnParametersSet() => viewUpdatedAtUtc = Clock.GetUtcNow().UtcDateTime;

    private string ElapsedSince(DateTime timestamp)
    {
        var elapsed = viewUpdatedAtUtc - AsUtc(timestamp);
        if (elapsed < TimeSpan.Zero)
            return "Timestamp is ahead of this view's clock";
        if (elapsed < TimeSpan.FromMinutes(1))
            return "Less than a minute";
        if (elapsed < TimeSpan.FromHours(1))
            return Units((int)elapsed.TotalMinutes, "minute");
        if (elapsed < TimeSpan.FromDays(1))
            return Units((int)elapsed.TotalHours, "hour");
        return Units((int)elapsed.TotalDays, "day");
    }

    private static string Units(int count, string unit) =>
        $"{count.ToString(System.Globalization.CultureInfo.InvariantCulture)} {unit}{(count == 1 ? "" : "s")}";

    private static string FormatUtc(DateTime value) =>
        AsUtc(value).ToString("MMM d, yyyy h:mm:ss tt 'UTC'", System.Globalization.CultureInfo.InvariantCulture);

    private static DateTime AsUtc(DateTime value) => value.Kind switch
    {
        DateTimeKind.Utc => value,
        DateTimeKind.Local => value.ToUniversalTime(),
        _ => DateTime.SpecifyKind(value, DateTimeKind.Utc)
    };
}
