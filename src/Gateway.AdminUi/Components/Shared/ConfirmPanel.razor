@implements IAsyncDisposable
@inject IJSRuntime JS

<FluentDialog Class="confirm-dialog"
              Hidden="@(!Visible)"
              HiddenChanged="HandleHiddenChanged"
              Modal="true"
              TrapFocus="true"
              PreventScroll="true"
              AriaLabelledby="@titleId"
              AriaDescribedby="@messageId">
    <section @ref="panel"
             class="confirm-panel"
             role="alertdialog"
             aria-modal="true"
             aria-labelledby="@titleId"
             aria-describedby="@messageId"
             aria-busy="@(Busy ? "true" : "false")"
             @onkeydown="HandleKeyDown">
        <span class="confirm-icon @Tone" aria-hidden="true">!</span>
        <h2 id="@titleId">@Title</h2>
        <p id="@messageId">@Message</p>
        @if (AdditionalContent is not null)
        {
            <div class="confirm-extra">@AdditionalContent</div>
        }
        <div class="confirm-actions">
            <FluentButton Type="ButtonType.Button" Appearance="Appearance.Neutral" OnClick="Cancel" Disabled="Busy">@CancelLabel</FluentButton>
            <FluentButton Type="ButtonType.Button" Appearance="Appearance.Accent" OnClick="Confirm" Disabled="@(Busy || ConfirmDisabled)">@(Busy ? "Working…" : ConfirmLabel)</FluentButton>
        </div>
        @if (Visible && Busy)
        {
            <ActivityIndicator Label="Waiting for the Gateway response" />
        }
    </section>
</FluentDialog>

@code {
    private readonly string titleId = $"confirm-title-{Guid.NewGuid():N}";
    private readonly string messageId = $"confirm-message-{Guid.NewGuid():N}";
    private ElementReference panel;
    private bool jsInitialized;
    private bool renderedVisible;
    private bool disposed;

    [Parameter] public bool Visible { get; set; }
    [Parameter] public bool Busy { get; set; }
    [Parameter] public bool ConfirmDisabled { get; set; }
    [Parameter] public string Title { get; set; } = "Confirm action";
    [Parameter] public string Message { get; set; } = string.Empty;
    [Parameter] public string ConfirmLabel { get; set; } = "Confirm";
    [Parameter] public string CancelLabel { get; set; } = "Cancel";
    [Parameter] public string Tone { get; set; } = "warning";
    [Parameter] public RenderFragment? AdditionalContent { get; set; }
    [Parameter] public EventCallback OnConfirm { get; set; }
    [Parameter] public EventCallback OnCancel { get; set; }

    private Task Confirm() => disposed || !Visible || Busy || ConfirmDisabled ? Task.CompletedTask : OnConfirm.InvokeAsync();
    private Task Cancel() => disposed || !Visible || Busy ? Task.CompletedTask : OnCancel.InvokeAsync();

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await JS.InvokeVoidAsync("A365Gateway.confirmPanel.initialize", panel, titleId);
            jsInitialized = true;
            renderedVisible = Visible;
            if (Visible)
            {
                await JS.InvokeVoidAsync("A365Gateway.confirmPanel.open", titleId);
            }
            return;
        }

        if (!renderedVisible && Visible)
        {
            await JS.InvokeVoidAsync("A365Gateway.confirmPanel.open", titleId);
        }
        else if (renderedVisible && !Visible)
        {
            await JS.InvokeVoidAsync("A365Gateway.confirmPanel.restore", titleId);
        }

        renderedVisible = Visible;
    }

    private Task HandleKeyDown(KeyboardEventArgs args) =>
        args.Key == "Escape" ? Cancel() : Task.CompletedTask;

    private async Task HandleHiddenChanged(bool hidden)
    {
        if (!hidden)
        {
            return;
        }

        if (Busy)
        {
            await InvokeAsync(StateHasChanged);
            return;
        }

        await OnCancel.InvokeAsync();
    }

    public async ValueTask DisposeAsync()
    {
        disposed = true;
        if (!jsInitialized)
        {
            return;
        }

        try
        {
            if (renderedVisible)
            {
                await JS.InvokeVoidAsync("A365Gateway.confirmPanel.restore", titleId);
            }
            await JS.InvokeVoidAsync("A365Gateway.confirmPanel.dispose", titleId);
        }
        catch (JSDisconnectedException)
        {
        }
    }
}
