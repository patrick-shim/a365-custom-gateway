@implements IAsyncDisposable
@inject TimeProvider Clock

@ChildContent

@code {
    [Parameter] public DateTime? UntilUtc { get; set; }
    [Parameter] public IReadOnlyList<DateTime?> AdditionalExpiriesUtc { get; set; } = [];
    [Parameter] public RenderFragment? ChildContent { get; set; }
    private DateTime[] scheduledExpiries = [];
    private CancellationTokenSource? expiryCancellation;
    private Task expiryTask = Task.CompletedTask;

    protected override async Task OnParametersSetAsync()
    {
        var expiries = AdditionalExpiriesUtc.Append(UntilUtc)
            .OfType<DateTime>().Distinct().Order().ToArray();
        if (scheduledExpiries.SequenceEqual(expiries))
            return;
        await StopAsync();
        scheduledExpiries = expiries;
        if (!RendererInfo.IsInteractive)
            return;
        expiryCancellation = new();
        expiryTask = RefreshAtExpiryAsync(expiries.Where(value => value > Clock.GetUtcNow().UtcDateTime).ToArray(),
            expiryCancellation.Token);
    }

    private async Task RefreshAtExpiryAsync(IReadOnlyList<DateTime> expiries, CancellationToken cancellationToken)
    {
        try
        {
            foreach (var until in expiries)
            {
                var delay = until - Clock.GetUtcNow().UtcDateTime;
                if (delay > TimeSpan.Zero)
                    await Task.Delay(delay, Clock, cancellationToken);
                cancellationToken.ThrowIfCancellationRequested();
                await InvokeAsync(StateHasChanged);
            }
        }
        catch (OperationCanceledException) when (cancellationToken.IsCancellationRequested)
        {
        }
    }

    private async Task StopAsync()
    {
        if (expiryCancellation is null)
            return;
        expiryCancellation.Cancel();
        await expiryTask;
        expiryCancellation.Dispose();
        expiryCancellation = null;
    }

    public async ValueTask DisposeAsync() => await StopAsync();
}
