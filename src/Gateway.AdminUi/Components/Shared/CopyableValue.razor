@inject IJSRuntime JS

<div class="copyable-command copyable-value">
    <label for="@FieldId">@Label</label>
    @if (Rows > 1)
    {
        <textarea id="@FieldId" @ref="field" class="form-control command-text" rows="@Rows"
                  readonly aria-readonly="true" aria-describedby="@StatusId"
                  autocomplete="off" spellcheck="false">@Value</textarea>
    }
    else
    {
        <input id="@FieldId" @ref="field" class="form-control" type="text" value="@Value"
               readonly aria-readonly="true" aria-describedby="@StatusId"
               autocomplete="off" spellcheck="false" />
    }
    <div class="copyable-command-actions">
        <FluentButton Type="ButtonType.Button" Appearance="Appearance.Neutral"
                      aria-label="@($"Copy {Label}")" OnClick="CopyAsync">
            @CopyLabel
        </FluentButton>
        <span id="@StatusId" class="field-help" role="status" aria-live="polite">@copyStatus</span>
    </div>
</div>

@code {
    private readonly string generatedId = $"copy-value-{Guid.NewGuid():N}";
    private ElementReference field;
    private string copyStatus = "You can also select the text manually.";

    [Parameter, EditorRequired] public string Label { get; set; } = string.Empty;
    [Parameter, EditorRequired] public string Value { get; set; } = string.Empty;
    [Parameter] public string? InputId { get; set; }
    [Parameter] public int Rows { get; set; } = 1;
    [Parameter] public string CopyLabel { get; set; } = "Copy";
    [Parameter] public string CopiedMessage { get; set; } = "Copied to clipboard.";
    [Parameter] public string UnavailableMessage { get; set; } = "Copy is unavailable. Select the text and copy it manually.";

    private string FieldId => InputId ?? generatedId;
    private string StatusId => $"{FieldId}-status";

    private async Task CopyAsync()
    {
        try
        {
            await JS.InvokeVoidAsync("A365Gateway.copyTextFrom", field);
            copyStatus = CopiedMessage;
        }
        catch (JSDisconnectedException)
        {
            copyStatus = UnavailableMessage;
        }
        catch (JSException)
        {
            copyStatus = UnavailableMessage;
        }
    }
}
