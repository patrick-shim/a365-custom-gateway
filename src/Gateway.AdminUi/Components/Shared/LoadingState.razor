<div class="state-panel" role="status" aria-live="polite">
    <div class="loading-feedback">
        <ActivityIndicator Label="@Label" />
        @if (!string.IsNullOrWhiteSpace(Detail))
        {
            <p>@Detail</p>
        }
    </div>
</div>

@code {
    [Parameter] public string Label { get; set; } = "Loading…";
    [Parameter] public string? Detail { get; set; }
}
