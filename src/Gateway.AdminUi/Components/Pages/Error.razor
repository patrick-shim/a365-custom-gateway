@page "/Error"
@using System.Diagnostics
@layout MainLayout

<PageTitle>Unexpected error · A365 Gateway</PageTitle>

<section class="card centered-state">
    <span class="error-symbol" aria-hidden="true">!</span>
    <h1>The portal hit an unexpected error</h1>
    <p>No sensitive exception details are shown. Try the request again; if it keeps failing, give support the request ID below.</p>
    @if (ShowRequestId)
    {
        <p><strong>Request ID:</strong> <code>@RequestId</code></p>
    }
    <div class="empty-actions">
        <FluentAnchor Appearance="Appearance.Accent" Href="/dashboard">Return to overview</FluentAnchor>
        <FluentAnchor Appearance="Appearance.Neutral" Href=".">Reload</FluentAnchor>
    </div>
</section>

@code {
    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    private string? RequestId { get; set; }
    private bool ShowRequestId => !string.IsNullOrEmpty(RequestId);

    protected override void OnInitialized() =>
        RequestId = Activity.Current?.Id ?? HttpContext?.TraceIdentifier;
}
