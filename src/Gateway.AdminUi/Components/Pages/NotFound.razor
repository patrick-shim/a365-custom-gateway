@page "/not-found"
@layout MainLayout
@attribute [Authorize]

<PageTitle>Page not found · A365 Gateway</PageTitle>

<section class="card centered-state">
    <span class="state-code">404</span>
    <h1>Page not found</h1>
    <p>The address does not match an Admin UI page. Return to the gateway overview or browse registered agents.</p>
    <div class="empty-actions">
        <FluentAnchor Appearance="Appearance.Accent" Href="/dashboard">Gateway overview</FluentAnchor>
        <FluentAnchor Appearance="Appearance.Neutral" Href="/agents">Browse agents</FluentAnchor>
    </div>
</section>
