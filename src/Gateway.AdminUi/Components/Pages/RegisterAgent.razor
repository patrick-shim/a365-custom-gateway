@page "/agents/register"
@rendermode InteractiveServer
@attribute [Authorize(Roles = "Gateway.Administrator")]
@implements IAsyncDisposable
@using System.ComponentModel.DataAnnotations
@using System.Text.Json
@inject IGatewayApiClient Api
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject NavigationManager Navigation
@inject ILogger<RegisterAgent> Logger
@inject RegistrationHandoffState HandoffState
@inject IJSRuntime JS
@inject TimeProvider Clock

<PageTitle>Register agent · A365 Gateway</PageTitle>

<PageHeader Eyebrow="Agent registry"
            Title="@(gatewayCredential is null ? "Register an agent" : "Save your connection details")"
            Description="@(gatewayCredential is null ? "Choose its identity, then decide which optional protections it should use." : "Your agent record is created. Save the key now, then follow Agent 365 setup.")">
    <Actions>
        @if (gatewayCredential is null && !submitting)
        {
            <FluentAnchor Appearance="Appearance.Neutral" Href="/agents">Cancel</FluentAnchor>
        }
    </Actions>
</PageHeader>

@if (acceptedRegistration is { } registration && gatewayCredential is { } credential)
{
    <div class="form-layout">
        <GatewayKeyHandoff ExternalAgentId="@registration.ExternalAgentId" Credential="@credential"
                           RecoveryUri="@recoveryUri" OnContinue="ContinueToProvisioning"
                           OnDiscard="DiscardCredential" />

        <aside class="card guidance-card" aria-label="Credential guidance">
            <div class="card-header"><h2>Before continuing</h2></div>
            <div class="card-body guidance-steps">
                <div><span>1</span><p><strong>Copy the key</strong><small>Store it in the external agent's protected runtime configuration.</small></p></div>
                <div><span>2</span><p><strong>Keep the mapping</strong><small>Use the external agent ID shown with this key so the Gateway can bind the request to this registration.</small></p></div>
                <div><span>3</span><p><strong>Follow provisioning</strong><small>Continue only after the credential is safely stored. The next page reports persisted Gateway operation progress.</small></p></div>
                @if (registration.PurviewConfigurationOperationId is { } protectionOperationId)
                {
                    <div role="status">
                        <strong>Purview configuration accepted</strong>
                        <StatusPill Value="@(registration.PurviewConfigurationStatus ?? "Pending")" />
                        <p>Configuration is not effective protection yet. A new blueprint's policy waits for its exact application ID. Protection operation: <code>@protectionOperationId</code>.</p>
                    </div>
                }
            </div>
        </aside>
    </div>
}
else if (registrationOutcomeUnknown)
{
    <section class="card" aria-labelledby="registration-recovery-heading">
        <div class="card-header"><h2 id="registration-recovery-heading">Registration result needs checking</h2></div>
        <div class="card-body">
            <p>The registration may already exist. Check its retained external ID before taking another action. This page will not send another create request.</p>
            <CopyableValue InputId="registration-recovery-id" Label="External agent ID" Value="@form.ExternalAgentId" />
            @if (error is not null)
            {
                <ErrorState Message="@error.Message" CorrelationId="@error.CorrelationId" />
            }
            @if (recoveryAgentId is { } agentId)
            {
                <p role="status">The Gateway registration exists. Its original key cannot be retrieved. Open its details to issue a replacement before connecting the external agent.</p>
                <FluentAnchor Appearance="Appearance.Accent" Href="@($"/agents/{agentId:D}")">Open registered agent</FluentAnchor>
            }
            else
            {
                <FluentButton Type="ButtonType.Button" Appearance="Appearance.Accent" OnClick="CheckRegistrationAsync"
                              Disabled="@(checkingRegistration || !ValidRecoveryId)">
                    @(checkingRegistration ? "Checking registration…" : "Check existing registration")
                </FluentButton>
            }
            @if (recoveryNotice is not null)
            {
                <p class="field-help" role="status">@recoveryNotice</p>
            }
            <FluentAnchor Appearance="Appearance.Neutral" Href="@($"/agents?search={Uri.EscapeDataString(form.ExternalAgentId)}")">Check agents</FluentAnchor>
        </div>
    </section>
}
else
{
<div class="form-layout">
    <EditForm id="registration-form" EditContext="editContext" OnValidSubmit="ReviewRegistration"
              OnInvalidSubmit="InvalidRegistration" class="card form-card"
              aria-busy="@(!RendererInfo.IsInteractive || submitting ? "true" : "false")">
        <DataAnnotationsValidator />
        <ValidationSummary />
        <fieldset class="registration-fields" disabled="@(!RendererInfo.IsInteractive || submitting)">

        <nav class="form-stepper" aria-label="Registration sections">
            <a href="#identity-heading"><span>1</span>Agent</a>
            <a href="#blueprint-heading"><span>2</span>Blueprint</a>
            <a href="#features-heading"><span>3</span>Features</a>
        </nav>

        @if (error is not null)
        {
            <div class="form-section"><ErrorState Message="@error.Message" CorrelationId="@error.CorrelationId" /></div>
        }

        @if (remoteValidationErrors.Count > 0)
        {
            <div class="form-section" role="alert">
                <div class="validation-summary-errors">
                    <strong>Review the fields below.</strong>
                    <ul>
                        @foreach (var message in remoteValidationErrors)
                        {
                            <li>@message</li>
                        }
                    </ul>
                </div>
            </div>
        }

        @if (identityError is not null)
        {
            <div class="form-section" role="alert">
                <div class="validation-summary-errors">
                    <strong>We couldn't identify the signed-in owner.</strong>
                    <span>@identityError</span>
                </div>
            </div>
        }

        @if (provisioningCapabilityChecked && !provisioningExecutionEnabled)
        {
            <div class="form-section" role="alert">
                <div class="deployment-callout">
                    <strong>Registration is unavailable.</strong>
                    <span>@(provisioningCapabilityLoadFailed
                        ? "The portal could not verify deployment readiness. Refresh this page after confirming that the Gateway API is healthy. The form remains disabled to prevent a partial registration."
                        : "This deployment has no open provisioning window. Complete or resume bootstrap Apply, then refresh this page. The form remains disabled until the API reports that this exact registration is admitted.")</span>
                </div>
            </div>
        }

        <section class="form-section" aria-labelledby="identity-heading">
            <h2 id="identity-heading" tabindex="-1">Give your agent a name</h2>
            <p>The Gateway generates its stable external ID and prefills the signed-in owner. Review the owner and environment before registering.</p>
            <div class="form-grid">
                <div class="form-field">
                    <label for="agent-name">Agent name</label>
                    <InputText id="agent-name" class="form-control" @bind-Value="form.Name"
                               @oninput="eventArgs => form.Name = eventArgs.Value?.ToString() ?? string.Empty" autocomplete="off"
                               aria-describedby="agent-name-error" />
                    <ValidationMessage For="@(() => form.Name)" id="agent-name-error" />
                </div>
                <div class="form-field">
                    <label for="external-agent-id">External agent ID <span class="optional-label">Generated</span></label>
                    <input id="external-agent-id" class="form-control" value="@form.ExternalAgentId" readonly
                           aria-readonly="true" aria-describedby="external-agent-id-help" />
                    <span id="external-agent-id-help" class="field-help">Generated automatically and immutable after registration. This remains separate from the Gateway record ID and Agent 365 IDs.</span>
                    <ValidationMessage For="@(() => form.ExternalAgentId)" />
                </div>
                <div class="form-field">
                    <label for="agent-environment">Environment</label>
                    <InputSelect id="agent-environment" class="form-control" @bind-Value="form.Environment">
                        <option value="Development">Development</option>
                        <option value="Test">Test</option>
                        <option value="Production">Production</option>
                    </InputSelect>
                    <ValidationMessage For="@(() => form.Environment)" />
                </div>
                <div class="form-field">
                    <label for="owner-object-id">Owner object ID <span class="optional-label">Prefilled</span></label>
                    <InputText id="owner-object-id" class="form-control" @bind-Value="form.OwnerObjectId"
                               @oninput="eventArgs => form.OwnerObjectId = eventArgs.Value?.ToString() ?? string.Empty"
                               autocomplete="off" aria-describedby="owner-object-id-help owner-object-id-error" />
                    <span id="owner-object-id-help" class="field-help">@(ownerDisplay is null ? "Prefilled from your authenticated Microsoft Entra identity. Change it only when another user is accountable." : $"Prefilled from signed-in owner {ownerDisplay}. Change it only when another user is accountable.")</span>
                    <ValidationMessage For="@(() => form.OwnerObjectId)" id="owner-object-id-error" />
                </div>
                <div class="form-field full">
                    <label for="agent-description">Description <span class="optional-label">Optional</span></label>
                    <InputTextArea id="agent-description" class="form-control form-textarea" @bind-Value="form.Description"
                                   @oninput="eventArgs => form.Description = eventArgs.Value?.ToString()" />
                    <div class="field-counter">@(form.Description?.Length ?? 0) / 2,000</div>
                    <ValidationMessage For="@(() => form.Description)" />
                </div>
            </div>
        </section>

        <section class="form-section" aria-labelledby="blueprint-heading">
            <h2 id="blueprint-heading" tabindex="-1">Choose a reusable blueprint</h2>
            <p>Choose a reusable Microsoft Entra Agent Identity blueprint already available to the Gateway, or create one that can be reused by more than one agent. Only typed Agent ID blueprints are listed.</p>
            <div class="form-grid">
                <div class="form-field full">
                    <label for="blueprint-mode">Blueprint choice</label>
                    <InputSelect id="blueprint-mode"
                                 class="form-control"
                                 @bind-Value="form.BlueprintMode"
                                 @bind-Value:after="HandleBlueprintModeChangedAsync"
                                 aria-describedby="blueprint-mode-help blueprint-mode-error">
                        <option value="@BlueprintModeUseExisting">Use an existing blueprint</option>
                        <option value="@BlueprintModeCreateNew">Create a reusable blueprint</option>
                    </InputSelect>
                    <span id="blueprint-mode-help" class="field-help">Using an existing blueprint is the default. Choices are loaded through the Gateway API and validated again before the Agent ID is created.</span>
                    <ValidationMessage For="@(() => form.BlueprintMode)" id="blueprint-mode-error" />
                </div>

                @if (form.BlueprintMode == BlueprintModeUseExisting)
                {
                    @if (blueprintOptionsLoading)
                    {
                        <div class="form-field full">
                            <LoadingState Label="Loading reusable blueprints…" Detail="Reading the typed Agent ID blueprint inventory through the Gateway API." />
                        </div>
                    }
                    else if (blueprintLoadError is not null)
                    {
                        <div class="form-field full">
                            <ErrorState Title="Blueprint choices are unavailable"
                                        Message="@blueprintLoadError.Message"
                                        CorrelationId="@blueprintLoadError.CorrelationId"
                                        OnRetry="LoadBlueprintOptionsAsync" />
                            <span class="field-help">The Gateway could not verify the inventory, so no empty inventory is being claimed and existing-blueprint registration remains unavailable.</span>
                        </div>
                    }
                    else if (blueprintOptionsLoaded && blueprintOptions.Count == 0)
                    {
                        <div class="form-field full">
                            <EmptyState Icon="◇"
                                        Title="No reusable blueprints yet"
                                        Description="No typed Agent ID blueprints are currently available through the Gateway. Create one with this registration or refresh the inventory.">
                                <FluentButton Type="ButtonType.Button" Appearance="Appearance.Accent" OnClick="UseCreateNewBlueprint">Create a reusable blueprint</FluentButton>
                                <FluentButton Type="ButtonType.Button" Appearance="Appearance.Neutral" OnClick="LoadBlueprintOptionsAsync">Refresh blueprints</FluentButton>
                            </EmptyState>
                        </div>
                    }
                    else if (blueprintOptionsLoaded)
                    {
                        @if (BlueprintFilterAvailable)
                        {
                            <div class="form-field full">
                                <label for="blueprint-filter">Filter blueprints</label>
                                <input id="blueprint-filter"
                                       class="form-control"
                                       type="search"
                                       autocomplete="off"
                                       placeholder="Filter by name or Graph ID"
                                       value="@blueprintFilter"
                                       @oninput="OnBlueprintFilterChanged"
                                       aria-describedby="blueprint-filter-status" />
                                <span id="blueprint-filter-status" class="field-help" role="status" aria-live="polite">@BlueprintFilterStatus</span>
                            </div>
                        }
                        <div class="form-field full">
                            <label for="existing-blueprint">Existing reusable blueprint</label>
                            <InputSelect id="existing-blueprint"
                                         class="form-control"
                                         @bind-Value="form.BlueprintObjectId"
                                         @bind-Value:after="HandleExistingBlueprintChanged"
                                         aria-describedby="existing-blueprint-help blueprint-inventory-status existing-blueprint-error">
                                <option value="">Select an Agent 365-compatible blueprint</option>
                                @if (FilteredCompatibleBlueprints.Count > 0)
                                {
                                    <optgroup label="Available for Agent 365">
                                        @foreach (var blueprint in FilteredCompatibleBlueprints)
                                        {
                                            <option value="@blueprint.BlueprintObjectId">
                                                @FormatBlueprintOption(blueprint)
                                            </option>
                                        }
                                    </optgroup>
                                }
                                @if (FilteredIncompatibleBlueprints.Count > 0)
                                {
                                    <optgroup label="Unavailable — missing a manager application this Gateway requires">
                                        @foreach (var blueprint in FilteredIncompatibleBlueprints)
                                        {
                                            <option value="@blueprint.BlueprintObjectId" disabled>
                                                @FormatBlueprintOption(blueprint)
                                            </option>
                                        }
                                    </optgroup>
                                }
                            </InputSelect>
                            <span id="existing-blueprint-help" class="field-help">Choose by name. The shown Graph ID comes from the typed catalog; Graph <code>id</code> and <code>appId</code> may be the same GUID, and the Gateway preserves their route-specific fields. Inventory entries that are missing a manager application required by this Gateway remain visible but cannot be selected.</span>
                            <span id="blueprint-inventory-status" class="field-help" role="status" aria-live="polite">@blueprintInventoryStatus</span>
                            @if (CompatibleBlueprintCount == 0)
                            {
                                <div class="validation-summary-errors" role="alert">
                                    <strong>No existing blueprint is compatible with Agent 365 through this Gateway.</strong>
                                    <span>Create a reusable blueprint with this registration, or ask an operator to update an existing blueprint's Agent 365 manager applications.</span>
                                </div>
                            }
                            <ValidationMessage For="@(() => form.BlueprintObjectId)" id="existing-blueprint-error" />
                            <div class="toolbar-actions">
                                @if (CompatibleBlueprintCount == 0)
                                {
                                    <FluentButton Type="ButtonType.Button"
                                                  Appearance="Appearance.Accent"
                                                  OnClick="UseCreateNewBlueprint">
                                        Create a reusable blueprint
                                    </FluentButton>
                                }
                                <FluentButton Type="ButtonType.Button"
                                              Appearance="Appearance.Stealth"
                                              OnClick="LoadBlueprintOptionsAsync"
                                              Disabled="@(blueprintOptionsLoading || submitting)">
                                    Refresh blueprints
                                </FluentButton>
                            </div>
                        </div>
                    }
                }
                else if (form.BlueprintMode == BlueprintModeCreateNew)
                {
                    <div class="form-field full">
                        <label for="new-blueprint-display-name">Blueprint name</label>
                        <InputText id="new-blueprint-display-name"
                                   class="form-control"
                                   @bind-Value="form.BlueprintDisplayName"
                                   @oninput="eventArgs => form.BlueprintDisplayName = eventArgs.Value?.ToString()"
                                   autocomplete="off"
                                   aria-describedby="new-blueprint-display-name-help new-blueprint-error" />
                        <span id="new-blueprint-display-name-help" class="field-help">Choose a durable name for the reusable Agent Identity blueprint. The Gateway creates and verifies the blueprint before creating this agent's Agent ID.</span>
                        <ValidationMessage For="@(() => form.BlueprintDisplayName)" id="new-blueprint-error" />
                    </div>
                }
            </div>
        </section>

        <section class="form-section" aria-labelledby="features-heading">
            <h2 id="features-heading" tabindex="-1">Choose what this agent uses</h2>
            <p>Prompt Shields and Microsoft Purview are optional and independent. Both off is a complete core registration choice. Saved choices and current protection are separate.</p>
            <div class="feature-stack">
                <fieldset class="feature-group" aria-describedby="activity-observability-help">
                    <legend>Activity observability</legend>
                    <p id="activity-observability-help">Choose each destination independently. These controls apply to sanitized agent activity telemetry; gateway platform health, security, and operational diagnostics are configured separately.</p>
                    <div class="form-grid">
                        <div class="form-field checkbox-field">
                            <label class="checkbox-label" for="agent365-observability-enabled">
                                <InputCheckbox id="agent365-observability-enabled" @bind-Value="form.Agent365ObservabilityEnabled" />
                                <span><strong>Agent 365 observability</strong><small>Send supported sanitized activity telemetry to Microsoft Agent 365.</small></span>
                            </label>
                        </div>
                        <div class="form-field checkbox-field">
                            <label class="checkbox-label" for="azure-monitor-export-enabled">
                                <InputCheckbox id="azure-monitor-export-enabled" @bind-Value="form.AzureMonitorExportEnabled" />
                                <span><strong>Also mirror sanitized activity telemetry to Azure Monitor</strong><small>Export a separate sanitized copy of activity metrics and traces to the configured Azure Monitor destination.</small></span>
                            </label>
                        </div>
                    </div>
                </fieldset>

                <AgentProtectionConfiguration @ref="protectionEditor"
                    BlueprintApplicationId="@(form.BlueprintMode == BlueprintModeUseExisting ? SelectedBlueprint?.BlueprintClientId : null)"
                    BlueprintDisplayName="@(form.BlueprintMode == BlueprintModeUseExisting ? SelectedBlueprint?.DisplayName : null)"
                    DeferredBlueprint="DeferredProtectionBlueprint"
                    DefaultPromptShieldsEnabled="defaultPromptShieldEnabled"
                    PromptRuntimeAvailable="promptShieldServerAvailable"
                    DefaultPurviewEnabled="defaultPurviewEnabled"
                    ContextKey="@form.ExternalAgentId"
                    IsAdministrator="true" Busy="submitting" Changed="ProtectionChanged" />
            </div>
        </section>

        <div class="form-actions">
            <FluentAnchor Appearance="Appearance.Neutral" Href="/agents">Cancel</FluentAnchor>
            <FluentButton Type="ButtonType.Submit" Appearance="Appearance.Accent" Disabled="@(submitting || !identityReady || !provisioningExecutionEnabled || ExistingBlueprintInventoryUnavailable || protectionEditor?.CanApply != true)">
                @(submitting
                    ? "Registering…"
                    : !provisioningCapabilityChecked
                        ? "Checking provisioning…"
                        : !provisioningExecutionEnabled
                            ? "Registration unavailable"
                            : ExistingBlueprintInventoryUnavailable
                                ? "Blueprint unavailable"
                            : identityReady
                                ? "Review registration"
                                : "Loading identity…")
            </FluentButton>
        </div>
        </fieldset>
    </EditForm>

    <aside class="card guidance-card" aria-label="Registration guidance">
        <div class="card-header"><h2>What happens next</h2></div>
        <div class="card-body guidance-steps">
            <div><span>1</span><p><strong>Save your connection details</strong><small>Store the one-time key with the API endpoint and external agent ID before leaving registration.</small></p></div>
            <div><span>2</span><p><strong>Finish Agent 365 setup</strong><small>A Gateway Administrator completes the delegated Registry step. The Gateway then verifies the identity mapping.</small></p></div>
            <div><span>3</span><p><strong>Connect the external agent</strong><small>Wait for an Active registration, then preserve the sample's evaluate, model-once and submit sequence.</small></p></div>
        </div>
        <div class="card-footer"><div class="subtle-note">Keep the operation page open to follow verified progress. Polling stops automatically after a bounded period.</div></div>
    </aside>
</div>
}

@if (submitting)
{
    <NavigationLock ConfirmExternalNavigation="true" OnBeforeInternalNavigation="BeforeSubmittingNavigation" />
}
<ConfirmPanel Visible="@(reviewedRequest is not null)" Busy="submitting"
              Title="Review registration" Message="Confirm this identity and these choices. Save the one-time key before continuing to Agent 365 setup."
              ConfirmLabel="Register and show key" OnConfirm="SubmitAsync" OnCancel="CancelRegistrationReview">
    <AdditionalContent>
        @if (reviewedRequest is { } reviewed)
        {
            <dl class="review-summary">
                <div><dt>Agent</dt><dd>@reviewed.Name</dd></div>
                <div><dt>External agent ID</dt><dd>@reviewed.ExternalAgentId</dd></div>
                <div><dt>Owner object ID</dt><dd>@reviewed.OwnerObjectId</dd></div>
                <div><dt>Environment</dt><dd>@reviewed.Environment</dd></div>
                <div><dt>Blueprint</dt><dd>@(reviewed.Blueprint is { Mode: BlueprintModeCreateNew } newBlueprint ? $"New: {newBlueprint.DisplayName}" : $"Reuse {SelectedBlueprint?.DisplayName} ({reviewed.Blueprint?.BlueprintObjectId})")</dd></div>
                <div><dt>Prompt Shields</dt><dd>@(reviewed.Features?.PromptShieldEnabled == true ? "On" : "Off")</dd></div>
                <div><dt>Microsoft Purview</dt><dd>@(reviewed.Features?.PurviewEnabled == true ? "Reviewed configuration; current protection is verified separately" : "Off")</dd></div>
                <div><dt>Telemetry choices</dt><dd>Agent 365: @(reviewed.Features?.Agent365ObservabilityEnabled == true ? "On" : "Off"); Azure Monitor mirror: @(reviewed.Features?.AzureMonitorExportEnabled == true ? "On" : "Off")</dd></div>
            </dl>
        }
    </AdditionalContent>
</ConfirmPanel>

@code {
    [SupplyParameterFromQuery(Name = "pendingExternalId")]
    public string? PendingExternalId { get; set; }

    private const string EntraObjectIdClaim = "http://schemas.microsoft.com/identity/claims/objectidentifier";
    private const string EntraObjectIdShortClaim = "oid";
    private const string BlueprintModeUseExisting = "UseExisting";
    private const string BlueprintModeCreateNew = "CreateNew";
    private readonly CancellationTokenSource disposeCts = new();
    private readonly RegistrationForm form = new();
    private EditContext editContext = default!;
    private ValidationMessageStore serverValidation = default!;
    private RegisterAgentRequest? reviewedRequest;
    private string? reviewedSignature;
    private string? recoveryUri;
    private string? recoveryNotice;
    private Guid? recoveryAgentId;
    private bool registrationOutcomeUnknown;
    private bool checkingRegistration;
    private bool focusValidationRequested;
    private bool focusHeadingRequested;
    private readonly List<string> remoteValidationErrors = [];
    private IReadOnlyList<AgentIdentityBlueprintSummaryDto> blueprintOptions = [];
    private RegisterAgentResponse? acceptedRegistration;
    private AgentGatewayCredentialDto? gatewayCredential;
    private UiErrorInfo? error;
    private UiErrorInfo? blueprintLoadError;
    private string? identityError;
    private string? ownerDisplay;
    private string blueprintInventoryStatus = string.Empty;
    private string blueprintFilter = string.Empty;
    private bool blueprintOptionsLoaded;
    private bool blueprintOptionsLoading;
    private bool identityReady;
    private bool provisioningCapabilityChecked;
    private bool provisioningCapabilityLoadFailed;
    private bool provisioningExecutionEnabled;
    private bool promptShieldServerAvailable;
    private bool defaultPromptShieldEnabled;
    private bool defaultPurviewEnabled;
    private bool submitting;
    private AgentProtectionConfiguration? protectionEditor;
    private PurviewDeferredBlueprintDto? DeferredProtectionBlueprint =>
        form.BlueprintMode == BlueprintModeCreateNew && !string.IsNullOrWhiteSpace(form.BlueprintDisplayName)
            ? new(form.ExternalAgentId.Trim(), form.BlueprintDisplayName.Trim()) : null;
    private void ProtectionChanged() => StateHasChanged();

    protected override async Task OnInitializedAsync()
    {
        editContext = new(form);
        serverValidation = new(editContext);
        editContext.OnValidationRequested += ClearServerValidation;
        if (PendingExternalId is not null)
        {
            form.ExternalAgentId = PendingExternalId;
            registrationOutcomeUnknown = true;
            if (!ValidRecoveryId)
            {
                error = new UiErrorInfo("This recovery link has an invalid external agent ID. Open Agents or ask an administrator to locate the registration.");
            }
            return;
        }

        form.ExternalAgentId = $"agent-{Guid.NewGuid():N}";
        var featureDefaultsTask = LoadFeatureDefaultsAsync();
        var blueprintOptionsTask = LoadBlueprintOptionsAsync();

        try
        {
            var authenticationState = await AuthenticationStateProvider
                .GetAuthenticationStateAsync()
                .WaitAsync(disposeCts.Token);
            var user = authenticationState.User;
            var ownerObjectId = user.FindFirst(EntraObjectIdClaim)?.Value
                ?? user.FindFirst(EntraObjectIdShortClaim)?.Value;

            if (user.Identity?.IsAuthenticated is not true ||
                !Guid.TryParse(ownerObjectId, out var ownerObjectGuid) ||
                ownerObjectGuid == Guid.Empty)
            {
                identityError = "Sign out and back in, or ask an administrator to verify that your Entra sign-in includes an object ID.";
                return;
            }

            form.OwnerObjectId = ownerObjectGuid.ToString("D");
            ownerDisplay = FormatOwnerDisplay(user);
            identityReady = true;
        }
        catch (OperationCanceledException) when (disposeCts.IsCancellationRequested)
        {
        }
        catch (Exception exception)
        {
            Logger.LogWarning(
                exception,
                "The registration page could not resolve the signed-in owner's Entra object ID.");
            identityError = "Refresh the page and try again. If the problem continues, contact an administrator.";
        }
        finally
        {
            await Task.WhenAll(
                featureDefaultsTask,
                blueprintOptionsTask);
        }
    }

    private async Task LoadBlueprintOptionsAsync()
    {
        if (blueprintOptionsLoading)
        {
            return;
        }

        blueprintOptionsLoading = true;
        blueprintOptionsLoaded = false;
        blueprintLoadError = null;
        blueprintInventoryStatus = string.Empty;

        try
        {
            var response = await Api.GetAgentIdentityBlueprintsAsync(disposeCts.Token);
            if (response.Items is null ||
                response.Items.Any(item => item.BlueprintObjectId == Guid.Empty || item.BlueprintClientId == Guid.Empty) ||
                response.Items.Select(item => item.BlueprintObjectId).Distinct().Count() != response.Items.Count ||
                response.Items.Select(item => item.BlueprintClientId).Distinct().Count() != response.Items.Count)
            {
                throw new GatewayApiProtocolException("The blueprint inventory contains missing or duplicate identities. Refresh it before selecting a blueprint.", null);
            }
            blueprintOptions = response.Items
                .OrderBy(item => item.DisplayName, StringComparer.OrdinalIgnoreCase)
                .ThenBy(item => item.BlueprintClientId)
                .ToArray();
            blueprintOptionsLoaded = true;

            if (!string.IsNullOrWhiteSpace(form.BlueprintObjectId) &&
                !blueprintOptions.Any(item => string.Equals(
                    item.BlueprintObjectId.ToString("D"),
                    form.BlueprintObjectId,
                    StringComparison.OrdinalIgnoreCase) &&
                    item.IsAgent365Compatible))
            {
                form.BlueprintObjectId = null;
            }

            blueprintInventoryStatus = blueprintOptions.Count switch
            {
                1 when CompatibleBlueprintCount == 1 =>
                    "1 reusable blueprint loaded and compatible with Agent 365.",
                1 =>
                    "1 reusable blueprint loaded; it is not compatible with Agent 365 through this Gateway.",
                _ =>
                    $"{blueprintOptions.Count} reusable blueprints loaded; {CompatibleBlueprintCount} compatible with Agent 365 through this Gateway."
            };
        }
        catch (OperationCanceledException) when (disposeCts.IsCancellationRequested)
        {
        }
        catch (Exception ex)
        {
            Logger.LogWarning("Blueprint inventory could not be loaded ({ErrorType}).", ex.GetType().Name);
            blueprintOptions = [];
            form.BlueprintObjectId = null;
            blueprintLoadError = UiErrorInfo.FromException(ex);
        }
        finally
        {
            blueprintOptionsLoading = false;
        }
    }

    private Task HandleBlueprintModeChangedAsync()
    {
        remoteValidationErrors.Clear();

        if (form.BlueprintMode == BlueprintModeUseExisting &&
            !blueprintOptionsLoaded &&
            !blueprintOptionsLoading)
        {
            return LoadBlueprintOptionsAsync();
        }

        return Task.CompletedTask;
    }

    private void HandleExistingBlueprintChanged()
    {
        remoteValidationErrors.Clear();
    }

    private void UseCreateNewBlueprint()
    {
        form.BlueprintMode = BlueprintModeCreateNew;
        remoteValidationErrors.Clear();
    }

    private async Task LoadFeatureDefaultsAsync()
    {
        try
        {
            var config = await Api.GetSystemConfigAsync(disposeCts.Token);
            if ((config.DefaultAgent365ObservabilityEnabled is null || config.DefaultAzureMonitorExportEnabled is null) &&
                config.DefaultObservabilityMode is not ("Disabled" or "GatewayOnly" or "Agent365" or "Agent365AzureMonitor"))
            {
                throw new GatewayApiProtocolException("The Gateway returned an unrecognized telemetry default. Refresh its configuration before registering.", null);
            }
            form.Agent365ObservabilityEnabled = config.DefaultAgent365ObservabilityEnabled
                ?? LegacyAgent365ObservabilityEnabled(config.DefaultObservabilityMode);
            form.AzureMonitorExportEnabled = config.DefaultAzureMonitorExportEnabled
                ?? LegacyAzureMonitorExportEnabled(config.DefaultObservabilityMode);
            defaultPurviewEnabled = config.DefaultPurviewEnabled;
            promptShieldServerAvailable = config.PromptShieldAvailable;
            defaultPromptShieldEnabled = config.DefaultPromptShieldEnabled;
            provisioningExecutionEnabled = config.ProvisioningExecutionEnabled;
        }
        catch (OperationCanceledException) when (disposeCts.IsCancellationRequested)
        {
        }
        catch (Exception exception)
        {
            // Keep the product fail-safe defaults when configuration is temporarily unavailable.
            Logger.LogWarning(
                exception,
                "The registration page could not load Gateway feature defaults or provisioning readiness.");
            provisioningCapabilityLoadFailed = true;
            provisioningExecutionEnabled = false;
            promptShieldServerAvailable = false;
            defaultPromptShieldEnabled = false;
            defaultPurviewEnabled = false;
        }
        finally
        {
            provisioningCapabilityChecked = true;
        }
    }

    private bool ValidRecoveryId => form.ExternalAgentId.Length is > 0 and <= 128 &&
        System.Text.RegularExpressions.Regex.IsMatch(form.ExternalAgentId, @"^[a-zA-Z0-9][a-zA-Z0-9._-]*$");

    private void ClearServerValidation(object? sender, ValidationRequestedEventArgs args) =>
        serverValidation.Clear();

    private void InvalidRegistration(EditContext context) => focusValidationRequested = true;

    private void ReviewRegistration()
    {
        if (!RendererInfo.IsInteractive || submitting || registrationOutcomeUnknown || acceptedRegistration is not null)
        {
            return;
        }

        error = null;
        remoteValidationErrors.Clear();
        if (!identityReady || !provisioningExecutionEnabled || protectionEditor?.CanApply != true)
        {
            error = new UiErrorInfo("Wait for current identity, registration admission and protection choices before reviewing registration.");
            return;
        }
        if (form.BlueprintMode == BlueprintModeUseExisting && !SelectedBlueprintIsCurrent())
        {
            remoteValidationErrors.Add(
                "Select an Agent 365-compatible reusable blueprint from the current Gateway inventory. Refresh the choices if the blueprint was recently created or changed.");
            focusValidationRequested = true;
            return;
        }

        reviewedRequest = BuildRegistrationRequest();
        reviewedSignature = ReviewSignature(reviewedRequest);
    }

    private RegisterAgentRequest BuildRegistrationRequest()
    {
        if (protectionEditor is not { CanApply: true } editor)
        {
            throw new InvalidOperationException("Review the current protection choices before registering.");
        }

        var protection = editor.Selection;
        var dlpSelection = editor.ExistingProfileSelection;
        var features = new AgentFeaturesDto(
            ToLegacyObservabilityMode(form.Agent365ObservabilityEnabled, form.AzureMonitorExportEnabled),
            protection.PurviewEnabled,
            protection.PurviewEnabled ? AgentProtectionUiMapping.LegacyMode(protection.PolicyMode) : null,
            form.Agent365ObservabilityEnabled,
            form.AzureMonitorExportEnabled,
            protection.PromptShieldsEnabled,
            PurviewDlpProfile: dlpSelection);
        return new RegisterAgentRequest(
            form.ExternalAgentId.Trim(),
            form.Name.Trim(),
            NullIfEmpty(form.Description),
            form.OwnerObjectId.Trim(),
            form.Environment,
            features,
            new AgentBlueprintSelectionDto(
                form.BlueprintMode,
                form.BlueprintMode == BlueprintModeUseExisting ? NullIfEmpty(form.BlueprintObjectId) : null,
                form.BlueprintMode == BlueprintModeCreateNew ? NullIfEmpty(form.BlueprintDisplayName) : null),
            PurviewPolicyProfile: null,
            PurviewDlpProfile: dlpSelection);
    }

    private string ReviewSignature(RegisterAgentRequest request) =>
        JsonSerializer.Serialize(new { Request = request, Protection = protectionEditor?.Selection });

    private void CancelRegistrationReview()
    {
        if (!submitting)
        {
            reviewedRequest = null;
            reviewedSignature = null;
        }
    }

    private async Task SubmitAsync()
    {
        if (submitting || registrationOutcomeUnknown || acceptedRegistration is not null || reviewedRequest is null)
        {
            return;
        }

        if (!editContext.Validate() || !identityReady || !provisioningExecutionEnabled ||
            protectionEditor?.CanApply != true ||
            form.BlueprintMode == BlueprintModeUseExisting && !SelectedBlueprintIsCurrent() ||
            !string.Equals(reviewedSignature, ReviewSignature(BuildRegistrationRequest()), StringComparison.Ordinal))
        {
            CancelRegistrationReview();
            error = new UiErrorInfo("Your choices or their readiness changed. Review the current registration before confirming again.");
            focusValidationRequested = true;
            return;
        }

        submitting = true;
        error = null;
        remoteValidationErrors.Clear();
        var dispatched = false;
        try
        {
            var request = reviewedRequest with { PurviewConfigurationIntent = protectionEditor.TakeConfigurationIntent() };
            recoveryUri = Navigation.GetUriWithQueryParameter("pendingExternalId", request.ExternalAgentId);
            var retained = await JS.InvokeAsync<bool>(
                "A365Gateway.retainRegistrationRecovery", disposeCts.Token, recoveryUri, request.ExternalAgentId);
            if (!retained)
            {
                throw new GatewayApiProtocolException("The recovery reference could not be retained in this browser. No registration was sent. Reconnect or refresh before reviewing again.", null);
            }
            if (disposeCts.IsCancellationRequested) return;
            Navigation.NavigateTo(recoveryUri, replace: true);
            dispatched = true;
            var response = await Api.RegisterAgentAsync(request, disposeCts.Token);
            if (disposeCts.IsCancellationRequested)
            {
                return;
            }
            if (response.AgentId == Guid.Empty || response.OperationId == Guid.Empty ||
                !string.Equals(response.ExternalAgentId, request.ExternalAgentId, StringComparison.Ordinal))
            {
                throw new GatewayApiProtocolException("The registration response could not be bound to the submitted external ID.", null);
            }

            recoveryAgentId = response.AgentId;
            if (response.GatewayCredential is not { } issued ||
                issued.KeyId == Guid.Empty || string.IsNullOrWhiteSpace(issued.ApiKey) ||
                AsUtc(issued.ExpiresAtUtc) <= Clock.GetUtcNow().UtcDateTime)
            {
                registrationOutcomeUnknown = true;
                acceptedRegistration = response with { GatewayCredential = null };
                error = new UiErrorInfo(
                    "Registration was accepted, but a usable one-time key was not returned. Open the registered agent and issue a replacement; do not create another registration.");
                return;
            }

            acceptedRegistration = response;
            gatewayCredential = issued;
        }
        catch (OperationCanceledException) when (disposeCts.IsCancellationRequested) { }
        catch (GatewayApiException ex) when (
            ex.ValidationErrors.Count > 0 &&
            ex.StatusCode is System.Net.HttpStatusCode.BadRequest or System.Net.HttpStatusCode.UnprocessableEntity)
        {
            remoteValidationErrors.AddRange(ex.ValidationErrors.SelectMany(pair => pair.Value));
            foreach (var pair in ex.ValidationErrors)
            {
                var field = pair.Key switch
                {
                    "Blueprint.BlueprintObjectId" => nameof(RegistrationForm.BlueprintObjectId),
                    "Blueprint.DisplayName" => nameof(RegistrationForm.BlueprintDisplayName),
                    "Blueprint.Mode" => nameof(RegistrationForm.BlueprintMode),
                    _ => pair.Key
                };
                serverValidation.Add(editContext.Field(field), pair.Value);
            }
            editContext.NotifyValidationStateChanged();
            error = new UiErrorInfo(ex.Detail ?? ex.Title, ex.CorrelationId);
            ClearRecoveryUri();
            focusValidationRequested = true;
        }
        catch (Exception ex)
        {
            Logger.LogWarning("Registration did not return a usable result ({ErrorType}); correlation {CorrelationId}.",
                ex.GetType().Name, (ex as GatewayApiClientException)?.CorrelationId);
            var rejected = ex is GatewayAuthenticationRequiredException ||
                ex is GatewayApiException { StatusCode: System.Net.HttpStatusCode.BadRequest or
                    System.Net.HttpStatusCode.Unauthorized or System.Net.HttpStatusCode.Forbidden or
                    System.Net.HttpStatusCode.UnprocessableEntity };
            if (dispatched && !rejected)
            {
                registrationOutcomeUnknown = true;
                error = new UiErrorInfo(
                    "The create response was interrupted or could not be verified. Check the existing registration by its retained external ID. No automatic resubmission will occur.",
                    (ex as GatewayApiClientException)?.CorrelationId);
            }
            else
            {
                error = UiErrorInfo.FromException(ex);
                if (dispatched)
                {
                    ClearRecoveryUri();
                }
            }
        }
        finally
        {
            submitting = false;
            reviewedRequest = null;
            reviewedSignature = null;
            focusHeadingRequested = gatewayCredential is not null || registrationOutcomeUnknown;
        }
    }

    private void ClearRecoveryUri()
    {
        recoveryUri = Navigation.GetUriWithQueryParameter("pendingExternalId", (string?)null);
        Navigation.NavigateTo(recoveryUri, replace: true);
    }

    private void BeforeSubmittingNavigation(LocationChangingContext context)
    {
        if (!string.Equals(context.TargetLocation, recoveryUri, StringComparison.Ordinal))
        {
            context.PreventNavigation();
            error = new UiErrorInfo("Registration is still being submitted. Wait for its result. If the connection is lost, reopen this page's recovery link instead of creating another registration.");
        }
    }

    private async Task CheckRegistrationAsync()
    {
        if (checkingRegistration || !ValidRecoveryId)
        {
            return;
        }

        checkingRegistration = true;
        error = null;
        recoveryNotice = null;
        try
        {
            string? cursor = null;
            var seen = new HashSet<string>(StringComparer.Ordinal);
            for (var page = 0; page < 10; page++)
            {
                var response = await Api.GetAgentsAsync(new AgentListQuery(
                    Search: form.ExternalAgentId, Limit: 100, Cursor: cursor), disposeCts.Token);
                if (disposeCts.IsCancellationRequested)
                {
                    return;
                }
                var matches = response.Items.Where(item =>
                    string.Equals(item.ExternalAgentId, form.ExternalAgentId, StringComparison.Ordinal)).ToArray();
                if (matches.Length > 1 || matches.Any(item => item.AgentId == Guid.Empty))
                {
                    throw new GatewayApiProtocolException("The registration lookup returned an ambiguous identity. Ask an administrator to inspect it.", null);
                }
                if (matches.Length == 1)
                {
                    recoveryAgentId = matches[0].AgentId;
                    return;
                }
                if (response.NextCursor is null)
                {
                    recoveryNotice = "No exact registration was returned yet. Check again or ask an administrator to inspect this external ID. This does not authorize another create request.";
                    return;
                }
                if (string.IsNullOrWhiteSpace(response.NextCursor) || !seen.Add(response.NextCursor))
                {
                    throw new GatewayApiProtocolException("Registration lookup could not advance through the returned results.", null);
                }
                cursor = response.NextCursor;
            }
            recoveryNotice = "The bounded lookup reached ten pages without an exact match. More results may exist; use Agents or ask an administrator to inspect this external ID. No create was repeated.";
        }
        catch (OperationCanceledException) when (disposeCts.IsCancellationRequested) { }
        catch (Exception ex)
        {
            Logger.LogWarning("Registration recovery lookup failed ({ErrorType}).", ex.GetType().Name);
            error = UiErrorInfo.FromException(ex);
        }
        finally
        {
            checkingRegistration = false;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        var focusInvalid = focusValidationRequested;
        var focusHeading = focusHeadingRequested;
        focusValidationRequested = false;
        focusHeadingRequested = false;
        if (!focusInvalid && !focusHeading)
        {
            return;
        }
        try
        {
            if (focusInvalid)
            {
                await JS.InvokeVoidAsync("A365Gateway.focusFirstInvalid", "registration-form");
            }
            else
            {
                await JS.InvokeVoidAsync("A365Gateway.focusHeading");
            }
        }
        catch (JSException exception)
        {
            Logger.LogWarning("Registration focus could not be moved ({ErrorType}).", exception.GetType().Name);
        }
    }

    private static string? NullIfEmpty(string? value) => string.IsNullOrWhiteSpace(value) ? null : value.Trim();

    private void ContinueToProvisioning()
    {
        if (acceptedRegistration is null || gatewayCredential is null)
        {
            return;
        }

        var operationId = acceptedRegistration.OperationId;
        HandoffState.RecordSavedCredential(operationId, acceptedRegistration.AgentId);
        registrationOutcomeUnknown = true;
        acceptedRegistration = null;
        gatewayCredential = null;
        Navigation.NavigateTo($"/operations/{operationId}");
    }

    private void DiscardCredential()
    {
        gatewayCredential = null;
        if (acceptedRegistration is not null)
        {
            acceptedRegistration = acceptedRegistration with { GatewayCredential = null };
        }
        registrationOutcomeUnknown = true;
    }

    private static string FormatAuthorizationHeader(string apiKey) => $"Authorization: Bearer {apiKey}";

    private static string FormatUtcMachine(DateTime value) => AsUtc(value).ToString("O");

    private static string FormatUtcDisplay(DateTime value) => AsUtc(value).ToString("yyyy-MM-dd HH:mm:ss 'UTC'");

    private static DateTime AsUtc(DateTime value) => value.Kind switch
    {
        DateTimeKind.Utc => value,
        DateTimeKind.Local => value.ToUniversalTime(),
        _ => DateTime.SpecifyKind(value, DateTimeKind.Utc)
    };

    private bool ExistingBlueprintInventoryUnavailable =>
        form.BlueprintMode == BlueprintModeUseExisting &&
        (blueprintOptionsLoading ||
         !blueprintOptionsLoaded ||
         blueprintLoadError is not null ||
         CompatibleBlueprintCount == 0);

    private AgentIdentityBlueprintSummaryDto? SelectedBlueprint =>
        Guid.TryParse(form.BlueprintObjectId, out var selectedObjectId)
            ? blueprintOptions.FirstOrDefault(item =>
                item.BlueprintObjectId == selectedObjectId &&
                item.IsAgent365Compatible)
            : null;

    private int CompatibleBlueprintCount =>
        blueprintOptions.Count(item => item.IsAgent365Compatible);

    // A directory that has accumulated dozens of blueprints makes a flat list
    // unusable, because the few selectable entries are buried among the ones this
    // Gateway cannot manage. Offer the filter only once the list is long enough to
    // need it, so a small inventory keeps its simpler form.
    private const int BlueprintFilterThreshold = 8;

    private bool BlueprintFilterAvailable =>
        blueprintOptions.Count > BlueprintFilterThreshold;

    private IReadOnlyList<AgentIdentityBlueprintSummaryDto> FilteredCompatibleBlueprints =>
        FilterBlueprints(compatible: true);

    private IReadOnlyList<AgentIdentityBlueprintSummaryDto> FilteredIncompatibleBlueprints =>
        FilterBlueprints(compatible: false);

    private IReadOnlyList<AgentIdentityBlueprintSummaryDto> FilterBlueprints(bool compatible) =>
        blueprintOptions
            .Where(item => item.IsAgent365Compatible == compatible && MatchesBlueprintFilter(item))
            .ToArray();

    // Keep the current selection listed even when it no longer matches, so narrowing
    // the filter can never silently drop the blueprint the operator already chose.
    // Every whitespace-separated term must match, because blueprint names are long
    // and multi-word, and an operator recalls scattered fragments of one rather than
    // an exact contiguous substring.
    private bool MatchesBlueprintFilter(AgentIdentityBlueprintSummaryDto blueprint)
    {
        var objectId = blueprint.BlueprintObjectId.ToString("D");
        if (string.Equals(objectId, form.BlueprintObjectId, StringComparison.OrdinalIgnoreCase))
        {
            return true;
        }

        var terms = blueprintFilter.Split(
            (char[]?)null,
            StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
        if (terms.Length == 0)
        {
            return true;
        }

        var displayName = blueprint.DisplayName ?? string.Empty;
        return terms.All(term =>
            displayName.Contains(term, StringComparison.OrdinalIgnoreCase) ||
            objectId.Contains(term, StringComparison.OrdinalIgnoreCase));
    }

    private string BlueprintFilterStatus
    {
        get
        {
            var matches = FilteredCompatibleBlueprints.Count + FilteredIncompatibleBlueprints.Count;
            if (matches == 0)
            {
                return "No blueprint matches this filter. Clear it to see the full inventory.";
            }

            return matches == 1
                ? $"1 of {blueprintOptions.Count} blueprints match; {FilteredCompatibleBlueprints.Count} available for Agent 365."
                : $"{matches} of {blueprintOptions.Count} blueprints match; {FilteredCompatibleBlueprints.Count} available for Agent 365.";
        }
    }

    private void OnBlueprintFilterChanged(ChangeEventArgs eventArgs) =>
        blueprintFilter = eventArgs.Value?.ToString() ?? string.Empty;

    private bool SelectedBlueprintIsCurrent() =>
        blueprintOptionsLoaded &&
        blueprintLoadError is null &&
        Guid.TryParse(form.BlueprintObjectId, out var selectedObjectId) &&
        selectedObjectId != Guid.Empty &&
        blueprintOptions.Any(item =>
            item.BlueprintObjectId == selectedObjectId &&
            item.IsAgent365Compatible);

    private static string FormatBlueprintOption(AgentIdentityBlueprintSummaryDto blueprint)
    {
        var displayName = string.IsNullOrWhiteSpace(blueprint.DisplayName)
            ? "Unnamed blueprint"
            : blueprint.DisplayName.Trim();
        var compatibility = blueprint.IsAgent365Compatible
            ? string.Empty
            : " — Unavailable for Agent 365";
        return $"{displayName} — Graph ID {blueprint.BlueprintObjectId:D}{compatibility}";
    }

    private static string ToLegacyObservabilityMode(bool agent365Enabled, bool azureMonitorEnabled) =>
        (agent365Enabled, azureMonitorEnabled) switch
        {
            (true, true) => "Agent365AzureMonitor",
            (true, false) => "Agent365",
            (false, true) => "GatewayOnly",
            _ => "Disabled"
        };

    private static bool LegacyAgent365ObservabilityEnabled(string? mode) =>
        mode is "Agent365" or "Agent365AzureMonitor";

    private static bool LegacyAzureMonitorExportEnabled(string? mode) =>
        mode is "GatewayOnly" or "Agent365AzureMonitor";

    private static string? FormatOwnerDisplay(ClaimsPrincipal user)
    {
        var displayName = user.FindFirst("name")?.Value ?? user.Identity?.Name;
        var userName = user.FindFirst("preferred_username")?.Value
            ?? user.FindFirst(ClaimTypes.Upn)?.Value;

        if (!string.IsNullOrWhiteSpace(displayName) &&
            !string.IsNullOrWhiteSpace(userName) &&
            !string.Equals(displayName, userName, StringComparison.OrdinalIgnoreCase))
        {
            return $"{displayName} ({userName})";
        }

        return string.IsNullOrWhiteSpace(displayName) ? userName : displayName;
    }

    public ValueTask DisposeAsync()
    {
        editContext.OnValidationRequested -= ClearServerValidation;
        reviewedRequest = null;
        reviewedSignature = null;
        acceptedRegistration = null;
        gatewayCredential = null;
        disposeCts.Cancel();
        disposeCts.Dispose();
        return ValueTask.CompletedTask;
    }

    private sealed class RegistrationForm : IValidatableObject
    {
        [Required, StringLength(256), Display(Name = "Display name")]
        public string Name { get; set; } = string.Empty;

        [Required, StringLength(128), Display(Name = "External agent ID"), RegularExpression(@"^[a-zA-Z0-9][a-zA-Z0-9._-]*$", ErrorMessage = "Use a valid external agent ID.")]
        public string ExternalAgentId { get; set; } = string.Empty;

        [StringLength(2_000)]
        public string? Description { get; set; }

        [Required, StringLength(64), Display(Name = "Owner object ID"), RegularExpression(@"^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$", ErrorMessage = "Enter a valid Microsoft Entra object ID.")]
        public string OwnerObjectId { get; set; } = string.Empty;

        [Required]
        public string Environment { get; set; } = "Development";

        [Required, Display(Name = "Blueprint choice")]
        public string BlueprintMode { get; set; } = BlueprintModeUseExisting;

        public string? BlueprintObjectId { get; set; }

        public string? BlueprintDisplayName { get; set; }

        public bool Agent365ObservabilityEnabled { get; set; } = true;
        public bool AzureMonitorExportEnabled { get; set; }

        public IEnumerable<ValidationResult> Validate(ValidationContext validationContext)
        {
            if (!TryParseNonEmptyGuid(OwnerObjectId))
            {
                yield return new ValidationResult("Enter a non-empty Microsoft Entra owner object ID.", [nameof(OwnerObjectId)]);
            }
            if (BlueprintMode == BlueprintModeUseExisting)
            {
                if (!TryParseNonEmptyGuid(BlueprintObjectId))
                {
                    yield return new ValidationResult(
                        "Select a reusable Agent ID blueprint.",
                        [nameof(BlueprintObjectId)]);
                }
            }
            else if (BlueprintMode == BlueprintModeCreateNew)
            {
                if (string.IsNullOrWhiteSpace(BlueprintDisplayName))
                {
                    yield return new ValidationResult(
                        "Enter a display name for the new reusable blueprint.",
                        [nameof(BlueprintDisplayName)]);
                }
                else if (BlueprintDisplayName.Trim().Length > 256)
                {
                    yield return new ValidationResult(
                        "The blueprint display name cannot exceed 256 characters.",
                        [nameof(BlueprintDisplayName)]);
                }
            }
            else
            {
                yield return new ValidationResult(
                    "Select whether to use an existing blueprint or create a new one.",
                    [nameof(BlueprintMode)]);
            }

        }

        private static bool TryParseNonEmptyGuid(string? value) =>
            Guid.TryParse(value, out var parsed) && parsed != Guid.Empty;
    }
}
