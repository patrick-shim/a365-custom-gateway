@page "/settings"
@page "/settings/{TaskName}"
@rendermode InteractiveServer
@attribute [Authorize(Policy = "AllControlPlane")]
@implements IAsyncDisposable
@using System.ComponentModel.DataAnnotations
@using System.Security.Claims
@using System.Text
@using System.Text.Json
@using System.Text.Json.Serialization
@inject IGatewayApiClient Api
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject NavigationManager Navigation
@inject IJSRuntime JS
@inject TimeProvider Clock
@inject ILogger<Settings> Logger

<PageTitle>@TaskTitle · A365 Gateway</PageTitle>

<ReadinessExpiryBoundary AdditionalExpiriesUtc="SettingsExpiryTimes">
<PageHeader Eyebrow="Administration"
            Title="@TaskTitle"
            Description="Protection is optional. If you choose Purview, follow the setup steps below. You can revisit a step without undoing saved work.">
    <Actions>
        @if (ProtectionReadIsBusy || protectionActionBusy || saving)
        {
            <div class="settings-header-activity">
                <ActivityIndicator Label="@(protectionActionBusy || saving ? "Waiting for the Gateway response" : operationPolling ? "Automatic saved-status checks are active" : "Reading Gateway state")" />
            </div>
        }
        <FluentButton Appearance="Appearance.Neutral"
                      OnClick="ReloadAllAsync"
                      Disabled="ControlsDisabled">
            @(reloading ? "Refreshing…" : "Refresh")
        </FluentButton>
    </Actions>
</PageHeader>

@if (canReadProtectionGovernance)
{
    <section class="protection-setup" aria-labelledby="protection-setup-heading">
        <h2 id="protection-setup-heading">Purview setup: follow these steps</h2>
        <p id="protection-setup-help">These are setup steps, not interchangeable settings tabs. Start at 1 for a new setup; revisit a step to inspect or change it. The highlighted step is your location, not proof that protection is active.</p>
        <nav aria-label="Purview setup steps" aria-describedby="protection-setup-help">
            <ol class="protection-setup-steps">
                <li>
                    <a href="@TaskHref("connection")" aria-current="@(CurrentTask == SettingsTask.Connection ? "step" : null)">
                        <span class="setup-step-number" aria-hidden="true">1</span>
                        <span><strong>Connect tenant</strong><small>Verify access and find existing data types</small></span>
                    </a>
                </li>
                <li>
                    <a href="@TaskHref("policy")" aria-current="@(CurrentTask == SettingsTask.Policy ? "step" : null)">
                        <span class="setup-step-number" aria-hidden="true">2</span>
                        <span><strong>Set shared policy</strong><small>Choose a blueprint, data types and mode</small></span>
                    </a>
                </li>
                <li>
                    @if (isAdministrator)
                    {
                        <a href="@TaskHref("runtime")" aria-current="@(CurrentTask == SettingsTask.Runtime ? "step" : null)">
                            <span class="setup-step-number" aria-hidden="true">3</span>
                            <span><strong>Test behavior</strong><small>Required for Enforce; not a blocking requirement for Simulation or Off</small></span>
                        </a>
                    }
                    else
                    {
                        <div class="setup-step-restricted">
                            <span class="setup-step-number" aria-hidden="true">3</span>
                            <span><strong>Test behavior</strong><small>A Gateway Administrator approves this step for Enforce</small></span>
                        </div>
                    }
                </li>
                <li>
                    <a href="/agents">
                        <span class="setup-step-number" aria-hidden="true">4</span>
                        <span><strong>Review agent choices</strong><small>Choose Purview On or Off for each agent</small></span>
                    </a>
                </li>
            </ol>
        </nav>
        <p class="field-help">Simulation does not block content. Off is a valid finished choice. Optional collection and registration defaults below are separate tools, not extra setup steps.</p>
    </section>
}
<nav class="protection-task-nav" aria-label="Other protection tasks">
    <a href="/settings" aria-current="@(CurrentTask == SettingsTask.Overview ? "page" : null)">Protection overview</a>
    @if (canReadProtectionGovernance)
    {
        <a href="@TaskHref("collection")" aria-current="@(CurrentTask == SettingsTask.Collection ? "page" : null)">Optional data collection</a>
    }
    @if (isAdministrator)
    {
        <a href="/settings/defaults" aria-current="@(CurrentTask == SettingsTask.Defaults ? "page" : null)">Registration defaults</a>
    }
</nav>

@if (capabilitiesError is not null && CurrentTask != SettingsTask.Overview)
{
    <ErrorState Title="Protection capabilities could not be loaded" Message="@capabilitiesError.Message"
                CorrelationId="@capabilitiesError.CorrelationId" OnRetry="LoadCapabilitiesAsync" />
}
@if (CurrentTask == SettingsTask.Unknown)
{
    <ErrorState Title="Protection task not found" Message="Choose a task from the protection overview. No action was submitted." />
}
@if (CurrentTask == SettingsTask.Defaults && roleLoaded && !isAdministrator ||
    CurrentTask == SettingsTask.Runtime && roleLoaded && !isAdministrator)
{
    <AccessDenied RequiredAccess="the Gateway Administrator role" Embedded="true" />
}

@if (roleLoaded && !isAdministrator)
{
    <div class="subtle-note role-notice" role="status">
        <strong>Read-only protection view.</strong>
        Your @roleLabel role can see the safe state returned by the Gateway. Only a Gateway Administrator can connect Microsoft Purview, confirm policy changes, run readiness checks, or change defaults.
    </div>
}

@if (CurrentTask != SettingsTask.Unknown &&
    (isAdministrator || CurrentTask is not (SettingsTask.Defaults or SettingsTask.Runtime)))
{
    <ProtectionJourneyOutcome Guidance="@JourneyGuidance" OnAction="RunGuidanceActionAsync"
                              ActionDisabled="@GuidanceActionDisabled"
                              Busy="@ProtectionReadIsBusy"
                              @ref="outcomePanel" />
    @if (CompletedEarlierTaskLabel is { } earlierTask)
    {
        <details class="previous-protection-operation">
            <summary>Completed earlier task: @earlierTask</summary>
            <p>This is an earlier task's saved result, not completion of this step or proof of current protection.</p>
            @OperationMonitorContent
        </details>
    }
    else
    {
        @OperationMonitorContent
    }
}

@if (CurrentTask == SettingsTask.Overview)
{
<p class="subtle-note" role="note">Both protections Off is a complete core registration, not an unfinished setup. Start a protection task only when it is needed.</p>
<section class="protection-section" aria-labelledby="protection-capabilities-heading">
    <div class="protection-section-heading">
        <div>
            <h2 id="protection-capabilities-heading">Protection capabilities</h2>
            <p>An installed shared capability is not the same as protection being enabled for an agent or ready at runtime. Each card keeps those facts separate.</p>
        </div>
    </div>

    @if (capabilitiesLoading && capabilitiesResource is null)
    {
        <div class="card">
            <LoadingState Label="Loading protection capabilities…" Detail="Reading deployment facts from the Gateway." />
        </div>
    }
    else if (capabilitiesError is not null && capabilitiesResource is null)
    {
        <ErrorState Title="Protection capabilities could not be loaded"
                    Message="@capabilitiesError.Message"
                    CorrelationId="@capabilitiesError.CorrelationId"
                    OnRetry="LoadCapabilitiesAsync" />
    }
    else
    {
        <div class="capability-grid">
            <article class="card capability-card" aria-labelledby="agent365-capability-heading">
                <div class="card-header">
                    <div>
                        <h2 id="agent365-capability-heading">Agent 365 registration beta</h2>
                        <span class="section-caption">Deployment-wide preview boundary</span>
                    </div>
                    <StatusPill Value="@CapabilityDisplayStatus(Agent365Capability)" />
                </div>
                <div class="card-body">
                    <p>This beta choice was fixed when the Gateway was deployed. It cannot be turned on or off from Settings.</p>
                    <dl class="capability-facts">
                        <div>
                            <dt>Installed capability</dt>
                            <dd>@CapabilityExplanation(Agent365Capability)</dd>
                        </div>
                        <div>
                            <dt>Per-agent use</dt>
                            <dd>Each registration still pauses for a signed-in Gateway Administrator to complete its own Agent 365 step.</dd>
                        </div>
                        <div>
                            <dt>Runtime state</dt>
                            <dd>The agent's provisioning page is authoritative. This card does not prove that a Microsoft resource exists.</dd>
                        </div>
                    </dl>
                </div>
            </article>

            <article class="card capability-card" aria-labelledby="prompt-capability-heading">
                <div class="card-header">
                    <div>
                        <h2 id="prompt-capability-heading">Prompt Shields</h2>
                        <span class="section-caption">Pre-model prompt protection</span>
                    </div>
                    <StatusPill Value="@PromptShieldRuntimeStatus" />
                </div>
                <div class="card-body">
                    <p>Prompt Shields checks a prompt before the external agent calls its model. An allowed check creates a short-lived, single-use receipt for the matching interaction.</p>
                    <dl class="capability-facts">
                        <div>
                            <dt>Installed capability</dt>
                            <dd><StatusPill Value="@CapabilityDisplayStatus(PromptShieldCapability)" /></dd>
                        </div>
                        <div>
                            <dt>Ready for agent use</dt>
                            <dd>@PromptShieldReadinessExplanation</dd>
                        </div>
                        <div>
                            <dt>Default</dt>
                            <dd>@PromptShieldDefaultExplanation</dd>
                        </div>
                    </dl>
                    <div class="capability-actions">
                        <FluentAnchor Appearance="Appearance.Stealth" Href="/agents">Open per-agent controls</FluentAnchor>
                    </div>
                </div>
            </article>

            <article class="card capability-card" aria-labelledby="purview-capability-heading">
                <div class="card-header">
                    <div>
                        <h2 id="purview-capability-heading">Microsoft Purview</h2>
                        <span class="section-caption">Tenant setup and blueprint-specific runtime protection</span>
                    </div>
                    <StatusPill Value="@PurviewJourneyStatus" />
                </div>
                <div class="card-body">
                    <p>Bootstrap can prepare Purview prerequisites. Settings must still connect the tenant, review separate policy scopes, wait for propagation, and prove runtime readiness.</p>
                    <dl class="capability-facts">
                        <div>
                            <dt>Installed prerequisites</dt>
                            <dd><StatusPill Value="@CapabilityDisplayStatus(PurviewCapability)" /></dd>
                        </div>
                        <div>
                            <dt>Tenant connection</dt>
                            <dd><StatusPill Value="@(canReadProtectionGovernance ? ConnectionDisplayStatus : "Restricted")" /></dd>
                        </div>
                        <div>
                            <dt>Ready DLP profiles</dt>
                            <dd>@(canReadProtectionGovernance ? ReadyProfileCount is { } count ? $"{count} profile{(count == 1 ? string.Empty : "s")}" : "Not available" : "Restricted for this role")</dd>
                        </div>
                    </dl>
                    <p class="subtle-note">Know Your Data uses one fixed tenant-wide Group. DLP uses one Individual location for each blueprint. The Gateway never merges those scopes.</p>
                </div>
            </article>
        </div>
    }
</section>
}

@if (CurrentTask is SettingsTask.Connection or SettingsTask.Policy or SettingsTask.Collection ||
    CurrentTask == SettingsTask.Runtime && isAdministrator)
{
<section class="card protection-section" aria-labelledby="purview-journey-heading">
    <div class="card-header">
        <div>
            <h2 id="purview-journey-heading">@TaskTitle</h2>
            <span class="section-caption">Only the reviewed action runs. Nothing silently authors or broadens policy.</span>
        </div>
    </div>

    @if (!canReadProtectionGovernance)
    {
        <div class="card-body">
            <div class="subtle-note restricted-state" role="status">
                <strong>Governance details are restricted for this role.</strong>
                The Gateway exposes shared capability state here, but tenant connection, sensitive information inventory, Know Your Data, and blueprint DLP profile details are available only to Gateway Administrators and Operators. This does not mean they are absent or not connected.
            </div>
        </div>
    }
    else if (capabilitiesResource is not null && PurviewCapability?.Status == "NotInstalled")
    {
        <div class="card-body">
            <p class="subtle-note">The optional capability is not installed in this Gateway. Agents with Purview off can continue normally.</p>
            <a class="text-link" href="/settings">Back to protection overview</a>
        </div>
    }
    else if (connectionLoading && connectionResource is null)
    {
        <LoadingState Label="Loading the Microsoft Purview journey…" Detail="Checking the persisted Gateway connection and configuration." />
    }
    else if (connectionError is not null && connectionResource is null)
    {
        <div class="card-body">
            <ErrorState Title="Microsoft Purview connection state could not be loaded"
                        Message="@connectionError.Message"
                        CorrelationId="@connectionError.CorrelationId"
                        OnRetry="LoadProtectionJourneyAsync" />
        </div>
    }
    else
    {
        <div class="card-body stack">
            @if (protectionActionError is not null)
            {
                <ErrorState Title="The protection action was not completed"
                            Message="@protectionActionError.Message"
                            CorrelationId="@protectionActionError.CorrelationId" />
            }
            @if (!string.IsNullOrWhiteSpace(protectionAnnouncement))
            {
                <div class="success-banner" role="status" aria-live="polite">@protectionAnnouncement</div>
            }

            <div class="journey-grid">
                @if (CurrentTask == SettingsTask.Connection)
                {
                <article class="journey-card" aria-labelledby="purview-prerequisites-heading">
                    <span class="journey-step" aria-hidden="true">1</span>
                    <h3 id="purview-prerequisites-heading">Check shared prerequisites</h3>
                    <p>The Gateway reports whether the deployment prepared the shared Purview identities, permissions, and secure certificate path. Installed does not mean a tenant policy or runtime check is Ready.</p>
                    <StatusPill Value="@CapabilityDisplayStatus(PurviewCapability)" />
                </article>

                <article class="journey-card" aria-labelledby="purview-connection-heading">
                    <span class="journey-step" aria-hidden="true">2</span>
                    <h3 id="purview-connection-heading">Connect the tenant</h3>
                    <p>The Windows companion signs the intended administrator into Microsoft Purview and reads this tenant's sensitive information type definitions. These are classification rules, not your prompts or documents. It does not create a DLP policy, enable protection, or give the Gateway your sign-in session.</p>
                    <p>Submitting its result continues this connection operation. The Gateway must then verify its own configured app access independently. Only that check can verify the connection; configuring and testing DLP comes afterward.</p>
                    <dl class="review-summary">
                        <div><dt>Expected tenant</dt><dd><code>@signedInTenantId</code></dd></div>
                        <div><dt>Expected administrator</dt><dd><code>@(ActiveOperation?.ActorObjectId ?? signedInObjectId.ToString("D"))</code></dd></div>
                        @if (activeOperationId is { } connectionOperation)
                        {
                            <div><dt>Retained operation</dt><dd><code>@connectionOperation</code></dd></div>
                        }
                        @if (companionLaunch is { } currentLaunch)
                        {
                            <div><dt>Inventory generation</dt><dd><code>@currentLaunch.InventoryGenerationId</code></dd></div>
                            <div><dt>Launch expires</dt><dd>@FormatUtc(currentLaunch.ExpiresAtUtc)</dd></div>
                        }
                    </dl>
                    @if (Connection is { } tenantConnection && tenantConnection.TenantId != signedInTenantId)
                    {
                        <p class="subtle-note" role="alert">This connection belongs to another tenant. Refresh the signed-in tenant context before reviewing a connection; no mutation is available from this response.</p>
                    }
                    <StatusPill Value="@ConnectionDisplayStatus" />
                    @if (Connection is { } connection)
                    {
                        <div class="inventory-meta">
                            @if (connection.LastVerifiedAtUtc is { } verified)
                            {
                                <span>Last checked <time datetime="@AsUtc(verified).ToString("O")">@FormatUtc(verified)</time></span>
                            }
                            @if (connection.ExpiresAtUtc is { } expires)
                            {
                                <span>Connection review expires <time datetime="@AsUtc(expires).ToString("O")">@FormatUtc(expires)</time></span>
                            }
                        </div>
                    }
                    @if (Connection?.Status == "PendingVerification")
                    {
                        <div class="deployment-callout connection-guidance" role="status">
                            <strong>Companion result received. Checking Gateway access.</strong>
                            <span>Keep this operation open for automatic read-only updates. Do not rerun the helper or submit its result again while verification is pending. DLP protection is not enabled by this step.</span>
                        </div>
                    }
                    else if (Connection?.Status == "VerificationFailed")
                    {
                        <div class="deployment-callout connection-guidance" role="status">
                            <strong>Connection verification failed.</strong>
                            <span>A successful Windows sign-in alone does not verify the Gateway's access. Review the failure reference below and resolve its cause before reviewing another connection attempt. DLP protection is not enabled by this step.</span>
                        </div>
                    }
                    <div class="journey-actions">
                        @if (isAdministrator && JourneyGuidance.Action != ProtectionJourneyAction.ReviewConnection)
                        {
                            <FluentButton Appearance="Appearance.Neutral"
                                          OnClick="ReviewConnectionAsync"
                                          Disabled="@(!CanReviewConnection)">
                                @(Connection is null ? "Review tenant connection" : "Review connection refresh")
                            </FluentButton>
                        }
                    </div>
                    @if (!protectionOutcomeUnknown && !protectionActionBusy &&
                        (Connection?.Status == "AwaitingAdministrator" || RequiresCompanionCompletion))
                    {
                        @if (ConnectionLaunchExpired)
                        {
                            <div class="deployment-callout connection-guidance" role="status">
                                <strong>Connection launch expired.</strong>
                                <span>@ExpiredConnectionNextAction This preserves the previous operation; it does not extend or reuse its expired launch.</span>
                            </div>
                        }
                        else
                        {
                            <div class="deployment-callout connection-guidance" role="status">
                                <strong>Finish on Windows.</strong>
                                <span>Use the exact Gateway companion command for this operation. Its result starts independent Gateway verification; it does not make the connection Ready.</span>
                            </div>
                        }
                        @if (ActiveOperation is { } waitingOperation &&
                            waitingOperation.ActorObjectId != signedInObjectId.ToString("D"))
                        {
                            <p class="subtle-note" role="alert">This connection belongs to another administrator. Sign in as the administrator recorded on this operation, then return to the same task.</p>
                        }
                        @if (isAdministrator && companionLaunch is { } launch && CompanionCommand is { } command)
                        {
                            <div class="companion-download">
                                <a class="text-link"
                                   href="@CompanionDownloadHref"
                                   download="@CompanionDownloadName">
                                    Download the Windows Purview companion
                                </a>
                                <p>This script comes from this Gateway's deployed image. Downloading it does not run it. Keep the filename <code>@CompanionDownloadName</code>; the commands below use that exact file.</p>
                            </div>
                            <ol class="windows-companion-steps">
                                <li>
                                    <strong>Download, then open its folder.</strong>
                                    Use the link above. In your browser's Downloads list, choose Show in folder.
                                    Do not double-click the script.
                                </li>
                                <li>
                                    <strong>Open PowerShell 7 in that folder.</strong>
                                    In File Explorer, right-click empty space in the folder and choose Open in Terminal.
                                    If needed, enter <code>pwsh -NoLogo -NoProfile</code> to switch to PowerShell 7.
                                    If pwsh is not found, use your organization's approved PowerShell 7 installation process before continuing.
                                    The file is usually in Downloads. If PowerShell says the file cannot be found,
                                    check the current folder and filename before continuing.
                                </li>
                                <li class="companion-trust-step">
                                    <strong>Trust this one download before running it.</strong>
                                    Windows can mark downloaded scripts as blocked. After reviewing this Gateway download,
                                    and only if your organization permits it, copy and run this command:
                                    <CopyableValue Label="Trust this downloaded file" Value="@CompanionUnblockCommand"
                                                   Rows="2" CopyLabel="Copy trust command"
                                                   CopiedMessage="Trust command copied."
                                                   UnavailableMessage="Copy was unavailable. Select the trust command and copy it manually." />
                                    <p>No output is normal. This removes only this file's download marker; it does not change PowerShell's execution policy.
                                        A blocked script cannot perform this step itself because Windows stops it before it runs.</p>
                                    <p><strong>If your device requires signed scripts:</strong> stop and request an approved signed copy from your administrator.
                                        Do not lower or bypass the policy. If the browser never saved the file, follow your organization's download approval process.</p>
                                </li>
                                <li>
                                    <strong>Run the full connection command.</strong>
                                    Copy and run it in the same PowerShell window before
                                    <time datetime="@launch.ExpiresAtUtc.ToString("O")">@FormatUtc(launch.ExpiresAtUtc)</time>.
                                    Do not edit its IDs or expiry.
                                    <CopyableCommand Label="Run the connection" Command="@command" />
                                </li>
                                <li>
                                    <strong>Sign in and wait for the result.</strong>
                                    Complete the official Microsoft sign-in as the expected administrator shown above.
                                    PowerShell will print a long line beginning <code>A365GW_CONNECTION_RESULT:</code>.
                                </li>
                                <li>
                                    <strong>Copy that result and paste it below. No file is needed.</strong>
                                    Select the entire result line in PowerShell, including its prefix, and copy it.
                                    Do not copy the command, sign-in messages, or a reference-registration result.
                                    After the result is checked, choose Review companion completion, then Submit for verification once.
                                    The Gateway will check its own access; this does not enable DLP.
                                </li>
                            </ol>
                        }
                        else if (!ConnectionLaunchExpired)
                        {
                            <div class="subtle-note connection-guidance">
                                <strong>This connection is waiting for completion.</strong>
                                Check the existing operation to recover its accepted launch instructions. A closed companion or an unknown response does not undo accepted work. An expired or mismatched launch cannot be used.
                            </div>
                        }
                        @if (isAdministrator && activeOperationId is not null)
                        {
                            <div class="form-field connection-guidance">
                                <label for="purview-companion-output">Paste companion result</label>
                                <textarea id="purview-companion-output" class="form-control companion-output" rows="6"
                                          value="@companionOutputText" @oninput="ReadPastedCompanionEvidence"
                                          maxlength="@MaximumCompanionEvidenceBytes" disabled="@(!CanReadCompanionEvidence)"
                                          autocomplete="off" spellcheck="false" autocapitalize="off"
                                          placeholder="A365GW_CONNECTION_RESULT:..."
                                          aria-describedby="purview-companion-output-help purview-companion-evidence-status"
                                          aria-invalid="@(!string.IsNullOrWhiteSpace(companionEvidenceError) ? "true" : "false")"></textarea>
                                <span id="purview-companion-output-help" class="field-help">Paste the entire fresh A365GW_CONNECTION_RESULT: line from PowerShell. No text file is required. Only this operation's result is accepted (up to 512 KB); never paste passwords or sign-in tokens.</span>
                                <details class="companion-upload">
                                    <summary>Or upload a saved result (optional)</summary>
                                    <label for="purview-companion-evidence">Upload companion result file</label>
                                    <InputFile id="purview-companion-evidence"
                                               OnChange="ReadCompanionEvidenceAsync"
                                               disabled="@(!CanReadCompanionEvidence)"
                                               accept=".txt,text/plain"
                                               aria-describedby="purview-companion-file-help" />
                                    <span id="purview-companion-file-help" class="field-help">If you already saved the result, choose a text file containing only the same A365GW_CONNECTION_RESULT: line. Choosing a file replaces the pasted result. The same checks apply; the file is not stored.</span>
                                </details>
                                <div id="purview-companion-evidence-status" role="status" aria-live="polite">
                                @if (!string.IsNullOrWhiteSpace(companionEvidenceError))
                                {
                                    <span class="inline-validation" role="alert">@companionEvidenceError</span>
                                }
                                else if (companionEvidence is not null)
                                {
                                    <span class="field-help" role="status">Evidence checked for this tenant. @companionEvidence.SensitiveInformationTypes.Count current sensitive information type@(companionEvidence.SensitiveInformationTypes.Count == 1 ? string.Empty : "s") will be reviewed.</span>
                                }
                                </div>
                            </div>
                            <div class="journey-actions">
                                <FluentButton Appearance="Appearance.Accent"
                                              OnClick="ReviewCompanionCompletionAsync"
                                              Disabled="@(!CanReviewCompanionCompletion)">
                                    Review companion completion
                                </FluentButton>
                            </div>
                        }
                    }
                </article>
                }

                @if (CurrentTask is SettingsTask.Connection or SettingsTask.Collection)
                {
                <article class="journey-card" aria-labelledby="purview-inventory-heading">
                    <h3 id="purview-inventory-heading">@(CurrentTask == SettingsTask.Connection ? "Tenant inventory summary" : "Choose a data type for optional collection")</h3>
                    <p>@(CurrentTask == SettingsTask.Connection
                        ? "A sensitive information type (SIT) tells Purview what kind of sensitive data to look for. This step only finds the types already in your tenant. There is nothing to select here; choose one or more types once, in Set shared policy."
                        : "Optional tenant-wide collection uses one exact sensitive information type from the connected tenant. This separate choice does not select the types for a shared blueprint policy.")</p>
                    @if (CurrentTask == SettingsTask.Collection && staleSensitiveInformationType is { } previousSit)
                    {
                        <p class="subtle-note" role="status">Earlier choice: @previousSit.ExactName (<code>@previousSit.Id</code>). Your earlier choice remains visible, but needs a new selection and review against the current inventory.</p>
                    }
                    @if (!ConnectionIsReady)
                    {
                        <div class="subtle-note">@(Connection?.LastVerifiedAtUtc is not null
                            ? "The earlier connection is retained, but a fresh connection check is needed before this catalog can be used again."
                            : "Connect the tenant before loading its sensitive information types.")</div>
                    }
                    else if (inventoryLoading)
                    {
                        <LoadingState Label="Loading sensitive information types…" />
                    }
                    else if (inventoryError is not null)
                    {
                        <ErrorState Title="The current tenant inventory could not be loaded"
                                    Message="@inventoryError.Message"
                                    CorrelationId="@inventoryError.CorrelationId"
                                    OnRetry="LoadInventoryAsync" />
                    }
                    else if (inventoryResource is not null && !InventoryMatchesConnection)
                    {
                        <ErrorState Title="The inventory does not match this connection"
                                    Message="Refresh required. This response cannot be used for the signed-in tenant and current connection. Reload the inventory; no data type has been selected."
                                    OnRetry="LoadInventoryAsync" />
                    }
                    else if (inventoryResource?.Value.Items.Count is 0)
                    {
                        <EmptyState Icon="◇"
                                    Title="No sensitive information types returned"
                                    Description="The Gateway received an empty current inventory. Refresh the tenant connection or ask a Purview administrator to check the tenant." />
                    }
                    else if (!isAdministrator)
                    {
                        <div class="subtle-note restricted-state" role="status">
                            <strong>Tenant inventory requires an administrator.</strong>
                            Operators can monitor safe governance status, but only a Gateway Administrator can load or select the current tenant inventory.
                        </div>
                    }
                    else if (inventoryResource is not null)
                    {
                        @if (CurrentTask == SettingsTask.Connection)
                        {
                            <p class="inventory-count" data-testid="tenant-inventory-count">
                                <strong>@inventoryResource.Value.Items.Count existing sensitive information type@(inventoryResource.Value.Items.Count == 1 ? "" : "s") found in this tenant.</strong>
                            </p>
                            <p>@(InventoryIsCurrent
                                ? "The catalog is ready for policy review. Finding these types does not create a policy or enable protection."
                                : "This is the earlier catalog count, not current authorization. Review a connection refresh before configuring a policy; reloading this list alone does not renew it.")</p>
                        }
                        else
                        {
                        <div class="form-field">
                            <label for="purview-sensitive-information-type">Sensitive information type</label>
                            <select id="purview-sensitive-information-type"
                                    class="form-control"
                                    value="@selectedSitIndex"
                                    @onchange="SelectSensitiveInformationType"
                                    disabled="@(!InventoryIsCurrent || ControlsDisabled)"
                                    aria-describedby="purview-sensitive-information-type-help">
                                <option value="">Choose a current tenant item</option>
                                @for (var index = 0; index < inventoryResource.Value.Items.Count; index++)
                                {
                                    var item = inventoryResource.Value.Items[index];
                                    <option value="@index">@item.ExactName — @item.Publisher</option>
                                }
                            </select>
                            <span id="purview-sensitive-information-type-help" class="field-help">The Gateway keeps the selected tenant identity internally and shows only its exact name and publisher here.</span>
                        </div>
                        }
                        <div class="inventory-meta">
                            <span>Loaded <time datetime="@AsUtc(inventoryResource.Value.RetrievedAtUtc).ToString("O")">@FormatUtc(inventoryResource.Value.RetrievedAtUtc)</time></span>
                            <span>Expires <time datetime="@AsUtc(inventoryResource.Value.ExpiresAtUtc).ToString("O")">@FormatUtc(inventoryResource.Value.ExpiresAtUtc)</time></span>
                            <StatusPill Value="@(InventoryIsCurrent ? "Current" : "Refresh required")" />
                        </div>
                        <div class="journey-actions">
                            <FluentButton Appearance="Appearance.Stealth"
                                          OnClick="LoadInventoryAsync"
                                          Disabled="@(inventoryLoading || ControlsDisabled)">Reload inventory</FluentButton>
                        </div>
                        <p class="field-help">Reload inventory only reads the saved catalog. To renew expired access or definitions, use Review connection refresh above.</p>
                    }
                </article>
                }

                @if (CurrentTask == SettingsTask.Collection)
                {
                <article class="journey-card" aria-labelledby="purview-kyd-heading">
                    <span class="journey-step" aria-hidden="true">4</span>
                    <h3 id="purview-kyd-heading">Review tenant-wide Know Your Data</h3>
                    <p>This is one separate, fixed enterprise AI applications Group for the tenant. It is not a blueprint list and is not the DLP profile below.</p>
                    <StatusPill Value="@KnowYourDataDisplayStatus" />
                    @if (knowYourDataError is not null)
                    {
                        <ErrorState Title="Know Your Data state could not be loaded"
                                    Message="@knowYourDataError.Message"
                                    CorrelationId="@knowYourDataError.CorrelationId"
                                    OnRetry="LoadKnowYourDataAsync" />
                    }
                    else if (KnowYourData is { } knowYourData)
                    {
                        <p class="profile-summary">Current reviewed item: @knowYourData.SensitiveInformationTypeName. Mode: @FormatMode(knowYourData.Mode). Exact readback: @FriendlyState(knowYourData.ReadbackStatus).</p>
                    }
                    @if (isAdministrator)
                    {
                        <div class="form-field">
                            <label for="kyd-mode">Collection mode</label>
                            <select id="kyd-mode" class="form-control" @bind="kydMode" disabled="@ControlsDisabled">
                                <option value="AuditOnly">Audit only</option>
                                <option value="Enforce">Enforce</option>
                            </select>
                            <span class="field-help">The review covers text sent to and returned from agents. Returned text may be processed after the interaction and is not claimed as response-side blocking.</span>
                        </div>
                        <div class="journey-actions">
                            <FluentButton Appearance="Appearance.Neutral"
                                          OnClick="ReviewKnowYourDataAsync"
                                          Disabled="@(!CanReviewKnowYourData)">
                                Review fixed Know Your Data change
                            </FluentButton>
                        </div>
                    }
                </article>
                }
            </div>

            @if (CurrentTask is SettingsTask.Policy or SettingsTask.Runtime)
            {
            <section aria-labelledby="dlp-profile-form-heading">
                <div class="protection-section-heading">
                    <div>
                        <h2 id="dlp-profile-form-heading">@(CurrentTask == SettingsTask.Policy ? "Set the shared policy" : "Test a saved policy")</h2>
                        <p>A blueprint is the identity definition shared by a group of agents. Its policy sets what to look for; each agent still has its own protection choices.</p>
                    </div>
                </div>

                @if (profilesLoading && profilesResource is null)
                {
                    <LoadingState Label="Loading blueprint DLP profiles…" />
                }
                else if (profilesError is not null && profilesResource is null)
                {
                    <ErrorState Title="Blueprint DLP profiles could not be loaded"
                                Message="@profilesError.Message"
                                CorrelationId="@profilesError.CorrelationId"
                                OnRetry="LoadProfilesAsync" />
                }
                else
                {
                    @if (isAdministrator && CurrentTask == SettingsTask.Policy)
                    {
                        <section class="journey-card settings-block shared-policy-editor" aria-labelledby="dlp-review-form-heading">
                            <h3 id="dlp-review-form-heading" @ref="policyEditorHeading" tabindex="-1">@(editingProfile is null ? "Choose the blueprint to configure" : $"Review changes to {SafeProfileName(editingProfile)}")</h3>
                            <p>Choose the intended blueprint here. Next, select its sensitive information types once, adjust their starting values if needed, and review the complete change before confirming.</p>
                            @if (blueprintsLoading)
                            {
                                <LoadingState Label="Loading resolved blueprints…" />
                            }
                            else if (blueprintsError is not null)
                            {
                                <ErrorState Title="Resolved blueprints could not be loaded"
                                            Message="@blueprintsError.Message"
                                            CorrelationId="@blueprintsError.CorrelationId"
                                            OnRetry="LoadBlueprintsAsync" />
                            }
                            else
                            {
                                <div class="form-grid">
                                    <div class="form-field">
                                        <label for="dlp-blueprint">Which blueprint uses this shared policy?</label>
                                        <select id="dlp-blueprint"
                                                class="form-control"
                                                value="@selectedBlueprintIndex"
                                                @onchange="SelectBlueprint"
                                                aria-describedby="dlp-blueprint-help"
                                                disabled="@(editingProfile is not null || ControlsDisabled)">
                                            <option value="">Choose one blueprint</option>
                                            @for (var index = 0; index < blueprints.Count; index++)
                                            {
                                                <option value="@index">@SafeBlueprintName(blueprints[index])</option>
                                            }
                                        </select>
                                        <span id="dlp-blueprint-help" class="field-help">The policy is shared by agents using this blueprint. Saving it does not turn protection on for any agent.</span>
                                    </div>
                                </div>
                                @if (SelectedBlueprint is not null)
                                {
                                    <AgentProtectionConfiguration @ref="policyConfiguration"
                                        BlueprintApplicationId="@SelectedBlueprint?.BlueprintClientId"
                                        BlueprintDisplayName="@SelectedBlueprint?.DisplayName"
                                        ProfileId="@editingProfile?.Id"
                                        ContextKey="@($"settings|{contextGeneration}|{editingProfile?.Id}|{editingProfile?.RowVersion}")"
                                        IsAdministrator="isAdministrator" Busy="ParentControlsDisabled"
                                        PolicyOnly="true" StartOnConfirm="true"
                                        Changed="StateHasChanged"
                                        OnOperationRetained="RetainEditorOperation"
                                        OnConfigured="OnEditorConfiguredAsync" />
                                }
                                @if (editingProfile is not null)
                                {
                                    <div class="journey-actions">
                                        <FluentButton Appearance="Appearance.Stealth" OnClick="ClearProfileEditor"
                                                      Disabled="ControlsDisabled">Cancel edit</FluentButton>
                                    </div>
                                }
                            }
                        </section>
                    }
                    @if (profilesResource?.Value.Items.Count is 0)
                    {
                        <EmptyState Icon="◇"
                                    Title="No blueprint DLP profiles yet"
                                    Description="Core registration remains available. After a blueprint resolves, a Gateway Administrator can review its first DLP profile here." />
                    }
                    else if (profilesResource is not null)
                    {
                        <details class="saved-policy-library" open="@(CurrentTask == SettingsTask.Runtime || requestedProfileId is not null || (OperationMatchesTask && ActiveOperation is { Status: "Failed" or "RequiresManualIntervention" }))">
                        <summary>Saved policies and verification details (@VisibleProfiles.Count())</summary>
                        <p>Review earlier work here. An operation being accepted or a policy being saved does not by itself prove that agents are protected.</p>
                        @if (requestedProfileId is not null)
                        {
                            <p class="field-help">Showing the profile selected for this journey. <a href="@TaskHref("policy", clearProfile: true)">Show all shared policies</a>.</p>
                        }
                        <div class="profile-grid">
                            @foreach (var profile in VisibleProfiles.OrderBy(item => item.DisplayName, StringComparer.OrdinalIgnoreCase))
                            {
                                var profileGeneration = contextGeneration;
                                var hasRuntimeReadback = runtimeReadbacks.TryGetValue(profile.Id, out var runtimeReadback);
                                var displayProfile = hasRuntimeReadback ? runtimeReadback : profile;
                                <article class="profile-card" id="@($"profile-{profile.Id:D}")" tabindex="-1">
                                    <div class="profile-card-header">
                                        <div>
                                            <h3>@SafeProfileName(profile)</h3>
                                            <span class="section-caption">@BlueprintName(profile.BlueprintApplicationId) · @AgentProtectionUiMapping.PolicyLabel(profile.PolicyMode, profile.Mode)</span>
                                        </div>
                                        <StatusPill Value="@(displayProfile is null ? "Unknown" : ProfileDisplayStatus(displayProfile))" />
                                    </div>
                                    @if (displayProfile is not null)
                                    {
                                        <ProtectionSnapshot Profile="displayProfile" Compact="true" />
                                    }
                                    else
                                    {
                                        <p class="field-help" role="status">Current readiness is not confirmed. Follow the runtime result below; earlier badges are not reused.</p>
                                    }
                                    @if (requestedProfileId != profile.Id)
                                    {
                                        <a class="text-link" href="@TaskHref(CurrentTask == SettingsTask.Runtime ? "runtime" : "policy", profile.Id)">Follow this profile's next step</a>
                                    }
                                    <p class="profile-summary">Match ANY selected SIT (OR): @string.Join(", ", AgentProtectionUiMapping.Types(profile).Select(item => item.ExactName)). Per-SIT thresholds are retained, not summed. This shared profile is separate from the tenant-wide Know Your Data Group.</p>
                                    @if (!AgentProtectionUiMapping.Types(profile).All(AgentProtectionUiMapping.HasExplicitThresholds))
                                    {
                                        <p class="readiness-blockers">Legacy threshold evidence is incomplete or invalid; safe legacy provider import is not available. Use Review settings to explicitly supply all four threshold values per SIT and acknowledge shared-policy replacement. Reconcile that newly authorized configuration afterward; reconciliation alone cannot recover missing legacy thresholds.</p>
                                    }
                                    @if (displayProfile is not null)
                                    {
                                        <ProtectionReadinessPanel Readiness="displayProfile.Readiness" Label="@SafeProfileName(displayProfile)"
                                            PolicyMode="@(displayProfile.PolicyMode ?? (displayProfile.Mode == "Enforce" ? "Enforce" : "SimulationWithoutTips"))"
                                            ProfileStatus="@displayProfile.Status" EvidenceExpiresAtUtc="displayProfile.RuntimeBehaviorVerifiedUntilUtc" />
                                    }
                                    @if (RuntimeTestUiProtocol.IsHash(profile.RuntimeBehaviorSuiteHash))
                                    {
                                        <p class="field-help">Behavioral evidence suite: <code>@profile.RuntimeBehaviorSuiteHash</code></p>
                                    }
                                    @if (AgentProtectionUiMapping.PolicyMode(profile.PolicyMode, profile.Mode) != PurviewPolicyMode.Enforce)
                                    {
                                        <p class="profile-summary">Simulation readiness does not require actual blocking. A disabled policy remains configured/off, never enforced-ready.</p>
                                    }
                                    else
                                    {
                                        <p class="profile-summary">Configuration does not prove enforcement. Use Test protection to review one approved example per intended SIT plus a clean negative. Only complete approved sample behavior in effective policy scope can unlock enforcement readiness; Graph does not identify which SIT matched.</p>
                                    }
                                    @if (isAdministrator && CurrentTask == SettingsTask.Policy)
                                    {
                                        <div class="journey-actions">
                                            <FluentButton Appearance="Appearance.Stealth"
                                                          OnClick="@(() => EditProfile(profile))"
                                                          Disabled="@ControlsDisabled">Review settings</FluentButton>
                                            <FluentButton Appearance="Appearance.Stealth"
                                                          OnClick="@(() => ReviewExistingProfileActionAsync(profile, ProtectionAction.ReconcileProfile))"
                                                          Disabled="@(!CanReconcile(profile))">Review existing policy check</FluentButton>
                                        </div>
                                        <p class="field-help">This check reads the existing Microsoft policy and rule; it does not create or change them. A newly confirmed check can bind unchanged selections to a refreshed inventory and clear earlier behavior verification.</p>
                                        @if (ReconciliationUnavailableReason(profile) is { } reason)
                                        {
                                            <p class="field-help">@reason</p>
                                        }
                                    }
                                    @if (isAdministrator && CurrentTask == SettingsTask.Runtime)
                                    {
                                        <div id="@($"profile-runtime-{profile.Id:D}")" tabindex="-1">
                                        <PurviewRuntimeTestPanel ProfileId="profile.Id" ContextKey="@profile.RowVersion"
                                            ExpectedProfileRowVersion="@profile.RowVersion"
                                            IsAdministrator="isAdministrator" Disabled="ControlsDisabled"
                                            OnReadinessChanged="@((PurviewDlpProfileDto? readback) => RetainRuntimeReadback(profile.Id, profileGeneration, readback))" />
                                        </div>
                                    }
                                </article>
                            }
                        </div>
                        </details>
                    }
                }
            </section>
            }

        </div>
    }
</section>
}

@if (isAdministrator && CurrentTask == SettingsTask.Defaults)
{
    @if (settingsLoading && form is null)
    {
        <div class="card settings-block">
            <LoadingState Label="Loading system defaults…" Detail="Reading registration defaults and operational limits." />
        </div>
    }
    else if (settingsLoadError is not null && form is null)
    {
        <div class="settings-block">
            <ErrorState Title="System defaults could not be loaded"
                        Message="@settingsLoadError.Message"
                        CorrelationId="@settingsLoadError.CorrelationId"
                        OnRetry="LoadSettingsAsync" />
        </div>
    }
    else if (form is not null)
    {
        <EditForm Model="form" OnValidSubmit="RequestSettingsSave" class="card form-card settings-form settings-block">
            <DataAnnotationsValidator />
            <ValidationSummary />

            @if (settingsSaveError is not null)
            {
                <div class="form-section">
                    <ErrorState Message="@settingsSaveError.Message" CorrelationId="@settingsSaveError.CorrelationId" />
                </div>
            }
            @if (settingsSaveOutcomeUnknown)
            {
                <div class="form-section">
                    <div class="deployment-callout ambiguous-save-recovery" role="alert">
                        <strong>The save result is not yet known.</strong>
                        <span>The Gateway may already have accepted this exact change. Do not create a new save. Retry the same protected request, or reload the current server settings before making another change.</span>
                        <div class="journey-actions">
                            <FluentButton Appearance="Appearance.Accent"
                                          OnClick="RetryAmbiguousSettingsSaveAsync"
                                          Disabled="@(saving || settingsLoading)">
                                Retry the same save
                            </FluentButton>
                            <FluentButton Appearance="Appearance.Neutral"
                                          OnClick="LoadSettingsAsync"
                                          Disabled="@(saving || settingsLoading)">
                                Reload current settings
                            </FluentButton>
                        </div>
                    </div>
                </div>
            }
            @if (settingsLoadError is not null)
            {
                <div class="form-section">
                    <ErrorState Title="The latest system defaults could not be loaded"
                                Message="@settingsLoadError.Message"
                                CorrelationId="@settingsLoadError.CorrelationId"
                                OnRetry="LoadSettingsAsync" />
                </div>
            }
            @if (settingsSaved)
            {
                <div class="success-banner" role="status"><strong>Settings saved.</strong> The control plane accepted the updated configuration.</div>
            }

            <fieldset disabled="@ControlsDisabled" class="settings-edit-fields">
            <section class="form-section" aria-labelledby="defaults-heading">
                <h2 id="defaults-heading">Registration defaults</h2>
                <p>Applied to new agent registrations unless the registration supplies an explicit supported choice. A protection default can be enabled only while the server reports its required readiness.</p>
                <div class="form-grid">
                    <fieldset class="feature-group full" aria-describedby="default-observability-help">
                        <legend>Activity observability defaults</legend>
                        <p id="default-observability-help">New agents use these independent destinations. Gateway platform health, security, and operational diagnostics remain configured separately.</p>
                        <div class="form-grid">
                            <div class="form-field checkbox-field">
                                <label class="checkbox-label" for="default-agent365-observability-enabled">
                                    <InputCheckbox id="default-agent365-observability-enabled" @bind-Value="form.DefaultAgent365ObservabilityEnabled" />
                                    <span><strong>Agent 365 observability by default</strong><small>Send supported sanitized activity telemetry to Microsoft Agent 365.</small></span>
                                </label>
                            </div>
                            <div class="form-field checkbox-field">
                                <label class="checkbox-label" for="default-azure-monitor-export-enabled">
                                    <InputCheckbox id="default-azure-monitor-export-enabled" @bind-Value="form.DefaultAzureMonitorExportEnabled" />
                                    <span><strong>Also mirror sanitized activity telemetry to Azure Monitor</strong><small>Use Azure Monitor as an optional second destination for new agents.</small></span>
                                </label>
                            </div>
                        </div>
                    </fieldset>

                    <fieldset class="feature-group full" aria-describedby="default-prompt-shield-help">
                        <legend>Prompt Shields default</legend>
                        <p id="default-prompt-shield-help">New registrations can evaluate prompts before model invocation only when the shared capability is installed and the Gateway reports it available.</p>
                        <div class="form-field checkbox-field">
                            <label class="checkbox-label" for="default-prompt-shield-enabled">
                                <InputCheckbox id="default-prompt-shield-enabled"
                                               @bind-Value="form.DefaultPromptShieldEnabled"
                                               disabled="@(!CanChangePromptShieldDefault)" />
                                <span><strong>Enable Prompt Shields by default</strong><small>Each agent can still be changed separately. Protected clients must use the allowed single-use receipt.</small></span>
                            </label>
                            @if (!PromptShieldReady)
                            {
                                <span class="field-help">Unavailable for a new default until both the installed capability and server readiness check pass. A stored enabled value can be turned off.</span>
                            }
                        </div>
                    </fieldset>

                    <fieldset class="feature-group full" aria-describedby="default-purview-help">
                        <legend>Microsoft Purview defaults</legend>
                        <p id="default-purview-help">A default never creates or overwrites policy. Registration still requires an existing matching profile or explicit review and confirmation of new configuration.</p>
                        <div class="form-grid">
                            <div class="form-field checkbox-field">
                                <label class="checkbox-label" for="default-purview-enabled">
                                    <InputCheckbox id="default-purview-enabled"
                                                   @bind-Value="form.DefaultPurviewEnabled"
                                                   disabled="@(!CanChangePurviewDefault)" />
                                    <span><strong>Offer Purview by default</strong><small>The registration page reviews the exact selected blueprint and policy; incomplete enabled configuration is blocked.</small></span>
                                </label>
                                @if (!HasSelectableProfile)
                                {
                                    <span class="field-help">Unavailable for a new default until a blueprint has current enforcing readiness or a verified non-enforcing configuration. A stored enabled value can be turned off.</span>
                                }
                            </div>
                            <div class="form-field">
                                <label for="default-purview-mode">Legacy Gateway runtime default</label>
                                <InputSelect id="default-purview-mode"
                                             class="form-control"
                                             @bind-Value="form.DefaultPurviewMode"
                                             disabled="@(!form.DefaultPurviewEnabled || !HasSelectableProfile)">
                                    <option value="AuditOnly">Audit only</option>
                                    <option value="Enforce">Enforce</option>
                                </InputSelect>
                                <span class="field-help">This compatibility setting is not the shared policy lifecycle mode. Use the blueprint profile editor above for Enforce, either simulation mode, or configured/off.</span>
                            </div>
                        </div>
                    </fieldset>
                </div>
            </section>

            <section class="form-section" aria-labelledby="retention-heading">
                <h2 id="retention-heading">Idempotency lifetime</h2>
                <p>The Gateway applies this lifetime when it creates an idempotency record. Other persisted compatibility retention values do not have a cleanup worker and are not editable.</p>
                <div class="form-grid">
                    <NumberField Id="retention-idempotency" Label="Idempotency records (days)" @bind-Value="form.RetentionDaysIdempotencyRecords" />
                </div>
            </section>

            <section class="form-section" aria-labelledby="limits-heading">
                <h2 id="limits-heading">Ingress rate limits <span class="optional-label">Requests per minute</span></h2>
                <p>The Gateway enforces fixed one-minute limits in SQL across every API replica. Credential limits isolate a single key, registration limits aggregate rotated keys for one agent, and the global limit protects shared capacity.</p>
                <div class="form-grid form-grid-three">
                    <NumberField Id="limit-client" Label="Per credential" @bind-Value="form.RateLimitPerClient" />
                    <NumberField Id="limit-agent" Label="Per registration" @bind-Value="form.RateLimitPerAgent" />
                    <NumberField Id="limit-global" Label="Global" @bind-Value="form.RateLimitGlobal" />
                </div>
                @if (!LimitsAreOrdered)
                {
                    <p class="inline-validation" role="alert">The global limit must be at least as large as each scoped limit.</p>
                }
                @if (!ProtectionDefaultsAreReady)
                {
                    <p class="inline-validation" role="alert">Turn off any unavailable protection default, or finish its readiness steps, before saving.</p>
                }
            </section>

            </fieldset>
            <div class="form-actions">
                <FluentButton Appearance="Appearance.Neutral"
                              OnClick="LoadSettingsAsync"
                              Disabled="@(settingsLoading || saving || settingsSaveOutcomeUnknown)">Discard changes</FluentButton>
                <FluentButton Type="ButtonType.Submit"
                              Appearance="Appearance.Accent"
                              Disabled="@(ControlsDisabled || settingsSaveOutcomeUnknown || !LimitsAreOrdered || !ProtectionDefaultsAreReady)">Review and save</FluentButton>
            </div>
        </EditForm>
    }
}

@if (dialogKind != ConfirmationDialogKind.None)
{
var activeConfirmation = confirmationGeneration;
<ConfirmPanel Visible="true"
              Busy="@(saving || protectionActionBusy)"
              ConfirmDisabled="@(protectionReview is { } ticket && AsUtc(ticket.ExpiresAtUtc) <= Clock.GetUtcNow().UtcDateTime)"
              Title="@ConfirmationTitle"
              Message="@ConfirmationMessage"
              ConfirmLabel="@ConfirmationButtonLabel"
              OnConfirm="@(() => ConfirmDialogAsync(activeConfirmation))"
              OnCancel="CancelDialog">
    <AdditionalContent>
        @if (dialogKind == ConfirmationDialogKind.SystemSettings)
        {
            <div class="subtle-note">The update is audited by the control plane. Existing registrations and in-flight operations are not reconfigured or restarted by this page.</div>
        }
        else if (protectionReview is { } review)
        {
            <dl class="review-summary">
                <div><dt>Action</dt><dd>@FriendlyOperation(review.Review.OperationType)</dd></div>
                <div><dt>Tenant ID</dt><dd><code>@review.Review.TenantId.ToString("D")</code></dd></div>
                <div><dt>Target</dt><dd>@PendingTargetLabel</dd></div>
                <div><dt>Target binding</dt><dd>@review.Review.TargetType <code>@review.Review.TargetIdentifier</code></dd></div>
                <div><dt>Scope</dt><dd>@FriendlyScope(review.Review.ScopeType)</dd></div>
                @if (review.Review.BlueprintApplicationId is { } blueprintApplicationId)
                {
                    <div><dt>Blueprint application ID</dt><dd><code>@blueprintApplicationId.ToString("D")</code></dd></div>
                }
                @if (!string.IsNullOrWhiteSpace(review.Review.SensitiveInformationTypeName))
                {
                    <div><dt>Sensitive information</dt><dd>@review.Review.SensitiveInformationTypeName</dd></div>
                }
                @if (review.Review.SensitiveInformationTypeId is { } sensitiveInformationTypeId)
                {
                    <div><dt>Sensitive information type ID</dt><dd><code>@sensitiveInformationTypeId.ToString("D")</code></dd></div>
                }
                @if (review.Review.SourceOperationId is { } sourceOperationId)
                {
                    <div><dt>Source operation ID</dt><dd><code>@sourceOperationId.ToString("D")</code></dd></div>
                }
                @if (review.Review.InventoryGenerationId is { } inventoryGenerationId)
                {
                    <div><dt>Inventory generation ID</dt><dd><code>@inventoryGenerationId.ToString("D")</code></dd></div>
                }
                @if (!string.IsNullOrWhiteSpace(review.Review.EvidenceDigest))
                {
                    <div><dt>Evidence digest</dt><dd><code>@review.Review.EvidenceDigest</code></dd></div>
                }
                @if (!string.IsNullOrWhiteSpace(review.Review.Mode))
                {
                    <div><dt>Mode</dt><dd>@FormatMode(review.Review.Mode)</dd></div>
                }
                @if (review.Review.Activities.Count > 0)
                {
                    <div><dt>Activities</dt><dd>@FormatActivities(review.Review.Activities)</dd></div>
                }
                @if (review.Review.Actions.Count > 0)
                {
                    <div><dt>Outcomes</dt><dd>@FormatActions(review.Review.Actions)</dd></div>
                }
            </dl>
            @if (review.Review.TargetType == "KnowYourDataConfiguration")
            {
                <p class="field-help">Full AI content capture is off. Classification is limited to the selected sensitive information type; the broader full-content setting requires All classifiers.</p>
            }
            <div class="subtle-note">@review.Review.ReadinessDisclaimer</div>
            <p class="field-help">This short review expires at <time datetime="@AsUtc(review.ExpiresAtUtc).ToString("O")">@FormatUtc(review.ExpiresAtUtc)</time>. Confirmation queues only this reviewed action.</p>
        }
    </AdditionalContent>
</ConfirmPanel>
}
</ReadinessExpiryBoundary>

@code {
    [Parameter] public string? TaskName { get; set; }
    [SupplyParameterFromQuery(Name = "operation")] public string? OperationReference { get; set; }
    [SupplyParameterFromQuery(Name = "profile")] public string? ProfileReference { get; set; }
    private static readonly string[] PurviewActivities = ["UploadText", "DownloadText"];
    private static readonly string[] RequiredCompanionCapabilities =
    [
        "DlpPolicy.ReadWrite",
        "DlpRule.ReadWrite",
        "KnowYourData.ReadWrite",
        "SensitiveInformationTypes.Read"
    ];
    private static readonly JsonSerializerOptions CompanionJsonOptions = new()
    {
        PropertyNamingPolicy = JsonNamingPolicy.CamelCase,
        PropertyNameCaseInsensitive = false,
        UnmappedMemberHandling = JsonUnmappedMemberHandling.Disallow
    };
