    private string? ReconciliationUnavailableReason(PurviewDlpProfileDto profile)
    {
        if (ControlsDisabled)
            return "Wait for the current page request to finish before reviewing a check.";
        if (!ConnectionIsReady)
            return "Refresh the tenant connection, then return here. This check needs current access and inventory.";
        if (ProfileIsPending(profile))
            return "An operation for this profile is still pending. Check that operation instead of starting another check.";
        if (!AgentProtectionUiMapping.Types(profile).All(AgentProtectionUiMapping.HasExplicitThresholds))
            return "Use Review settings to explicitly complete the saved classifier thresholds before this policy can be checked.";
        return string.IsNullOrWhiteSpace(profile.RowVersion)
            ? "Reload the saved policy to obtain its current version before reviewing a check." : null;
    }

