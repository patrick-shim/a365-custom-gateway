        Notice="@operationPollingNotice" LastCheckedAtUtc="@operationLastCheckedAtUtc"
        NextActionOverride="@(ConnectionLaunchExpired && ActiveOperation is { Type: "ConnectPurviewTenant", Status: "AwaitingAdministrator" } ? ExpiredConnectionNextAction : null)"
