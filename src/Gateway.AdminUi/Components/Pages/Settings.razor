    private bool CanReviewExpiredConnection
    {
        get
        {
            if (!ConnectionLaunchExpired ||
                Connection is not { ExpiresAtUtc: { } expiry } connection)
                return false;

            if (activeOperationId is null && ActiveOperation is null)
                return true;

            return ActiveOperation is { Type: "ConnectPurviewTenant", Status: "AwaitingAdministrator" } operation &&
                operation.TenantId == signedInTenantId &&
                operation.ActorObjectId == signedInObjectId.ToString("D") &&
                operation.TargetType == "PurviewTenantConnection" &&
                operation.TargetIdentifier == connection.Id.ToString("D") &&
                companionLaunch is { } launch &&
                launch.ExpiresAtUtc.UtcDateTime == AsUtc(expiry) &&
                HasExpectedCompanionBinding(launch);
        }
    }
