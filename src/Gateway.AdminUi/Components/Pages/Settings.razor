    protected override async Task OnInitializedAsync()
    {
        var authenticationState = await AuthenticationStateProvider
            .GetAuthenticationStateAsync()
            .WaitAsync(disposeCts.Token);
        SetRole(authenticationState.User);
        roleLoaded = true;
    }

    protected override async Task OnParametersSetAsync()
    {
        var location = $"{TaskName}|{OperationReference}|{ProfileReference}";
        if (!roleLoaded || disposed || lastLocation == location)
            return;
        lastLocation = location;
        changingContext = true;
        var generation = ++contextGeneration;
        confirmationGeneration++;
        await CancelOperationUpdatesAsync();
        if (!IsCurrent(generation))
            return;
        observedContext = -1;
        observedOperationId = null;
        operationPollingNotice = null;
        operationLastCheckedAtUtc = null;
        operationContextRefreshing = operationContextRefreshNeeded = false;
        focusOutcomeRequested = false;
        runtimeReadbacks.Clear();
        CancelDialog();
        ClearCompanionEvidence();
        companionLaunch = null;
        protectionActionError = null;
        protectionOutcomeUnknown = false;
        operationResource = null;
        operationError = null;
        activeOperationId = null;
        editingProfile = null;
        selectedBlueprintIndex = string.Empty;
        reloading = capabilitiesLoading = connectionLoading = inventoryLoading =
            knowYourDataLoading = profilesLoading = blueprintsLoading = operationLoading =
            settingsLoading = protectionActionBusy = saving = false;
        ReadOperationFromLocation();
        ReadProfileFromLocation();
        protectionOutcomeUnknown = activeOperationId is not null || operationError is not null;
        try
        {
            if (CurrentTask != SettingsTask.Unknown)
                await ReloadAllAsync();
        }
        finally
        {
            if (IsCurrent(generation))
                changingContext = false;
        }
    }

    private async Task ReloadAllAsync()
    {
        if (reloading || disposed || saving || protectionActionBusy || operationContextRefreshing ||
            PolicyPrerequisitesAreLoading)
        {
            return;
        }

        reloading = true;
        var generation = contextGeneration;
        await CancelOperationUpdatesAsync();
        if (!IsCurrent(generation))
            return;
        observedContext = -1;
        observedOperationId = null;
        settingsSaved = false;
        protectionAnnouncement = null;
        try
        {
            var protectionTask = LoadProtectionJourneyAsync();
            var operationTask = LoadActiveOperationAsync();
            if (isAdministrator)
            {
                await Task.WhenAll(
                    protectionTask,
                    operationTask,
                    LoadSettingsAsync());
            }
            else
            {
                await Task.WhenAll(protectionTask, operationTask);
            }
            if (IsCurrent(generation) && ProtectionReadsSucceeded)
            {
                operationContextRefreshNeeded = false;
                runtimeReadbacks.Clear();
            }
        }
        finally
        {
            if (IsCurrent(generation))
                reloading = false;
        }
    }

    private Task LoadProtectionJourneyAsync() => LoadProtectionJourneyAsync(disposeCts.Token);

    private async Task LoadProtectionJourneyAsync(CancellationToken cancellationToken)
    {
        var generation = contextGeneration;
        await LoadCapabilitiesAsync(cancellationToken);
        cancellationToken.ThrowIfCancellationRequested();
        if (!IsCurrent(generation))
            return;
        if (!ShouldReadProtectionContext)
        {
            connectionResource = null;
            inventoryResource = null;
            knowYourDataResource = null;
            profilesResource = null;
            blueprints = [];
            return;
        }

        await LoadConnectionAsync(cancellationToken);
        cancellationToken.ThrowIfCancellationRequested();
        if (!IsCurrent(generation))
            return;

        var tasks = new List<Task>();
        if (ShouldReadProfiles)
            tasks.Add(LoadProfilesAsync(cancellationToken));
        if (ShouldReadKnowYourData)
            tasks.Add(LoadKnowYourDataAsync(cancellationToken));
        if (ShouldReadInventory)
            tasks.Add(LoadInventoryAsync(cancellationToken));
        if (ShouldReadBlueprints)
        {
            tasks.Add(LoadBlueprintsAsync(cancellationToken));
        }

        await Task.WhenAll(tasks);
    }

    private Task LoadCapabilitiesAsync() => LoadCapabilitiesAsync(disposeCts.Token);

    private async Task LoadCapabilitiesAsync(CancellationToken cancellationToken)
    {
        if (capabilitiesLoading)
        {
            return;
        }

        capabilitiesLoading = true;
        var generation = contextGeneration;
        capabilitiesError = null;
        try
        {
            var response = await Api.GetProtectionCapabilitiesAsync(cancellationToken).WaitAsync(cancellationToken);
            cancellationToken.ThrowIfCancellationRequested();
            if (IsCurrent(generation))
                capabilitiesResource = response;
        }
        catch (OperationCanceledException) when (disposeCts.IsCancellationRequested)
        {
        }
        catch (OperationCanceledException) when (cancellationToken.IsCancellationRequested) { throw; }
        catch (Exception exception)
        {
            SetReadError(generation, exception, error => { capabilitiesResource = null; capabilitiesError = error; });
        }
        finally
        {
            if (IsCurrent(generation))
                capabilitiesLoading = false;
        }
    }

    private Task LoadConnectionAsync() => LoadConnectionAsync(disposeCts.Token);

    private async Task LoadConnectionAsync(CancellationToken cancellationToken)
    {
        if (!canReadProtectionGovernance || connectionLoading)
        {
            return;
        }

        connectionLoading = true;
        var generation = contextGeneration;
        connectionError = null;
        try
        {
            var response = await Api.GetPurviewTenantConnectionAsync(cancellationToken).WaitAsync(cancellationToken);
            cancellationToken.ThrowIfCancellationRequested();
            if (IsCurrent(generation))
                connectionResource = response;
        }
        catch (OperationCanceledException) when (disposeCts.IsCancellationRequested)
        {
        }
        catch (OperationCanceledException) when (cancellationToken.IsCancellationRequested) { throw; }
        catch (Exception exception)
        {
            SetReadError(generation, exception, error => { connectionResource = null; connectionError = error; });
        }
        finally
        {
            if (IsCurrent(generation))
                connectionLoading = false;
        }
    }

    private Task LoadInventoryAsync() => LoadInventoryAsync(disposeCts.Token);

    private async Task LoadInventoryAsync(CancellationToken cancellationToken)
    {
        if (!isAdministrator || !ConnectionIsReady || inventoryLoading)
        {
            return;
        }

        inventoryLoading = true;
        var generation = contextGeneration;
        inventoryError = null;
        var previousSelection = SelectedSensitiveInformationType;
        try
        {
            var response = await Api.GetPurviewSensitiveInformationTypesAsync(cancellationToken).WaitAsync(cancellationToken);
            cancellationToken.ThrowIfCancellationRequested();
            if (!IsCurrent(generation))
                return;
            inventoryResource = response;
            staleSensitiveInformationType = previousSelection ?? staleSensitiveInformationType;
            selectedSitIndex = string.Empty;
            if (dialogKind == ConfirmationDialogKind.ProtectionReview)
                CancelDialog();
            if (CurrentTask == SettingsTask.Collection && previousSelection is not null)
            {
                protectionAnnouncement = "The tenant inventory was refreshed. Choose the sensitive information type again before reviewing optional collection.";
            }
        }
        catch (OperationCanceledException) when (disposeCts.IsCancellationRequested)
        {
        }
        catch (OperationCanceledException) when (cancellationToken.IsCancellationRequested) { throw; }
        catch (Exception exception)
        {
            SetReadError(generation, exception, error =>
            {
                inventoryResource = null;
                selectedSitIndex = string.Empty;
                inventoryError = error;
            });
        }
        finally
        {
            if (IsCurrent(generation))
                inventoryLoading = false;
        }
    }

    private Task LoadKnowYourDataAsync() => LoadKnowYourDataAsync(disposeCts.Token);

    private async Task LoadKnowYourDataAsync(CancellationToken cancellationToken)
    {
        if (!canReadProtectionGovernance || knowYourDataLoading)
        {
            return;
        }

        knowYourDataLoading = true;
        var generation = contextGeneration;
        knowYourDataError = null;
        try
        {
            var response = await Api.GetPurviewKnowYourDataAsync(cancellationToken).WaitAsync(cancellationToken);
            cancellationToken.ThrowIfCancellationRequested();
            if (!IsCurrent(generation))
                return;
            knowYourDataResource = response;
            if (KnowYourData?.Mode is "AuditOnly" or "Enforce")
            {
                kydMode = KnowYourData.Mode;
            }
        }
        catch (OperationCanceledException) when (disposeCts.IsCancellationRequested)
        {
        }
        catch (OperationCanceledException) when (cancellationToken.IsCancellationRequested) { throw; }
        catch (Exception exception)
        {
