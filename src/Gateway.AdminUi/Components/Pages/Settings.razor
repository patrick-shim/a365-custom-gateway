        private static string ToLegacyObservabilityMode(bool agent365Enabled, bool azureMonitorEnabled) =>
            (agent365Enabled, azureMonitorEnabled) switch
            {
                (true, true) => "Agent365AzureMonitor",
                (true, false) => "Agent365",
                (false, true) => "GatewayOnly",
                _ => "Disabled"
            };

        private static bool LegacyAgent365ObservabilityEnabled(string? mode) => mode switch
        {
            "Agent365" or "Agent365AzureMonitor" => true,
            "Disabled" or "GatewayOnly" => false,
            _ => throw new InvalidOperationException("The stored observability default is not recognized.")
        };

        private static bool LegacyAzureMonitorExportEnabled(string? mode) => mode switch
        {
            "GatewayOnly" or "Agent365AzureMonitor" => true,
            "Disabled" or "Agent365" => false,
            _ => throw new InvalidOperationException("The stored observability default is not recognized.")
        };
    }
}
