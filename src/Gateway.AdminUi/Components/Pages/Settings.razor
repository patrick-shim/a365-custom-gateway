    private static bool ReviewMatchesAction(string operationType, ProtectionAction action) =>
        action switch
        {
            ProtectionAction.ConnectTenant or ProtectionAction.CompleteTenantConnection =>
                operationType == (
                    action == ProtectionAction.CompleteTenantConnection
                        ? "CompletePurviewTenantConnection"
                        : "ConnectPurviewTenant"),
            ProtectionAction.ConfigureKnowYourData =>
                operationType == "CreateOrUpdateKnowYourData",
            ProtectionAction.CreateProfile or ProtectionAction.UpdateProfile =>
                operationType == "CreateOrUpdateDlpProfile",
            ProtectionAction.ReconcileProfile =>
                operationType == "ReconcileDlpProfile",
            _ => false
        };

    private bool ReviewBindingMatchesAction(
        ProtectionOperationReviewSummaryDto review,
        ProtectionAction action)
    {
        if (review.TenantId != signedInTenantId || review.EnforcementPlane != "Application")
            return false;
        return action switch
        {
            ProtectionAction.ConnectTenant => review.TargetType == "PurviewTenantConnection" &&
                review.TargetIdentifier == signedInTenantId.ToString("D") && review.ScopeType == "Tenant",
            ProtectionAction.CompleteTenantConnection => review.TargetType == "PurviewTenantConnection" &&
                review.TargetIdentifier == Connection?.Id.ToString("D") && review.ScopeType == "Tenant" &&
                review.SourceOperationId == activeOperationId &&
                review.InventoryGenerationId == companionInventoryGenerationId &&
                string.Equals(review.EvidenceDigest, companionEvidenceDigest, StringComparison.Ordinal),
            ProtectionAction.ConfigureKnowYourData => review.TargetType == "KnowYourDataConfiguration" &&
                Guid.TryParse(review.TargetIdentifier, out var targetId) && targetId != Guid.Empty &&
                (KnowYourData is null || targetId == KnowYourData.Id) && review.ScopeType == "Group" &&
                review.SensitiveInformationTypeId == SelectedSensitiveInformationType?.Id &&
                review.SensitiveInformationTypeName == SelectedSensitiveInformationType?.ExactName &&
                review.Mode == kydMode && review.Actions.Count == 0 &&
                review.Activities.Order(StringComparer.Ordinal).SequenceEqual(PurviewActivities.Order(StringComparer.Ordinal)),
            ProtectionAction.ReconcileProfile => review.TargetType == "DlpProfile" &&
                review.TargetIdentifier == pendingProfileId?.ToString("D") && review.ScopeType == "Individual" &&
                review.AffectsAllBlueprintAgents &&
                profilesResource?.Value.Items.Any(profile => profile.Id == pendingProfileId &&
                    profile.BlueprintApplicationId == review.BlueprintApplicationId &&
                    profile.PolicyMode == review.PolicyMode) == true,
            _ => false
        };
    }

