    private async Task ReadCompanionEvidenceAsync(InputFileChangeEventArgs args)
    {
        companionEvidence = null;
        companionInventoryGenerationId = null;
        companionEvidenceDigest = null;
        companionEvidenceError = null;
        protectionActionError = null;

        if (args.FileCount != 1)
        {
            companionEvidenceError = "Choose exactly one fresh Gateway companion evidence file.";
            return;
        }

        var file = args.File;
        if (file.Size is < 1 or > MaximumCompanionEvidenceBytes)
        {
            companionEvidenceError = "The companion evidence file is empty or larger than the supported 512 KB limit.";
            return;
        }

        try
        {
            await using var stream = file.OpenReadStream(
                MaximumCompanionEvidenceBytes,
                disposeCts.Token);
            using var reader = new StreamReader(
                stream,
                StrictUtf8,
                detectEncodingFromByteOrderMarks: false,
                leaveOpen: false);
            var output = await reader.ReadToEndAsync(disposeCts.Token);
            if (!TryDecodeCompanionOutput(output, out var decodedOutput) ||
                !ValidateCompanionOutput(decodedOutput))
            {
                companionEvidenceError =
                    "This file is not the single fresh result produced for the signed-in tenant, administrator, and operation. Run the Gateway companion again and save only its result line.";
                return;
            }

            companionEvidence = new PurviewTenantConnectionEvidenceDto(
                decodedOutput.TenantId,
                decodedOutput.AdministratorObjectId,
                decodedOutput.AuthorizedCapabilities,
                decodedOutput.ObservedAtUtc,
                decodedOutput.InventoryExpiresAtUtc,
                decodedOutput.SensitiveInformationTypes);
            companionInventoryGenerationId =
                decodedOutput.InventoryGenerationId;
            companionEvidenceDigest =
                PurviewTenantConnectionEvidenceDigest.Compute(
                    decodedOutput.OperationId,
                    decodedOutput.InventoryGenerationId,
                    companionEvidence);
        }
        catch (OperationCanceledException) when (disposeCts.IsCancellationRequested)
        {
        }
        catch (Exception)
        {
            companionEvidenceError =
                "The Gateway could not read this companion output. Run the companion again and save only its unmodified prefixed result line.";
        }
    }

    private static bool TryDecodeCompanionOutput(
        string output,
        out PurviewCompanionOutput decodedOutput)
    {
        decodedOutput = default!;
        var line = RemoveOneTerminalLineEnding(output);
        if (line.Length <= CompanionResultPrefix.Length ||
            line.Contains('\r') ||
            line.Contains('\n') ||
            !line.StartsWith(CompanionResultPrefix, StringComparison.Ordinal) ||
            line.IndexOf(
                CompanionResultPrefix,
                CompanionResultPrefix.Length,
                StringComparison.Ordinal) >= 0)
        {
            return false;
        }

        var encodedPayload = line[CompanionResultPrefix.Length..];
        if (encodedPayload.Length % 4 != 0 ||
            encodedPayload.Any(character => !IsBase64Character(character)))
        {
            return false;
        }

        byte[] payload;
        try
        {
            payload = Convert.FromBase64String(encodedPayload);
        }
        catch (FormatException)
        {
            return false;
        }

        if (payload.Length is < 1 or > MaximumCompanionPayloadBytes ||
            !string.Equals(
                Convert.ToBase64String(payload),
                encodedPayload,
                StringComparison.Ordinal))
        {
            return false;
        }

        try
        {
            decodedOutput =
                JsonSerializer.Deserialize<PurviewCompanionOutput>(
                    payload,
                    CompanionJsonOptions)!;
            return decodedOutput is not null;
        }
        catch (JsonException)
        {
            return false;
        }
    }

    private static string RemoveOneTerminalLineEnding(string output)
    {
        if (output.EndsWith("\r\n", StringComparison.Ordinal))
        {
            return output[..^2];
        }

        return output.EndsWith('\n') ? output[..^1] : output;
    }

    private static bool IsBase64Character(char character) =>
        character is >= 'A' and <= 'Z' or
        >= 'a' and <= 'z' or
        >= '0' and <= '9' or
        '+' or
        '/' or
        '=';

    private bool ValidateCompanionOutput(PurviewCompanionOutput? output)
    {
        if (output is null ||
            output.OperationId != activeOperationId ||
            output.InventoryGenerationId == Guid.Empty ||
            companionLaunch is not null &&
            (output.OperationId != companionLaunch.OperationId ||
             output.InventoryGenerationId !=
                 companionLaunch.InventoryGenerationId ||
             output.InventoryExpiresAtUtc !=
                 companionLaunch.ExpiresAtUtc) ||
            output.TenantId != signedInTenantId ||
            output.AdministratorObjectId != signedInObjectId ||
            output.ObservedAtUtc.Offset != TimeSpan.Zero ||
            output.InventoryExpiresAtUtc.Offset != TimeSpan.Zero ||
            output.InventoryExpiresAtUtc <= DateTimeOffset.UtcNow ||
            output.InventoryExpiresAtUtc <= output.ObservedAtUtc ||
            output.InventoryExpiresAtUtc > output.ObservedAtUtc.AddMinutes(15) ||
            output.AuthorizedCapabilities is null ||
            !output.AuthorizedCapabilities.SequenceEqual(RequiredCompanionCapabilities) ||
            output.SensitiveInformationTypes is null ||
            output.SensitiveInformationTypes.Count is < 1 or > 2048)
        {
            return false;
        }

        var ids = new HashSet<Guid>();
        var names = new HashSet<string>(StringComparer.Ordinal);
        return output.SensitiveInformationTypes.All(item =>
            item is not null &&
            item.Id != Guid.Empty &&
            ids.Add(item.Id) &&
            IsBoundedCompanionText(item.ExactName, 255) &&
            names.Add(item.ExactName) &&
            IsBoundedCompanionText(item.Publisher, 200));
    }

    private static bool TryBuildCompanionCommand(
        PurviewCompanionLaunchDto? launch,
        out string command)
    {
        command = string.Empty;
        if (launch is null ||
            launch.OperationId == Guid.Empty ||
            launch.InventoryGenerationId == Guid.Empty ||
            launch.ExpiresAtUtc.Offset != TimeSpan.Zero ||
            launch.ExpiresAtUtc <= DateTimeOffset.UtcNow ||
            !string.Equals(
                launch.ScriptRelativePath,
                CompanionLaunchScriptRelativePath,
                StringComparison.Ordinal) ||
            launch.Arguments is null ||
            launch.Arguments.Count == 0 ||
            launch.Arguments.Any(argument =>
                !IsBoundedCompanionText(argument, 1_024)) ||
            !ContainsExactFileBinding(
                launch.Arguments,
                launch.ScriptRelativePath) ||
            !ContainsExactArgumentBinding(
                launch.Arguments,
                "-OperationId",
                launch.OperationId.ToString("D")) ||
            !ContainsExactArgumentBinding(
                launch.Arguments,
                "-InventoryGenerationId",
                launch.InventoryGenerationId.ToString("D")) ||
            !ContainsExactArgumentBinding(
                launch.Arguments,
                "-ExpiresAtUtc",
                launch.ExpiresAtUtc.ToString("O")))
        {
            return false;
        }

        var localArguments = launch.Arguments.ToArray();
        for (var index = 0; index + 1 < localArguments.Length; index++)
        {
            if (string.Equals(
                    localArguments[index],
                    "-File",
                    StringComparison.Ordinal))
            {
                localArguments[index + 1] = LocalCompanionScriptPath;
                break;
            }
        }

        command = "pwsh " + string.Join(
            " ",
            localArguments.Select(QuotePowerShellArgument));
        return command.Length <= 16_384;
    }

    private static bool ContainsExactFileBinding(
        IReadOnlyList<string> arguments,
        string scriptRelativePath)
    {
        var matchingFileBindings = 0;
        for (var index = 0; index + 1 < arguments.Count; index++)
        {
            if (string.Equals(
                    arguments[index],
                    "-File",
                    StringComparison.Ordinal))
            {
                matchingFileBindings++;
                if (!string.Equals(
                        arguments[index + 1],
                        scriptRelativePath,
                        StringComparison.Ordinal))
                {
                    return false;
                }
            }
        }

        return matchingFileBindings == 1;
    }

    private static bool ContainsExactArgumentBinding(
        IReadOnlyList<string> arguments,
        string name,
        string value)
    {
        var matches = 0;
        for (var index = 0; index + 1 < arguments.Count; index++)
        {
            if (string.Equals(arguments[index], name, StringComparison.Ordinal))
            {
                matches++;
                if (!string.Equals(
                        arguments[index + 1],
                        value,
                        StringComparison.Ordinal))
                {
                    return false;
                }
            }
        }

        return matches == 1;
    }

    private static string QuotePowerShellArgument(string value) =>
        $"'{value.Replace("'", "''", StringComparison.Ordinal)}'";

    private static bool IsBoundedCompanionText(string? value, int maximumLength) =>
        !string.IsNullOrWhiteSpace(value) &&
        value.Length <= maximumLength &&
        value.All(character => character > '\u001f' && character != '\u007f');

    private void RequestSettingsSave()
    {
        if (saving || settingsSaveOutcomeUnknown ||
            dialogKind != ConfirmationDialogKind.None ||
            !LimitsAreOrdered || !ProtectionDefaultsAreReady)
        {
            return;
        }

        settingsSaved = false;
        settingsSaveError = null;
        pendingSettingsSaveRequest = form?.ToRequest(Guid.NewGuid());
        dialogKind = ConfirmationDialogKind.SystemSettings;
    }

    private async Task SaveSettingsAsync()
    {
        if (form is null ||
            pendingSettingsSaveRequest is null ||
            !LimitsAreOrdered ||
            !ProtectionDefaultsAreReady ||
            saving)
        {
            return;
        }

        var request = pendingSettingsSaveRequest;
        saving = true;
        settingsSaveError = null;
        try
        {
            form = SettingsForm.From(
                await Api.UpdateSystemConfigAsync(
                    request,
                    cancellationToken: disposeCts.Token));
            settingsSaved = true;
            pendingSettingsSaveRequest = null;
            settingsSaveOutcomeUnknown = false;
            dialogKind = ConfirmationDialogKind.None;
        }
        catch (OperationCanceledException) when (disposeCts.IsCancellationRequested)
        {
        }
        catch (Exception exception)
        {
            settingsSaveError = UiErrorInfo.FromException(exception);
            if (request.IdempotencyKey is not null &&
                IsAmbiguousSettingsSaveFailure(exception))
            {
                settingsSaveOutcomeUnknown = true;
            }
            else
            {
                pendingSettingsSaveRequest = null;
                settingsSaveOutcomeUnknown = false;
            }
            dialogKind = ConfirmationDialogKind.None;
        }
        finally
        {
            saving = false;
        }
    }

    private Task RetryAmbiguousSettingsSaveAsync() =>
        settingsSaveOutcomeUnknown
            ? SaveSettingsAsync()
            : Task.CompletedTask;

    private static bool IsAmbiguousSettingsSaveFailure(Exception exception) =>
        exception is GatewayApiTransportException or GatewayApiProtocolException ||
        exception is GatewayApiException { IsTransient: true };

    private void CancelDialog()
    {
        if (dialogKind == ConfirmationDialogKind.SystemSettings &&
            !settingsSaveOutcomeUnknown)
        {
            pendingSettingsSaveRequest = null;
        }

        protectionReview?.Discard();
        protectionReview = null;
        pendingProfileId = null;
        dialogKind = ConfirmationDialogKind.None;
        pendingProtectionAction = ProtectionAction.None;
    }

    private void SetRole(ClaimsPrincipal user)
    {
        isAdministrator = user.IsInRole("Gateway.Administrator");
        var isOperator = user.IsInRole("Gateway.Operator");
        canReadProtectionGovernance = isAdministrator || isOperator;
        roleLabel = isOperator
            ? "Operator"
            : user.IsInRole("Gateway.Auditor")
                ? "Auditor"
                : user.IsInRole("Gateway.SupportReader")
                    ? "Support Reader"
                    : isAdministrator ? "Administrator" : "Gateway";

        var tenantClaim = user.FindFirst("tid")?.Value ??
            user.FindFirst("http://schemas.microsoft.com/identity/claims/tenantid")?.Value;
        _ = Guid.TryParse(tenantClaim, out signedInTenantId);
        var objectIdClaim = user.FindFirst("oid")?.Value ??
            user.FindFirst("http://schemas.microsoft.com/identity/claims/objectidentifier")?.Value;
        _ = Guid.TryParse(objectIdClaim, out signedInObjectId);
    }

    private ProtectionCapabilityDto? FindCapability(params string[] names) =>
        capabilitiesResource?.Value.Items.FirstOrDefault(item =>
            names.Any(name => string.Equals(item.Capability, name, StringComparison.OrdinalIgnoreCase)));

    private static bool CapabilityIsInstalled(ProtectionCapabilityDto? capability) =>
        string.Equals(capability?.Status, "Installed", StringComparison.OrdinalIgnoreCase);

    private static string CapabilityDisplayStatus(ProtectionCapabilityDto? capability) =>
        capability?.Status switch
        {
            "Installed" => "Installed",
            "PendingPropagation" => "Pending propagation",
            "Unavailable" or "NotInstalled" or null => "Unavailable",
            _ => "Unavailable"
        };

    private static string CapabilityExplanation(ProtectionCapabilityDto? capability) =>
        capability?.Status switch
        {
            "Installed" => "The Gateway reports that the shared deployment capability is installed.",
            "PendingPropagation" => "The deployment is waiting for Microsoft-side changes to become available.",
            _ => "The deployment does not currently offer this capability."
        };

    private string ProfileDisplayStatus(PurviewDlpProfileDto profile) =>
        profile.Readiness.IsReady ? "Ready" : profile.Status switch
        {
            "Pending" or "PendingPropagation" => "Pending propagation",
            "VerificationFailed" => "Failed",
            "Draft" or "ReviewRequired" => "Awaiting admin",
            _ => "Awaiting admin"
        };

    private static bool ProfileIsReady(PurviewDlpProfileDto profile) =>
        profile.Readiness.IsReady &&
        string.Equals(profile.Status, "Ready", StringComparison.OrdinalIgnoreCase);

    private static bool ProfileIsPending(PurviewDlpProfileDto profile) =>
        profile.Status is "Pending" or "PendingPropagation" ||
        profile.Readiness.Propagation is "Pending" ||
        profile.Readiness.TokenRoles is "PendingRefresh" ||
        profile.Readiness.RuntimeVerdict is "Pending";

    private static bool ProfileHasFailed(PurviewDlpProfileDto profile) =>
        profile.Status == "VerificationFailed" ||
        profile.Readiness.Readback is "Mismatch" or "Failed" or "Stale" ||
        profile.Readiness.Propagation == "Failed" ||
        profile.Readiness.TokenRoles is "MissingRequiredRoles" or "Failed" ||
        profile.Readiness.RuntimeVerdict == "Failed";

    private bool CanReconcile(PurviewDlpProfileDto profile) =>
        isAdministrator &&
        !protectionActionBusy &&
        ConnectionIsReady &&
        !string.IsNullOrWhiteSpace(profile.RowVersion);

    private bool CanValidateRuntime(PurviewDlpProfileDto profile) =>
        CanReconcile(profile) &&
        profile.Mode == "Enforce" &&
        profile.Readiness.Capability == "Installed" &&
        profile.Readiness.Readback == "Ready" &&
        profile.Readiness.Propagation == "Ready" &&
        profile.Readiness.TokenRoles == "Ready" &&
        !profile.Readiness.IsReady;

    private bool BlueprintAlreadyHasProfile(Guid blueprintApplicationId) =>
        profilesResource?.Value.Items.Any(profile =>
            profile.BlueprintApplicationId == blueprintApplicationId) == true;

    private string BlueprintName(Guid blueprintApplicationId)
    {
        var match = blueprints.FirstOrDefault(item =>
            item.BlueprintClientId == blueprintApplicationId);
        return match is null ? "Resolved blueprint" : SafeBlueprintName(match);
    }

    private static string SafeBlueprintName(AgentIdentityBlueprintSummaryDto blueprint) =>
        string.IsNullOrWhiteSpace(blueprint.DisplayName) ? "Unnamed blueprint" : blueprint.DisplayName.Trim();

    private static string SafeProfileName(PurviewDlpProfileDto profile) =>
        string.IsNullOrWhiteSpace(profile.DisplayName) ? "Unnamed DLP profile" : profile.DisplayName.Trim();

    private string IndexOfBlueprint(Guid blueprintApplicationId)
    {
        for (var index = 0; index < blueprints.Count; index++)
        {
            if (blueprints[index].BlueprintClientId == blueprintApplicationId)
            {
                return index.ToString();
            }
        }

        return string.Empty;
    }

    private string IndexOfSensitiveInformationType(Guid id, string exactName)
    {
        if (inventoryResource is null)
        {
            return string.Empty;
        }

        for (var index = 0; index < inventoryResource.Value.Items.Count; index++)
        {
            var item = inventoryResource.Value.Items[index];
            if (item.Id == id && string.Equals(item.ExactName, exactName, StringComparison.Ordinal))
            {
                return index.ToString();
            }
        }

        return string.Empty;
    }

    private static bool TryGetSelectedIndex<T>(
        string value,
        IReadOnlyList<T>? items,
        out int index)
    {
        if (items is not null &&
            int.TryParse(value, out index) &&
            index >= 0 &&
            index < items.Count)
        {
            return true;
        }

        index = -1;
        return false;
    }

    private static bool TryGetExpectedRowVersion(
        bool resourceWasLoaded,
        string? entityRowVersion,
        out string version)
    {
        if (!resourceWasLoaded)
        {
            version = string.Empty;
            return false;
        }

        version = string.IsNullOrWhiteSpace(entityRowVersion)
            ? "*"
            : entityRowVersion;
        return true;
    }

    private static bool ReviewMatchesAction(string operationType, ProtectionAction action) =>
        action switch
        {
            ProtectionAction.ConnectTenant or ProtectionAction.CompleteTenantConnection =>
                operationType == (
                    action == ProtectionAction.CompleteTenantConnection
                        ? "CompletePurviewTenantConnection"
                        : "ConnectPurviewTenant"),
            ProtectionAction.ConfigureKnowYourData =>
                operationType == "CreateOrUpdateKnowYourData",
            ProtectionAction.CreateProfile or ProtectionAction.UpdateProfile =>
                operationType == "CreateOrUpdateDlpProfile",
            ProtectionAction.ReconcileProfile =>
                operationType == "ReconcileDlpProfile",
            ProtectionAction.ValidateRuntime =>
                operationType == "ValidateDlpRuntime",
            _ => false
        };

    private bool ReviewBindingMatchesAction(
        ProtectionOperationReviewSummaryDto review,
        ProtectionAction action) =>
        action != ProtectionAction.CompleteTenantConnection ||
        review.SourceOperationId == activeOperationId &&
        review.InventoryGenerationId == companionInventoryGenerationId &&
        string.Equals(
            review.EvidenceDigest,
            companionEvidenceDigest,
            StringComparison.Ordinal);

    private static string FriendlyOperation(string? operationType) => operationType switch
    {
        "ConnectPurviewTenant" => "connect the Microsoft Purview tenant",
        "CompletePurviewTenantConnection" => "submit this exact companion result for verification",
        "CreateOrUpdateKnowYourData" => "create or update the fixed Know Your Data Group",
        "CreateOrUpdateDlpProfile" => "create or update the blueprint DLP profile",
        "ReconcileDlpProfile" => "reconcile the blueprint DLP profile",
        "ValidateDlpRuntime" => "run the approved runtime readiness check",
        _ => "this protection action"
    };

    private void ReadOperationFromLocation()
    {
        var query = Microsoft.AspNetCore.WebUtilities.QueryHelpers.ParseQuery(
            Navigation.ToAbsoluteUri(Navigation.Uri).Query);
        if (query.TryGetValue("operation", out var values) &&
            values.Count == 1 &&
            Guid.TryParse(values[0], out var operationId) &&
            operationId != Guid.Empty)
        {
            activeOperationId = operationId;
        }
    }

    private void PersistActiveOperationInLocation(Guid operationId)
    {
        var uri = Navigation.GetUriWithQueryParameter(
            "operation",
            operationId.ToString("D"));
        Navigation.NavigateTo(uri, replace: true);
    }

    private static string FriendlyScope(string scope) => scope switch
    {
        "Group" => "Fixed tenant-wide Group for Know Your Data",
        "Individual" => "One blueprint Individual location for DLP",
        _ => "Gateway-reviewed scope"
    };

    private static string FriendlyState(string value) => value switch
    {
        "Ready" => "Ready",
        "Pending" => "Pending propagation",
        "NotChecked" => "Awaiting admin",
        "VerificationFailed" or "Failed" or "Mismatch" or "Stale" => "Failed",
        _ => "Not connected"
    };

    private static string FormatMode(string? value) => value switch
    {
        "AuditOnly" => "Audit only",
        "Enforce" => "Enforce",
        _ => "Not configured"
    };

    private static string FormatActivities(IEnumerable<string> activities) =>
        string.Join(", ", activities.Select(activity => activity switch
        {
            "UploadText" or "uploadText" => "text sent to an agent",
            "DownloadText" or "downloadText" => "text returned from an agent",
            _ => "supported text activity"
        }).Distinct());

    private static string FormatActions(IEnumerable<PurviewDlpRuleActionDto> actions) =>
        string.Join(", ", actions.Select(action =>
            $"{(action.Activity is "DownloadText" or "downloadText" ? "Returned text" : "Sent text")}: " +
            (action.Action is "Block" or "block" ? "block when disallowed" : "audit")).Distinct());

    private static DateTime AsUtc(DateTime value) => value.Kind switch
    {
        DateTimeKind.Utc => value,
        DateTimeKind.Local => value.ToUniversalTime(),
        _ => DateTime.SpecifyKind(value, DateTimeKind.Utc)
    };

    private static string FormatLocal(DateTime value) =>
        AsUtc(value).ToLocalTime().ToString("MMM d, yyyy h:mm tt");

    private static string FormatLocal(DateTimeOffset value) =>
        value.ToLocalTime().ToString("MMM d, yyyy h:mm tt");

    public ValueTask DisposeAsync()
    {
        protectionReview?.Discard();
        disposeCts.Cancel();
        disposeCts.Dispose();
        return ValueTask.CompletedTask;
    }

