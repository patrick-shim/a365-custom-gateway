    private string TaskHref(string task, Guid? profileId = null, bool clearProfile = false)
    {
        var query = new Dictionary<string, string?>();
        if (activeOperationId is { } operationId)
            query["operation"] = operationId.ToString("D");
        if (!clearProfile && (profileId ?? requestedProfileId) is { } selectedProfile)
            query["profile"] = selectedProfile.ToString("D");
        return Microsoft.AspNetCore.WebUtilities.QueryHelpers.AddQueryString($"/settings/{task}", query);
    }
