    private async Task RunReviewAsync(
        ProtectionAction action,
        string targetLabel,
        Func<Task<GatewayApiResource<ProtectionOperationReviewTicket>>> reviewAction)
    {
        protectionActionBusy = true;
        protectionActionError = null;
        protectionAnnouncement = null;
        protectionReview?.Discard();
        protectionReview = null;
        try
        {
            var response = await reviewAction();
            if (!ReviewMatchesAction(response.Value.Review.OperationType, action))
            {
                response.Value.Discard();
                protectionActionError = new UiErrorInfo(
                    "The Gateway did not return a review for the requested action. Refresh the page and try again.");
                return;
            }
            if (!ReviewBindingMatchesAction(response.Value.Review, action))
            {
                response.Value.Discard();
                protectionActionError = new UiErrorInfo(
                    "The Gateway review did not match the exact operation or evidence binding. Refresh the page and start the review again.");
                return;
            }

            protectionReview = response.Value;
            pendingProtectionAction = action;
            pendingTargetLabel = targetLabel;
            dialogKind = ConfirmationDialogKind.ProtectionReview;
        }
        catch (OperationCanceledException) when (disposeCts.IsCancellationRequested)
        {
        }
        catch (Exception exception)
        {
            protectionActionError = UiErrorInfo.FromException(exception);
        }
        finally
        {
            protectionActionBusy = false;
        }
    }

