@page "/settings"
@rendermode InteractiveServer
@attribute [Authorize(Policy = "AllControlPlane")]
@implements IAsyncDisposable
@using System.ComponentModel.DataAnnotations
@using System.Security.Claims
@using System.Text
@using System.Text.Json
@using System.Text.Json.Serialization
@inject IGatewayApiClient Api
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject NavigationManager Navigation

<PageTitle>System settings · A365 Gateway</PageTitle>

<PageHeader Eyebrow="Administration"
            Title="System settings"
            Description="See what this Gateway can protect, complete the Microsoft Purview readiness journey, and manage registration defaults.">
    <Actions>
        <FluentButton Appearance="Appearance.Neutral"
                      OnClick="ReloadAllAsync"
                      Disabled="@(reloading || saving || protectionActionBusy)">
            @(reloading ? "Refreshing…" : "Refresh")
        </FluentButton>
    </Actions>
</PageHeader>

@if (roleLoaded && !isAdministrator)
{
    <div class="subtle-note role-notice" role="status">
        <strong>Read-only protection view.</strong>
        Your @roleLabel role can see the safe state returned by the Gateway. Only a Gateway Administrator can connect Microsoft Purview, confirm policy changes, run readiness checks, or change defaults.
    </div>
}

<section class="protection-section" aria-labelledby="protection-capabilities-heading">
    <div class="protection-section-heading">
        <div>
            <h2 id="protection-capabilities-heading">Protection capabilities</h2>
            <p>An installed shared capability is not the same as protection being enabled for an agent or ready at runtime. Each card keeps those facts separate.</p>
        </div>
    </div>

    @if (capabilitiesLoading && capabilitiesResource is null)
    {
        <div class="card">
            <LoadingState Label="Loading protection capabilities…" Detail="Reading deployment facts from the Gateway." />
        </div>
    }
    else if (capabilitiesError is not null && capabilitiesResource is null)
    {
        <ErrorState Title="Protection capabilities could not be loaded"
                    Message="@capabilitiesError.Message"
                    CorrelationId="@capabilitiesError.CorrelationId"
                    OnRetry="LoadCapabilitiesAsync" />
    }
    else
    {
        <div class="capability-grid">
            <article class="card capability-card" aria-labelledby="agent365-capability-heading">
                <div class="card-header">
                    <div>
                        <h2 id="agent365-capability-heading">Agent 365 registration beta</h2>
                        <span class="section-caption">Deployment-wide preview boundary</span>
                    </div>
                    <StatusPill Value="@CapabilityDisplayStatus(Agent365Capability)" />
                </div>
                <div class="card-body">
                    <p>This beta choice was fixed when the Gateway was deployed. It cannot be turned on or off from Settings.</p>
                    <dl class="capability-facts">
                        <div>
                            <dt>Installed capability</dt>
                            <dd>@CapabilityExplanation(Agent365Capability)</dd>
                        </div>
                        <div>
                            <dt>Per-agent use</dt>
                            <dd>Each registration still pauses for a signed-in Gateway Administrator to complete its own Agent 365 step.</dd>
                        </div>
                        <div>
                            <dt>Runtime state</dt>
                            <dd>The agent's provisioning page is authoritative. This card does not prove that a Microsoft resource exists.</dd>
                        </div>
                    </dl>
                </div>
            </article>

            <article class="card capability-card" aria-labelledby="prompt-capability-heading">
                <div class="card-header">
                    <div>
                        <h2 id="prompt-capability-heading">Prompt Shields</h2>
                        <span class="section-caption">Pre-model prompt protection</span>
                    </div>
                    <StatusPill Value="@PromptShieldRuntimeStatus" />
                </div>
                <div class="card-body">
                    <p>Prompt Shields checks a prompt before the external agent calls its model. An allowed check creates a short-lived, single-use receipt for the matching interaction.</p>
                    <dl class="capability-facts">
                        <div>
                            <dt>Installed capability</dt>
                            <dd><StatusPill Value="@CapabilityDisplayStatus(PromptShieldCapability)" /></dd>
                        </div>
                        <div>
                            <dt>Ready for agent use</dt>
                            <dd>@PromptShieldReadinessExplanation</dd>
                        </div>
                        <div>
                            <dt>Default</dt>
                            <dd>@PromptShieldDefaultExplanation</dd>
                        </div>
                    </dl>
                    <div class="capability-actions">
                        <FluentAnchor Appearance="Appearance.Stealth" Href="/agents">Open per-agent controls</FluentAnchor>
                    </div>
                </div>
            </article>

            <article class="card capability-card" aria-labelledby="purview-capability-heading">
                <div class="card-header">
                    <div>
                        <h2 id="purview-capability-heading">Microsoft Purview</h2>
                        <span class="section-caption">Tenant setup and blueprint-specific runtime protection</span>
                    </div>
                    <StatusPill Value="@PurviewJourneyStatus" />
                </div>
                <div class="card-body">
                    <p>Bootstrap can prepare Purview prerequisites. Settings must still connect the tenant, review separate policy scopes, wait for propagation, and prove runtime readiness.</p>
                    <dl class="capability-facts">
                        <div>
                            <dt>Installed prerequisites</dt>
                            <dd><StatusPill Value="@CapabilityDisplayStatus(PurviewCapability)" /></dd>
                        </div>
                        <div>
                            <dt>Tenant connection</dt>
                            <dd><StatusPill Value="@(canReadProtectionGovernance ? ConnectionDisplayStatus : "Restricted")" /></dd>
                        </div>
                        <div>
                            <dt>Ready DLP profiles</dt>
                            <dd>@(canReadProtectionGovernance ? $"{ReadyProfileCount} profile{(ReadyProfileCount == 1 ? string.Empty : "s")}" : "Restricted for this role")</dd>
                        </div>
                    </dl>
                    <p class="subtle-note">Know Your Data uses one fixed tenant-wide Group. DLP uses one Individual location for each blueprint. The Gateway never merges those scopes.</p>
                </div>
            </article>
        </div>
    }
</section>

<section class="card protection-section" aria-labelledby="purview-journey-heading">
    <div class="card-header">
        <div>
            <h2 id="purview-journey-heading">Microsoft Purview readiness journey</h2>
            <span class="section-caption">Complete each explicit step. Nothing on this page silently authors or broadens policy.</span>
        </div>
    </div>

    @if (!canReadProtectionGovernance)
    {
        <div class="card-body">
            <div class="subtle-note restricted-state" role="status">
                <strong>Governance details are restricted for this role.</strong>
                The Gateway exposes shared capability state here, but tenant connection, sensitive information inventory, Know Your Data, and blueprint DLP profile details are available only to Gateway Administrators and Operators. This does not mean they are absent or not connected.
            </div>
            @if (operationLoading && ActiveOperation is null)
            {
                <LoadingState Label="Loading the requested protection operation…" />
            }
            else if (operationError is not null)
            {
                <ErrorState Title="Protection operation progress could not be loaded"
                            Message="@operationError.Message"
                            CorrelationId="@operationError.CorrelationId"
                            OnRetry="LoadActiveOperationAsync" />
            }
            else if (ActiveOperation is not null)
            {
                <ProtectionOperationTimeline Operation="ActiveOperation" />
            }
        </div>
    }
    else if (connectionLoading && connectionResource is null)
    {
        <LoadingState Label="Loading the Microsoft Purview journey…" Detail="Checking the persisted Gateway connection and configuration." />
    }
    else if (connectionError is not null && connectionResource is null)
    {
        <div class="card-body">
            <ErrorState Title="Microsoft Purview connection state could not be loaded"
                        Message="@connectionError.Message"
                        CorrelationId="@connectionError.CorrelationId"
                        OnRetry="LoadProtectionJourneyAsync" />
        </div>
    }
    else
    {
        <div class="card-body stack">
            @if (protectionActionError is not null)
            {
                <ErrorState Title="The protection action was not completed"
                            Message="@protectionActionError.Message"
                            CorrelationId="@protectionActionError.CorrelationId" />
            }
            @if (!string.IsNullOrWhiteSpace(protectionAnnouncement))
            {
                <div class="success-banner" role="status" aria-live="polite">@protectionAnnouncement</div>
            }

            <div class="journey-grid">
                <article class="journey-card" aria-labelledby="purview-prerequisites-heading">
                    <span class="journey-step" aria-hidden="true">1</span>
                    <h3 id="purview-prerequisites-heading">Check shared prerequisites</h3>
                    <p>The Gateway reports whether the deployment prepared the shared Purview identities, permissions, and secure certificate path. Installed does not mean a tenant policy or runtime check is Ready.</p>
                    <StatusPill Value="@CapabilityDisplayStatus(PurviewCapability)" />
                </article>

                <article class="journey-card" aria-labelledby="purview-connection-heading">
                    <span class="journey-step" aria-hidden="true">2</span>
                    <h3 id="purview-connection-heading">Connect the tenant</h3>
                    <p>A Gateway Administrator starts a short-lived operation for the signed-in tenant. On Windows, the Gateway-provided companion opens the official Microsoft sign-in and returns only bounded facts—never tokens or provider output.</p>
                    <StatusPill Value="@ConnectionDisplayStatus" />
                    @if (Connection is { } connection)
                    {
                        <div class="inventory-meta">
                            @if (connection.LastVerifiedAtUtc is { } verified)
                            {
                                <span>Last checked <time datetime="@AsUtc(verified).ToString("O")">@FormatLocal(verified)</time></span>
                            }
                            @if (connection.ExpiresAtUtc is { } expires)
                            {
                                <span>Connection review expires <time datetime="@AsUtc(expires).ToString("O")">@FormatLocal(expires)</time></span>
                            }
                        </div>
                    }
                    <div class="journey-actions">
                        @if (isAdministrator)
                        {
                            <FluentButton Appearance="Appearance.Neutral"
                                          OnClick="ReviewConnectionAsync"
                                          Disabled="@(!CanReviewConnection)">
                                @(Connection is null ? "Review tenant connection" : "Review connection refresh")
                            </FluentButton>
                        }
                    </div>
                    @if (Connection?.Status == "AwaitingAdministrator" ||
                        RequiresCompanionCompletion)
                    {
                        <div class="deployment-callout connection-guidance" role="status">
                            <strong>Finish on Windows.</strong>
                            <span>Use the exact Gateway companion command for this operation. Its result starts independent Gateway verification; it does not make the connection Ready.</span>
                        </div>
                        @if (companionLaunch is { } launch && CompanionCommand is { } command)
                        {
                            <div class="companion-download">
                                <a class="text-link"
                                   href="@CompanionDownloadHref"
                                   download="@CompanionDownloadName">
                                    Download the Windows Purview companion
                                </a>
                                <p>This exact script comes from the immutable deployed Admin UI image. Downloading it never runs it. Keep the shown filename so the command below uses the local file you downloaded.</p>
                            </div>
                            <ol class="windows-companion-steps">
                                <li>On a Windows computer, download the companion above. Do not open or auto-run it from the browser.</li>
                                <li>Open PowerShell 7 in the folder where <code>@CompanionDownloadName</code> was saved.</li>
                                <li>Copy and run the command below before <time datetime="@launch.ExpiresAtUtc.ToString("O")">@FormatLocal(launch.ExpiresAtUtc)</time>.</li>
                                <li>Complete the official Microsoft sign-in with the intended tenant administrator.</li>
                                <li>Save only the single line beginning <code>A365GW_CONNECTION_RESULT:</code> to a text file, then choose that file below.</li>
                            </ol>
                            <CopyableCommand Command="@command" />
                        }
                        else
                        {
                            <div class="subtle-note connection-guidance">
                                <strong>A fresh launch command is not available in this browser.</strong>
                                Review and start a new tenant connection operation to receive an exact, short-lived command from the Gateway.
                            </div>
                        }
                        @if (isAdministrator && activeOperationId is not null)
                        {
                            <div class="form-field connection-guidance">
                                <label for="purview-companion-evidence">Gateway companion output</label>
                                <InputFile id="purview-companion-evidence"
                                           OnChange="ReadCompanionEvidenceAsync"
                                           accept=".txt,text/plain"
                                           aria-describedby="purview-companion-evidence-help" />
                                <span id="purview-companion-evidence-help" class="field-help">Choose the fresh text output saved from the Gateway-provided companion for this exact tenant and operation. It must contain only the companion's single prefixed result line. The portal never accepts handcrafted JSON and never stores the file.</span>
                                @if (!string.IsNullOrWhiteSpace(companionEvidenceError))
                                {
                                    <span class="inline-validation" role="alert">@companionEvidenceError</span>
                                }
                                else if (companionEvidence is not null)
                                {
                                    <span class="field-help" role="status">Evidence checked for this tenant. @companionEvidence.SensitiveInformationTypes.Count current sensitive information type@(companionEvidence.SensitiveInformationTypes.Count == 1 ? string.Empty : "s") will be reviewed.</span>
                                }
                            </div>
                            <div class="journey-actions">
                                <FluentButton Appearance="Appearance.Accent"
                                              OnClick="ReviewCompanionCompletionAsync"
                                              Disabled="@(!CanReviewCompanionCompletion)">
                                    Review companion completion
                                </FluentButton>
                            </div>
                        }
                    }
                </article>

                <article class="journey-card" aria-labelledby="purview-inventory-heading">
                    <span class="journey-step" aria-hidden="true">3</span>
                    <h3 id="purview-inventory-heading">Choose current sensitive information</h3>
                    <p>The list comes from the connected tenant. There is deliberately no default. Choose the exact named item for the operation you are reviewing.</p>
                    @if (!ConnectionIsReady)
                    {
                        <div class="subtle-note">Connect the tenant before loading its sensitive information types.</div>
                    }
                    else if (inventoryLoading)
                    {
                        <LoadingState Label="Loading sensitive information types…" />
                    }
                    else if (inventoryError is not null)
                    {
                        <ErrorState Title="The current tenant inventory could not be loaded"
                                    Message="@inventoryError.Message"
                                    CorrelationId="@inventoryError.CorrelationId"
                                    OnRetry="LoadInventoryAsync" />
                    }
                    else if (inventoryResource?.Value.Items.Count is 0)
                    {
                        <EmptyState Icon="◇"
                                    Title="No sensitive information types returned"
                                    Description="The Gateway received an empty current inventory. Refresh the tenant connection or ask a Purview administrator to check the tenant." />
                    }
                    else if (!isAdministrator)
                    {
                        <div class="subtle-note restricted-state" role="status">
                            <strong>Inventory selection is restricted.</strong>
                            Operators can monitor safe governance status, but only a Gateway Administrator can load or select the current tenant inventory.
                        </div>
                    }
                    else if (inventoryResource is not null)
                    {
                        <div class="form-field">
                            <label for="purview-sensitive-information-type">Sensitive information type</label>
                            <select id="purview-sensitive-information-type"
                                    class="form-control"
                                    value="@selectedSitIndex"
                                    @onchange="SelectSensitiveInformationType"
                                    disabled="@inventoryResource.Value.IsExpired"
                                    aria-describedby="purview-sensitive-information-type-help">
                                <option value="">Choose a current tenant item</option>
                                @for (var index = 0; index < inventoryResource.Value.Items.Count; index++)
                                {
                                    var item = inventoryResource.Value.Items[index];
                                    <option value="@index">@item.ExactName — @item.Publisher</option>
                                }
                            </select>
                            <span id="purview-sensitive-information-type-help" class="field-help">The Gateway keeps the selected tenant identity internally and shows only its exact name and publisher here.</span>
                        </div>
                        <div class="inventory-meta">
                            <span>Loaded <time datetime="@AsUtc(inventoryResource.Value.RetrievedAtUtc).ToString("O")">@FormatLocal(inventoryResource.Value.RetrievedAtUtc)</time></span>
                            <span>Expires <time datetime="@AsUtc(inventoryResource.Value.ExpiresAtUtc).ToString("O")">@FormatLocal(inventoryResource.Value.ExpiresAtUtc)</time></span>
                            <StatusPill Value="@(inventoryResource.Value.IsExpired ? "Failed" : "Ready")" />
                        </div>
                        <div class="journey-actions">
                            <FluentButton Appearance="Appearance.Stealth"
                                          OnClick="LoadInventoryAsync"
                                          Disabled="@inventoryLoading">Reload inventory</FluentButton>
                        </div>
                    }
                </article>

                <article class="journey-card" aria-labelledby="purview-kyd-heading">
                    <span class="journey-step" aria-hidden="true">4</span>
                    <h3 id="purview-kyd-heading">Review tenant-wide Know Your Data</h3>
                    <p>This is one separate, fixed enterprise AI applications Group for the tenant. It is not a blueprint list and is not the DLP profile below.</p>
                    <StatusPill Value="@KnowYourDataDisplayStatus" />
                    @if (knowYourDataError is not null)
                    {
                        <ErrorState Title="Know Your Data state could not be loaded"
                                    Message="@knowYourDataError.Message"
                                    CorrelationId="@knowYourDataError.CorrelationId"
                                    OnRetry="LoadKnowYourDataAsync" />
                    }
                    else if (KnowYourData is { } knowYourData)
                    {
                        <p class="profile-summary">Current reviewed item: @knowYourData.SensitiveInformationTypeName. Mode: @FormatMode(knowYourData.Mode). Exact readback: @FriendlyState(knowYourData.ReadbackStatus).</p>
                    }
                    @if (isAdministrator)
                    {
                        <div class="form-field">
                            <label for="kyd-mode">Collection mode</label>
                            <select id="kyd-mode" class="form-control" @bind="kydMode">
                                <option value="AuditOnly">Audit only</option>
                                <option value="Enforce">Enforce</option>
                            </select>
                            <span class="field-help">The review covers text sent to and returned from agents. Returned text may be processed after the interaction and is not claimed as response-side blocking.</span>
                        </div>
                        <div class="journey-actions">
                            <FluentButton Appearance="Appearance.Neutral"
                                          OnClick="ReviewKnowYourDataAsync"
                                          Disabled="@(!CanReviewKnowYourData)">
                                Review fixed Know Your Data change
                            </FluentButton>
                        </div>
                    }
                </article>
            </div>

            <section aria-labelledby="dlp-profile-form-heading">
                <div class="protection-section-heading">
                    <div>
                        <h2 id="dlp-profile-form-heading">Blueprint DLP profiles</h2>
                        <p>Each profile belongs to exactly one resolved blueprint and its Individual scope. New blueprints finish core registration first; policy setup happens here afterward.</p>
                    </div>
                </div>

                @if (profilesLoading && profilesResource is null)
                {
                    <LoadingState Label="Loading blueprint DLP profiles…" />
                }
                else if (profilesError is not null && profilesResource is null)
                {
                    <ErrorState Title="Blueprint DLP profiles could not be loaded"
                                Message="@profilesError.Message"
                                CorrelationId="@profilesError.CorrelationId"
                                OnRetry="LoadProfilesAsync" />
                }
                else
                {
                    @if (profilesResource?.Value.Items.Count is 0)
                    {
                        <EmptyState Icon="◇"
                                    Title="No blueprint DLP profiles yet"
                                    Description="Core registration remains available. After a blueprint resolves, a Gateway Administrator can review its first DLP profile here." />
                    }
                    else if (profilesResource is not null)
                    {
                        <div class="profile-grid">
                            @foreach (var profile in profilesResource.Value.Items.OrderBy(item => item.DisplayName, StringComparer.OrdinalIgnoreCase))
                            {
                                <article class="profile-card">
                                    <div class="profile-card-header">
                                        <div>
                                            <h3>@SafeProfileName(profile)</h3>
                                            <span class="section-caption">@BlueprintName(profile.BlueprintApplicationId) · @FormatMode(profile.Mode)</span>
                                        </div>
                                        <StatusPill Value="@ProfileDisplayStatus(profile)" />
                                    </div>
                                    <p class="profile-summary">Sensitive information: @profile.SensitiveInformationTypeName. This profile is separate from the tenant-wide Know Your Data Group.</p>
                                    <ProtectionReadinessPanel Readiness="profile.Readiness" Label="@SafeProfileName(profile)" />
                                    @if (profile.Mode == "AuditOnly")
                                    {
                                        <p class="profile-summary">Audit-only profiles cannot complete the allow and block runtime check. Review settings and choose Enforce uploads before checking runtime readiness.</p>
                                    }
                                    @if (isAdministrator)
                                    {
                                        <div class="journey-actions">
                                            <FluentButton Appearance="Appearance.Stealth"
                                                          OnClick="@(() => EditProfile(profile))"
                                                          Disabled="@protectionActionBusy">Review settings</FluentButton>
                                            <FluentButton Appearance="Appearance.Stealth"
                                                          OnClick="@(() => ReviewExistingProfileActionAsync(profile, ProtectionAction.ReconcileProfile))"
                                                          Disabled="@(!CanReconcile(profile))">Review reconcile</FluentButton>
                                            <FluentButton Appearance="Appearance.Neutral"
                                                          OnClick="@(() => ReviewExistingProfileActionAsync(profile, ProtectionAction.ValidateRuntime))"
                                                          Disabled="@(!CanValidateRuntime(profile))">Review runtime check</FluentButton>
                                        </div>
                                    }
                                </article>
                            }
                        </div>
                    }

                    @if (isAdministrator)
                    {
                        <section class="journey-card settings-block" aria-labelledby="dlp-review-form-heading">
                            <h3 id="dlp-review-form-heading">@(editingProfile is null ? "Review a new blueprint profile" : $"Review changes to {SafeProfileName(editingProfile)}")</h3>
                            <p>Choose one resolved blueprint and the current tenant item. The confirmation panel will show the high-level scope, activities, and outcome before anything is queued.</p>
                            @if (blueprintsLoading)
                            {
                                <LoadingState Label="Loading resolved blueprints…" />
                            }
                            else if (blueprintsError is not null)
                            {
                                <ErrorState Title="Resolved blueprints could not be loaded"
                                            Message="@blueprintsError.Message"
                                            CorrelationId="@blueprintsError.CorrelationId"
                                            OnRetry="LoadBlueprintsAsync" />
                            }
                            else
                            {
                                <div class="form-grid">
                                    <div class="form-field">
                                        <label for="dlp-blueprint">Resolved blueprint</label>
                                        <select id="dlp-blueprint"
                                                class="form-control"
                                                value="@selectedBlueprintIndex"
                                                @onchange="SelectBlueprint"
                                                disabled="@(editingProfile is not null)">
                                            <option value="">Choose one blueprint</option>
                                            @for (var index = 0; index < blueprints.Count; index++)
                                            {
                                                <option value="@index">@SafeBlueprintName(blueprints[index])</option>
                                            }
                                        </select>
                                    </div>
                                    <div class="form-field">
                                        <label for="dlp-display-name">Profile name</label>
                                        <input id="dlp-display-name"
                                               class="form-control"
                                               maxlength="120"
                                               autocomplete="off"
                                               @bind="dlpDisplayName" />
                                    </div>
                                    <div class="form-field">
                                        <label for="dlp-mode">Policy mode</label>
                                        <select id="dlp-mode" class="form-control" @bind="dlpMode">
                                            <option value="AuditOnly">Audit only</option>
                                            <option value="Enforce">Enforce uploads</option>
                                        </select>
                                        <small>Audit only evaluates the upload rule without enforcement. Enforce uploads is required for the allow and block runtime check.</small>
                                    </div>
                                    <div class="form-field">
                                        <span class="detail-label">Sensitive information</span>
                                        <span class="detail-value">@(SelectedSensitiveInformationType?.ExactName ?? "Choose a current tenant item above")</span>
                                    </div>
                                </div>
                                <div class="journey-actions">
                                    @if (editingProfile is not null)
                                    {
                                        <FluentButton Appearance="Appearance.Stealth" OnClick="ClearProfileEditor">Cancel edit</FluentButton>
                                    }
                                    <FluentButton Appearance="Appearance.Accent"
                                                  OnClick="ReviewDlpProfileAsync"
                                                  Disabled="@(!CanReviewDlpProfile)">
                                        @(editingProfile is null ? "Review new profile" : "Review profile update")
                                    </FluentButton>
                                </div>
                            }
                        </section>
                    }
                }
            </section>

            @if (operationLoading && ActiveOperation is null)
            {
                <LoadingState Label="Loading protection operation…" />
            }
            else if (operationError is not null)
            {
                <ErrorState Title="Protection operation progress could not be loaded"
                            Message="@operationError.Message"
                            CorrelationId="@operationError.CorrelationId"
                            OnRetry="LoadActiveOperationAsync" />
            }
            else if (ActiveOperation is not null)
            {
                <ProtectionOperationTimeline Operation="ActiveOperation" />
                <div class="journey-actions">
                    <FluentButton Appearance="Appearance.Neutral"
                                  OnClick="LoadActiveOperationAsync"
                                  Disabled="@operationLoading">Refresh operation</FluentButton>
                </div>
            }
        </div>
    }
</section>

@if (isAdministrator)
{
    @if (settingsLoading && form is null)
    {
        <div class="card settings-block">
            <LoadingState Label="Loading system defaults…" Detail="Reading registration defaults and operational limits." />
        </div>
    }
    else if (settingsLoadError is not null && form is null)
    {
        <div class="settings-block">
            <ErrorState Title="System defaults could not be loaded"
                        Message="@settingsLoadError.Message"
                        CorrelationId="@settingsLoadError.CorrelationId"
                        OnRetry="LoadSettingsAsync" />
        </div>
    }
    else if (form is not null)
    {
        <EditForm Model="form" OnValidSubmit="RequestSettingsSave" class="card form-card settings-form settings-block">
            <DataAnnotationsValidator />
            <ValidationSummary />

            @if (settingsSaveError is not null)
            {
                <div class="form-section">
                    <ErrorState Message="@settingsSaveError.Message" CorrelationId="@settingsSaveError.CorrelationId" />
                </div>
            }
            @if (settingsSaveOutcomeUnknown)
            {
                <div class="form-section">
                    <div class="deployment-callout ambiguous-save-recovery" role="alert">
                        <strong>The save result is not yet known.</strong>
                        <span>The Gateway may already have accepted this exact change. Do not create a new save. Retry the same protected request, or reload the current server settings before making another change.</span>
                        <div class="journey-actions">
                            <FluentButton Appearance="Appearance.Accent"
                                          OnClick="RetryAmbiguousSettingsSaveAsync"
                                          Disabled="@(saving || settingsLoading)">
                                Retry the same save
                            </FluentButton>
                            <FluentButton Appearance="Appearance.Neutral"
                                          OnClick="LoadSettingsAsync"
                                          Disabled="@(saving || settingsLoading)">
                                Reload current settings
                            </FluentButton>
                        </div>
                    </div>
                </div>
            }
            @if (settingsLoadError is not null)
            {
                <div class="form-section">
                    <ErrorState Title="The latest system defaults could not be loaded"
                                Message="@settingsLoadError.Message"
                                CorrelationId="@settingsLoadError.CorrelationId"
                                OnRetry="LoadSettingsAsync" />
                </div>
            }
            @if (settingsSaved)
            {
                <div class="success-banner" role="status"><strong>Settings saved.</strong> The control plane accepted the updated configuration.</div>
            }

            <section class="form-section" aria-labelledby="defaults-heading">
                <h2 id="defaults-heading">Registration defaults</h2>
                <p>Applied to new agent registrations unless the registration supplies an explicit supported choice. A protection default can be enabled only while the server reports its required readiness.</p>
                <div class="form-grid">
                    <fieldset class="feature-group full" aria-describedby="default-observability-help">
                        <legend>Activity observability defaults</legend>
                        <p id="default-observability-help">New agents use these independent destinations. Gateway platform health, security, and operational diagnostics remain configured separately.</p>
                        <div class="form-grid">
                            <div class="form-field checkbox-field">
                                <label class="checkbox-label" for="default-agent365-observability-enabled">
                                    <InputCheckbox id="default-agent365-observability-enabled" @bind-Value="form.DefaultAgent365ObservabilityEnabled" />
                                    <span><strong>Agent 365 observability by default</strong><small>Send supported sanitized activity telemetry to Microsoft Agent 365.</small></span>
                                </label>
                            </div>
                            <div class="form-field checkbox-field">
                                <label class="checkbox-label" for="default-azure-monitor-export-enabled">
                                    <InputCheckbox id="default-azure-monitor-export-enabled" @bind-Value="form.DefaultAzureMonitorExportEnabled" />
                                    <span><strong>Also mirror sanitized activity telemetry to Azure Monitor</strong><small>Use Azure Monitor as an optional second destination for new agents.</small></span>
                                </label>
                            </div>
                        </div>
                    </fieldset>

                    <fieldset class="feature-group full" aria-describedby="default-prompt-shield-help">
                        <legend>Prompt Shields default</legend>
                        <p id="default-prompt-shield-help">New registrations can evaluate prompts before model invocation only when the shared capability is installed and the Gateway reports it available.</p>
                        <div class="form-field checkbox-field">
                            <label class="checkbox-label" for="default-prompt-shield-enabled">
                                <InputCheckbox id="default-prompt-shield-enabled"
                                               @bind-Value="form.DefaultPromptShieldEnabled"
                                               disabled="@(!CanChangePromptShieldDefault)" />
                                <span><strong>Enable Prompt Shields by default</strong><small>Each agent can still be changed separately. Protected clients must use the allowed single-use receipt.</small></span>
                            </label>
                            @if (!PromptShieldReady)
                            {
                                <span class="field-help">Unavailable for a new default until both the installed capability and server readiness check pass. A stored enabled value can be turned off.</span>
                            }
                        </div>
                    </fieldset>

                    <fieldset class="feature-group full" aria-describedby="default-purview-help">
                        <legend>Microsoft Purview defaults</legend>
                        <p id="default-purview-help">A default never creates policy. A registration can use Purview only when its exact blueprint has a Ready DLP profile.</p>
                        <div class="form-grid">
                            <div class="form-field checkbox-field">
                                <label class="checkbox-label" for="default-purview-enabled">
                                    <InputCheckbox id="default-purview-enabled"
                                                   @bind-Value="form.DefaultPurviewEnabled"
                                                   disabled="@(!CanChangePurviewDefault)" />
                                    <span><strong>Offer Purview by default</strong><small>The registration page still requires an exact Ready profile for the selected blueprint.</small></span>
                                </label>
                                @if (!HasReadyProfile)
                                {
                                    <span class="field-help">Unavailable for a new default until at least one blueprint profile is Ready. A stored enabled value can be turned off.</span>
                                }
                            </div>
                            <div class="form-field">
                                <label for="default-purview-mode">Default Purview mode</label>
                                <InputSelect id="default-purview-mode"
                                             class="form-control"
                                             @bind-Value="form.DefaultPurviewMode"
                                             disabled="@(!form.DefaultPurviewEnabled || !HasReadyProfile)">
                                    <option value="AuditOnly">Audit only</option>
                                    <option value="Enforce">Enforce</option>
                                </InputSelect>
                            </div>
                        </div>
                    </fieldset>
                </div>
            </section>

            <section class="form-section" aria-labelledby="retention-heading">
                <h2 id="retention-heading">Idempotency lifetime</h2>
                <p>The Gateway applies this lifetime when it creates an idempotency record. Other persisted compatibility retention values do not have a cleanup worker and are not editable.</p>
                <div class="form-grid">
                    <NumberField Id="retention-idempotency" Label="Idempotency records (days)" @bind-Value="form.RetentionDaysIdempotencyRecords" />
                </div>
            </section>

            <section class="form-section" aria-labelledby="limits-heading">
                <h2 id="limits-heading">Ingress rate limits <span class="optional-label">Requests per minute</span></h2>
                <p>The Gateway enforces fixed one-minute limits in SQL across every API replica. Credential limits isolate a single key, registration limits aggregate rotated keys for one agent, and the global limit protects shared capacity.</p>
                <div class="form-grid form-grid-three">
                    <NumberField Id="limit-client" Label="Per credential" @bind-Value="form.RateLimitPerClient" />
                    <NumberField Id="limit-agent" Label="Per registration" @bind-Value="form.RateLimitPerAgent" />
                    <NumberField Id="limit-global" Label="Global" @bind-Value="form.RateLimitGlobal" />
                </div>
                @if (!LimitsAreOrdered)
                {
                    <p class="inline-validation" role="alert">The global limit must be at least as large as each scoped limit.</p>
                }
                @if (!ProtectionDefaultsAreReady)
                {
                    <p class="inline-validation" role="alert">Turn off any unavailable protection default, or finish its readiness steps, before saving.</p>
                }
            </section>

            <div class="form-actions">
                <FluentButton Appearance="Appearance.Neutral"
                              OnClick="LoadSettingsAsync"
                              Disabled="@(settingsLoading || saving || settingsSaveOutcomeUnknown)">Discard changes</FluentButton>
                <FluentButton Type="ButtonType.Submit"
                              Appearance="Appearance.Accent"
                              Disabled="@(saving || settingsSaveOutcomeUnknown || !LimitsAreOrdered || !ProtectionDefaultsAreReady)">Review and save</FluentButton>
            </div>
        </EditForm>
    }
}

<ConfirmPanel Visible="@(dialogKind != ConfirmationDialogKind.None)"
              Busy="@(saving || protectionActionBusy)"
              Title="@ConfirmationTitle"
              Message="@ConfirmationMessage"
              ConfirmLabel="@ConfirmationButtonLabel"
              OnConfirm="ConfirmDialogAsync"
              OnCancel="CancelDialog">
    <AdditionalContent>
        @if (dialogKind == ConfirmationDialogKind.SystemSettings)
        {
            <div class="subtle-note">The update is audited by the control plane. Existing registrations and in-flight operations are not reconfigured or restarted by this page.</div>
        }
        else if (protectionReview is { } review)
        {
            <dl class="review-summary">
                <div><dt>Action</dt><dd>@FriendlyOperation(review.Review.OperationType)</dd></div>
                <div><dt>Tenant ID</dt><dd><code>@review.Review.TenantId.ToString("D")</code></dd></div>
                <div><dt>Target</dt><dd>@PendingTargetLabel</dd></div>
                <div><dt>Target binding</dt><dd>@review.Review.TargetType <code>@review.Review.TargetIdentifier</code></dd></div>
                <div><dt>Scope</dt><dd>@FriendlyScope(review.Review.ScopeType)</dd></div>
                @if (review.Review.BlueprintApplicationId is { } blueprintApplicationId)
                {
                    <div><dt>Blueprint application ID</dt><dd><code>@blueprintApplicationId.ToString("D")</code></dd></div>
                }
                @if (!string.IsNullOrWhiteSpace(review.Review.SensitiveInformationTypeName))
                {
                    <div><dt>Sensitive information</dt><dd>@review.Review.SensitiveInformationTypeName</dd></div>
                }
                @if (review.Review.SensitiveInformationTypeId is { } sensitiveInformationTypeId)
                {
                    <div><dt>Sensitive information type ID</dt><dd><code>@sensitiveInformationTypeId.ToString("D")</code></dd></div>
                }
                @if (review.Review.SourceOperationId is { } sourceOperationId)
                {
                    <div><dt>Source operation ID</dt><dd><code>@sourceOperationId.ToString("D")</code></dd></div>
                }
                @if (review.Review.InventoryGenerationId is { } inventoryGenerationId)
                {
                    <div><dt>Inventory generation ID</dt><dd><code>@inventoryGenerationId.ToString("D")</code></dd></div>
                }
                @if (!string.IsNullOrWhiteSpace(review.Review.EvidenceDigest))
                {
                    <div><dt>Evidence digest</dt><dd><code>@review.Review.EvidenceDigest</code></dd></div>
                }
                @if (!string.IsNullOrWhiteSpace(review.Review.Mode))
                {
                    <div><dt>Mode</dt><dd>@FormatMode(review.Review.Mode)</dd></div>
                }
                @if (review.Review.Activities.Count > 0)
                {
                    <div><dt>Activities</dt><dd>@FormatActivities(review.Review.Activities)</dd></div>
                }
                @if (review.Review.Actions.Count > 0)
                {
                    <div><dt>Outcomes</dt><dd>@FormatActions(review.Review.Actions)</dd></div>
                }
            </dl>
            <div class="subtle-note">@review.Review.ReadinessDisclaimer</div>
            <p class="field-help">This short review expires at <time datetime="@AsUtc(review.ExpiresAtUtc).ToString("O")">@FormatLocal(review.ExpiresAtUtc)</time>. Confirmation queues only this reviewed action.</p>
        }
    </AdditionalContent>
</ConfirmPanel>

@code {
    private static readonly string[] PurviewActivities = ["UploadText", "DownloadText"];
    private static readonly string[] RequiredCompanionCapabilities =
    [
        "DlpPolicy.ReadWrite",
        "DlpRule.ReadWrite",
        "KnowYourData.ReadWrite",
        "SensitiveInformationTypes.Read"
    ];
    private static readonly JsonSerializerOptions CompanionJsonOptions = new()
    {
        PropertyNamingPolicy = JsonNamingPolicy.CamelCase,
        PropertyNameCaseInsensitive = false,
        UnmappedMemberHandling = JsonUnmappedMemberHandling.Disallow
    };
    private static readonly UTF8Encoding StrictUtf8 = new(
        encoderShouldEmitUTF8Identifier: false,
        throwOnInvalidBytes: true);
    private const long MaximumCompanionEvidenceBytes = 512 * 1024;
    private const int MaximumCompanionPayloadBytes = 384 * 1024;
    private const string CompanionResultPrefix = "A365GW_CONNECTION_RESULT:";
    private const string CompanionDownloadName = "Connect-PurviewTenant.ps1";
    private const string CompanionDownloadHref =
        "/downloads/Connect-PurviewTenant.ps1";
    private const string CompanionLaunchScriptRelativePath =
        "Automation/Connect-PurviewTenant.ps1";
    private const string LocalCompanionScriptPath =
        @".\Connect-PurviewTenant.ps1";
    private const string CompletePurviewTenantConnectionAction =
        "CompletePurviewTenantConnection";
    private readonly CancellationTokenSource disposeCts = new();

    private GatewayApiResource<ProtectionCapabilitiesResponse>? capabilitiesResource;
    private GatewayApiResource<PurviewTenantConnectionResponse>? connectionResource;
    private GatewayApiResource<PurviewSensitiveInformationTypeListResponse>? inventoryResource;
    private GatewayApiResource<PurviewKnowYourDataResponse>? knowYourDataResource;
    private GatewayApiResource<PurviewDlpProfileListResponse>? profilesResource;
    private IReadOnlyList<AgentIdentityBlueprintSummaryDto> blueprints = [];
    private GatewayApiResource<ProtectionAdminOperationResponse>? operationResource;
    private SettingsForm? form;
    private UpdateSystemConfigRequest? pendingSettingsSaveRequest;

    private UiErrorInfo? capabilitiesError;
    private UiErrorInfo? connectionError;
    private UiErrorInfo? inventoryError;
    private UiErrorInfo? knowYourDataError;
    private UiErrorInfo? profilesError;
    private UiErrorInfo? blueprintsError;
    private UiErrorInfo? operationError;
    private UiErrorInfo? settingsLoadError;
    private UiErrorInfo? settingsSaveError;
    private UiErrorInfo? protectionActionError;

    private ProtectionOperationReviewTicket? protectionReview;
    private PurviewTenantConnectionEvidenceDto? companionEvidence;
    private PurviewCompanionLaunchDto? companionLaunch;
    private PurviewDlpProfileDto? editingProfile;
    private Guid? activeOperationId;
    private Guid? companionInventoryGenerationId;
    private Guid? pendingProfileId;
    private Guid signedInTenantId;
    private Guid signedInObjectId;
    private string selectedSitIndex = string.Empty;
    private string selectedBlueprintIndex = string.Empty;
    private string dlpDisplayName = string.Empty;
    private string dlpMode = "AuditOnly";
    private string kydMode = "AuditOnly";
    private string? protectionAnnouncement;
    private string? companionEvidenceError;
    private string? companionEvidenceDigest;
    private string pendingTargetLabel = "Protection settings";
    private bool roleLoaded;
    private bool isAdministrator;
    private bool canReadProtectionGovernance;
    private string roleLabel = "Gateway";
    private bool reloading;
    private bool capabilitiesLoading;
    private bool connectionLoading;
    private bool inventoryLoading;
    private bool knowYourDataLoading;
    private bool profilesLoading;
    private bool blueprintsLoading;
    private bool operationLoading;
    private bool settingsLoading;
    private bool saving;
    private bool settingsSaved;
    private bool settingsSaveOutcomeUnknown;
    private bool protectionActionBusy;
    private ProtectionAction pendingProtectionAction;
    private ConfirmationDialogKind dialogKind;

    private ProtectionCapabilityDto? Agent365Capability => FindCapability("Agent365RegistrationBeta");
    private ProtectionCapabilityDto? PromptShieldCapability => FindCapability("PromptShields", "PromptShield");
    private ProtectionCapabilityDto? PurviewCapability => FindCapability("Purview");
    private PurviewTenantConnectionDto? Connection => connectionResource?.Value.Connection;
    private PurviewKnowYourDataConfigurationDto? KnowYourData => knowYourDataResource?.Value.Configuration;
    private ProtectionAdminOperationDto? ActiveOperation => operationResource?.Value.Operation;
    private string PendingTargetLabel => pendingTargetLabel;
    private int ReadyProfileCount => profilesResource?.Value.Items.Count(ProfileIsReady) ?? 0;
    private bool HasReadyProfile => ReadyProfileCount > 0;
    private bool PromptShieldReady =>
        string.Equals(PromptShieldCapability?.Status, "Installed", StringComparison.OrdinalIgnoreCase) &&
        form?.PromptShieldAvailable == true;
    private bool ConnectionIsReady =>
        string.Equals(Connection?.Status, "Connected", StringComparison.OrdinalIgnoreCase);
    private bool LimitsAreOrdered =>
        form is null || form.RateLimitGlobal >= Math.Max(form.RateLimitPerClient, form.RateLimitPerAgent);
    private bool ProtectionDefaultsAreReady =>
        form is null ||
        (!form.DefaultPromptShieldEnabled || PromptShieldReady) &&
        (!form.DefaultPurviewEnabled || HasReadyProfile);
    private bool CanChangePromptShieldDefault =>
        form is not null && (PromptShieldReady || form.DefaultPromptShieldEnabled);
    private bool CanChangePurviewDefault =>
        form is not null && (HasReadyProfile || form.DefaultPurviewEnabled);
    private bool CanReviewConnection =>
        isAdministrator &&
        !protectionActionBusy &&
        CapabilityIsInstalled(PurviewCapability) &&
        signedInTenantId != Guid.Empty &&
        TryGetExpectedRowVersion(
            connectionResource is not null,
            Connection?.RowVersion,
            out _);
    private bool CanReviewCompanionCompletion =>
        isAdministrator &&
        !protectionActionBusy &&
        RequiresCompanionCompletion &&
        activeOperationId is not null &&
        companionEvidence is not null &&
        companionInventoryGenerationId is not null &&
        !string.IsNullOrWhiteSpace(companionEvidenceDigest) &&
        Connection?.Status == "AwaitingAdministrator" &&
        TryGetExpectedRowVersion(
            connectionResource is not null,
            Connection?.RowVersion,
            out _);

    private string? CompanionCommand =>
        TryBuildCompanionCommand(companionLaunch, out var command)
            ? command
            : null;
    private bool CanReviewKnowYourData =>
        isAdministrator &&
        !protectionActionBusy &&
        ConnectionIsReady &&
        SelectedSensitiveInformationType is not null &&
        inventoryResource?.Value.IsExpired == false &&
        TryGetExpectedRowVersion(
            knowYourDataResource is not null,
            KnowYourData?.RowVersion,
            out _);
    private bool CanReviewDlpProfile =>
        isAdministrator &&
        !protectionActionBusy &&
        ConnectionIsReady &&
        SelectedSensitiveInformationType is not null &&
        SelectedBlueprint is not null &&
        !string.IsNullOrWhiteSpace(dlpDisplayName) &&
        (editingProfile is not null || !BlueprintAlreadyHasProfile(SelectedBlueprint.BlueprintClientId)) &&
        TryGetExpectedRowVersion(
            profilesResource is not null,
            editingProfile?.RowVersion,
            out _);

    private bool RequiresCompanionCompletion =>
        string.Equals(
            ActiveOperation?.RequiredAction,
            CompletePurviewTenantConnectionAction,
            StringComparison.Ordinal) ||
        ActiveOperation is
        {
            Type: "ConnectPurviewTenant",
            Status: "AwaitingAdministrator"
        };

    private PurviewSensitiveInformationTypeDto? SelectedSensitiveInformationType =>
        TryGetSelectedIndex(selectedSitIndex, inventoryResource?.Value.Items, out var index)
            ? inventoryResource!.Value.Items[index]
            : null;

    private AgentIdentityBlueprintSummaryDto? SelectedBlueprint =>
        TryGetSelectedIndex(selectedBlueprintIndex, blueprints, out var index)
            ? blueprints[index]
            : null;

    private string PromptShieldRuntimeStatus => PromptShieldReady
        ? "Ready"
        : CapabilityDisplayStatus(PromptShieldCapability);

    private string PromptShieldReadinessExplanation => PromptShieldReady
        ? "The Gateway reports the shared capability ready for registrations that enable it."
        : CapabilityIsInstalled(PromptShieldCapability)
            ? "The shared resource is installed, but the Gateway has not reported it ready for agent use."
            : "Prompt Shields cannot be enabled for an agent in the current deployment state.";

    private string PromptShieldDefaultExplanation => form is null
        ? isAdministrator ? "Loading the current default." : "Only administrators can view and change the deployment default."
        : form.DefaultPromptShieldEnabled ? "On for new registrations." : "Off for new registrations.";

    private string PurviewJourneyStatus
    {
        get
        {
            if (!canReadProtectionGovernance)
            {
                return "Restricted";
            }

            if (!CapabilityIsInstalled(PurviewCapability))
            {
                return CapabilityDisplayStatus(PurviewCapability);
            }

            if (Connection is null || Connection.Status is "NotConnected" or "Expired" or "Revoked")
            {
                return "Not connected";
            }

            if (Connection.Status == "AwaitingAdministrator")
            {
                return "Awaiting admin";
            }

            if (Connection.Status == "PendingVerification")
            {
                return "Pending propagation";
            }

            if (Connection.Status == "VerificationFailed" ||
                profilesResource?.Value.Items.Any(ProfileHasFailed) == true)
            {
                return "Failed";
            }

            if (profilesResource?.Value.Items.Any(ProfileIsPending) == true)
            {
                return "Pending propagation";
            }

            return HasReadyProfile ? "Ready" : "Awaiting admin";
        }
    }

    private string ConnectionDisplayStatus => Connection?.Status switch
    {
        null or "NotConnected" or "Expired" or "Revoked" => "Not connected",
        "AwaitingAdministrator" => "Awaiting admin",
        "PendingVerification" => "Pending propagation",
        "VerificationFailed" => "Failed",
        "Connected" => "Ready",
        _ => "Awaiting admin"
    };

    private string KnowYourDataDisplayStatus => KnowYourData?.Status switch
    {
        null or "NotConfigured" => ConnectionIsReady ? "Awaiting admin" : "Not connected",
        "ReviewRequired" => "Awaiting admin",
        "Pending" => "Pending propagation",
        "VerificationFailed" => "Failed",
        "Ready" => "Ready",
        _ => "Awaiting admin"
    };

    private string ConfirmationTitle => dialogKind switch
    {
        ConfirmationDialogKind.SystemSettings => "Save system settings?",
        ConfirmationDialogKind.ProtectionReview
            when pendingProtectionAction == ProtectionAction.CompleteTenantConnection =>
                "Submit companion evidence for verification?",
        ConfirmationDialogKind.ProtectionReview
            when pendingProtectionAction == ProtectionAction.ReconcileProfile =>
                "Reconcile this DLP profile?",
        ConfirmationDialogKind.ProtectionReview
            when pendingProtectionAction == ProtectionAction.ValidateRuntime =>
                "Run the runtime readiness check?",
        ConfirmationDialogKind.ProtectionReview => $"Confirm {FriendlyOperation(protectionReview?.Review.OperationType)}?",
        _ => "Confirm action"
    };

    private string ConfirmationMessage => dialogKind switch
    {
        ConfirmationDialogKind.SystemSettings =>
            "These values affect new registration defaults, new idempotency records, and subsequent ingress enforcement.",
        ConfirmationDialogKind.ProtectionReview
            when pendingProtectionAction == ProtectionAction.CompleteTenantConnection =>
                "Confirm the exact tenant connection binding below. The Gateway will independently verify the bounded companion submission before reporting the connection Ready.",
        ConfirmationDialogKind.ProtectionReview
            when pendingProtectionAction == ProtectionAction.ReconcileProfile =>
                "Re-read the exact Microsoft Purview state for this profile. Reconciliation does not silently rewrite policy or make runtime readiness Ready.",
        ConfirmationDialogKind.ProtectionReview
            when pendingProtectionAction == ProtectionAction.ValidateRuntime =>
                "Start the approved bounded synthetic allow and block check. This is a runtime readiness operation, not a policy update.",
        ConfirmationDialogKind.ProtectionReview =>
            "Check this Gateway-reviewed summary before queuing the operation. The API will recheck your role, tenant, target, choices, and current version.",
        _ => string.Empty
    };

    private string ConfirmationButtonLabel => dialogKind switch
    {
        ConfirmationDialogKind.SystemSettings => "Save settings",
        ConfirmationDialogKind.ProtectionReview
            when pendingProtectionAction == ProtectionAction.CompleteTenantConnection =>
                "Submit for verification",
        ConfirmationDialogKind.ProtectionReview
            when pendingProtectionAction == ProtectionAction.ReconcileProfile =>
                "Start reconciliation",
        ConfirmationDialogKind.ProtectionReview
            when pendingProtectionAction == ProtectionAction.ValidateRuntime =>
                "Start runtime check",
        ConfirmationDialogKind.ProtectionReview => "Confirm and start",
        _ => "Confirm"
    };

    protected override async Task OnInitializedAsync()
    {
        var authenticationState = await AuthenticationStateProvider
            .GetAuthenticationStateAsync()
            .WaitAsync(disposeCts.Token);
        SetRole(authenticationState.User);
        ReadOperationFromLocation();
        roleLoaded = true;
        await ReloadAllAsync();
    }

    private async Task ReloadAllAsync()
    {
        if (reloading)
        {
            return;
        }

        reloading = true;
        settingsSaved = false;
        protectionAnnouncement = null;
        try
        {
            var protectionTask = LoadProtectionJourneyAsync();
            var operationTask = LoadActiveOperationAsync();
            if (isAdministrator)
            {
                await Task.WhenAll(
                    protectionTask,
                    operationTask,
                    LoadSettingsAsync());
            }
            else
            {
                await Task.WhenAll(protectionTask, operationTask);
            }
        }
        finally
        {
            reloading = false;
        }
    }

    private async Task LoadProtectionJourneyAsync()
    {
        if (!canReadProtectionGovernance)
        {
            await LoadCapabilitiesAsync();
            connectionResource = null;
            inventoryResource = null;
            knowYourDataResource = null;
            profilesResource = null;
            blueprints = [];
            return;
        }

        await Task.WhenAll(LoadCapabilitiesAsync(), LoadConnectionAsync());

        if (!ConnectionIsReady)
        {
            inventoryResource = null;
            knowYourDataResource = null;
            profilesResource = null;
            blueprints = [];
            return;
        }

        var tasks = new List<Task>
        {
            LoadKnowYourDataAsync(),
            LoadProfilesAsync()
        };
        if (isAdministrator)
        {
            tasks.Add(LoadInventoryAsync());
            tasks.Add(LoadBlueprintsAsync());
        }

        await Task.WhenAll(tasks);
    }

    private async Task LoadCapabilitiesAsync()
    {
        if (capabilitiesLoading)
        {
            return;
        }

        capabilitiesLoading = true;
        capabilitiesError = null;
        try
        {
            capabilitiesResource = await Api.GetProtectionCapabilitiesAsync(disposeCts.Token);
        }
        catch (OperationCanceledException) when (disposeCts.IsCancellationRequested)
        {
        }
        catch (Exception exception)
        {
            capabilitiesResource = null;
            capabilitiesError = UiErrorInfo.FromException(exception);
        }
        finally
        {
            capabilitiesLoading = false;
        }
    }

    private async Task LoadConnectionAsync()
    {
        if (!canReadProtectionGovernance || connectionLoading)
        {
            return;
        }

        connectionLoading = true;
        connectionError = null;
        try
        {
            connectionResource = await Api.GetPurviewTenantConnectionAsync(disposeCts.Token);
        }
        catch (OperationCanceledException) when (disposeCts.IsCancellationRequested)
        {
        }
        catch (Exception exception)
        {
            connectionResource = null;
            connectionError = UiErrorInfo.FromException(exception);
        }
        finally
        {
            connectionLoading = false;
        }
    }

    private async Task LoadInventoryAsync()
    {
        if (!isAdministrator || !ConnectionIsReady || inventoryLoading)
        {
            return;
        }

        inventoryLoading = true;
        inventoryError = null;
        var previousSelection = SelectedSensitiveInformationType;
        try
        {
            inventoryResource = await Api.GetPurviewSensitiveInformationTypesAsync(disposeCts.Token);
            selectedSitIndex = string.Empty;
            if (previousSelection is not null)
            {
                protectionAnnouncement = "The tenant inventory was refreshed. Choose the sensitive information type again before reviewing another change.";
            }
        }
        catch (OperationCanceledException) when (disposeCts.IsCancellationRequested)
        {
        }
        catch (Exception exception)
        {
            inventoryResource = null;
            selectedSitIndex = string.Empty;
            inventoryError = UiErrorInfo.FromException(exception);
        }
        finally
        {
            inventoryLoading = false;
        }
    }

    private async Task LoadKnowYourDataAsync()
    {
        if (!canReadProtectionGovernance || !ConnectionIsReady || knowYourDataLoading)
        {
            return;
        }

        knowYourDataLoading = true;
        knowYourDataError = null;
        try
        {
            knowYourDataResource = await Api.GetPurviewKnowYourDataAsync(disposeCts.Token);
            if (KnowYourData?.Mode is "AuditOnly" or "Enforce")
            {
                kydMode = KnowYourData.Mode;
            }
        }
        catch (OperationCanceledException) when (disposeCts.IsCancellationRequested)
        {
        }
        catch (Exception exception)
        {
            knowYourDataResource = null;
            knowYourDataError = UiErrorInfo.FromException(exception);
        }
        finally
        {
            knowYourDataLoading = false;
        }
    }

    private async Task LoadProfilesAsync()
    {
        if (!canReadProtectionGovernance || !ConnectionIsReady || profilesLoading)
        {
            return;
        }

        profilesLoading = true;
        profilesError = null;
        try
        {
            profilesResource = await Api.GetPurviewDlpProfilesAsync(disposeCts.Token);
        }
        catch (OperationCanceledException) when (disposeCts.IsCancellationRequested)
