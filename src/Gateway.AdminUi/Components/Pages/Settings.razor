    {
        None,
        SystemSettings,
        ProtectionReview
    }

    private enum ProtectionAction
    {
        None,
        ConnectTenant,
        CompleteTenantConnection,
        ConfigureKnowYourData,
        CreateProfile,
        UpdateProfile,
        ReconcileProfile,
        ValidateRuntime
    }

