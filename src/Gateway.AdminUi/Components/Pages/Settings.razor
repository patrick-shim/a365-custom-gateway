    private async Task ConfirmProtectionReviewAsync()
    {
        if (protectionReview is not { } review || ControlsDisabled ||
            dialogKind != ConfirmationDialogKind.ProtectionReview)
        {
            return;
        }
        Guid? recoveryReference = pendingProtectionAction == ProtectionAction.CompleteTenantConnection
            ? review.Review.SourceOperationId
            : review.ReviewTokenId;
        if (recoveryReference is not { } recoveryOperationId || recoveryOperationId == Guid.Empty ||
            !review.IsAvailable || AsUtc(review.ExpiresAtUtc) <= Clock.GetUtcNow().UtcDateTime ||
            reviewContextSignature != CaptureReviewContext(pendingProtectionAction) ||
            !ReviewBindingMatchesAction(review.Review, pendingProtectionAction))
        {
            CancelDialog();
            protectionActionError = new UiErrorInfo("This review expired or its context changed. Reload and review the current choices.");
            return;
        }
        var generation = contextGeneration;
        var confirmationVersion = ++confirmationGeneration;
        var acceptedAction = pendingProtectionAction;
        var sourceOperationId = activeOperationId;
        var evidence = companionEvidence;
        var profileId = pendingProfileId;
        var mutationDispatched = false;
        ProtectionOperationConfirmationTicket? confirmed = null;
        protectionActionBusy = true;
        protectionActionError = null;
        dialogKind = ConfirmationDialogKind.None;
        protectionReview = null;
        try
        {
            var recoveryUri = Navigation.GetUriWithQueryParameter("operation", recoveryOperationId.ToString("D"));
            var retained = await ProtectionRecovery.TryRetainAsync(
                JS, Logger, recoveryUri, recoveryOperationId, disposeCts.Token);
            if (!IsCurrent(generation) || confirmationGeneration != confirmationVersion)
                return;
            if (!retained)
            {
                protectionActionError = new UiErrorInfo(ProtectionRecovery.FailureMessage);
                return;
            }
            activeOperationId = recoveryOperationId;
            operationResource = null;
            PersistActiveOperationInLocation(recoveryOperationId);
            var currentSignature = CaptureReviewContext(acceptedAction);
            var confirmation = await Api.ConfirmProtectionOperationReviewAsync(
                review,
                disposeCts.Token);
            confirmed = confirmation.Value;
            if (!IsCurrent(generation) || confirmationGeneration != confirmationVersion)
                return;
            if (currentSignature != CaptureReviewContext(acceptedAction) ||
                confirmation.Value.ReviewTokenId != review.ReviewTokenId ||
                confirmation.Value.ConfirmationTokenId != review.ReviewTokenId ||
                confirmation.Value.ExpiresAtUtc <= Clock.GetUtcNow().UtcDateTime ||
                !confirmation.Value.IsAvailable)
            {
                protectionActionError = new UiErrorInfo("The confirmation no longer matches the reviewed operation and current choices. No mutation was sent.");
                return;
            }
            var rowVersion = confirmation.Value.ExpectedRowVersion;
            var idempotencyKey = Guid.NewGuid();
            if (acceptedAction == ProtectionAction.CompleteTenantConnection)
            {
                companionLaunch = null;
                ClearCompanionEvidence();
            }
            mutationDispatched = true;
            GatewayApiResource<ProtectionOperationAcceptedResponse> accepted =
                acceptedAction switch
                {
                    ProtectionAction.ConnectTenant =>
                        await Api.StartPurviewTenantConnectionOperationAsync(
                            confirmation.Value,
                            idempotencyKey,
                            rowVersion,
                            disposeCts.Token),
                    ProtectionAction.CompleteTenantConnection
                        when sourceOperationId is { } operationId && evidence is not null =>
                        await Api.CompletePurviewTenantConnectionOperationAsync(
                            operationId,
                            evidence,
                            confirmation.Value,
                            idempotencyKey,
                            rowVersion,
                            disposeCts.Token),
                    ProtectionAction.ConfigureKnowYourData =>
                        await Api.StartPurviewKnowYourDataOperationAsync(
                            confirmation.Value,
                            idempotencyKey,
                            rowVersion,
                            disposeCts.Token),
                    ProtectionAction.CreateProfile or ProtectionAction.UpdateProfile =>
                        await Api.StartPurviewDlpProfileOperationAsync(
                            confirmation.Value,
                            idempotencyKey,
                            rowVersion,
                            disposeCts.Token),
                    ProtectionAction.ReconcileProfile when profileId is { } reviewedProfileId =>
                        await Api.ReconcilePurviewDlpProfileAsync(
                            reviewedProfileId,
                            confirmation.Value,
                            idempotencyKey,
                            rowVersion,
                            disposeCts.Token),
                    _ => throw new InvalidOperationException("The reviewed protection action is no longer available.")
                };

            if (!IsCurrent(generation) || confirmationGeneration != confirmationVersion)
                return;
            if (accepted.Value.OperationId != recoveryOperationId)
            {
                protectionOutcomeUnknown = true;
                protectionActionError = new UiErrorInfo("The response did not identify the reviewed operation. Check the retained operation; do not submit another mutation.");
                return;
            }
            if (acceptedAction == ProtectionAction.ConnectTenant)
            {
                var launch = accepted.Value.CompanionLaunch;
                if (launch is null ||
                    launch.OperationId != accepted.Value.OperationId ||
                    !TryBuildCompanionCommand(launch, out _))
                {
                    companionLaunch = null;
                    protectionOutcomeUnknown = true;
                    protectionActionError = new UiErrorInfo(
                        "The Gateway accepted the connection operation but its launch instructions were not confirmed. Check the same operation to recover its recorded instructions; do not start another connection.");
                }
                else
                {
                    companionLaunch = launch;
                }
            }

            PersistActiveOperationInLocation(accepted.Value.OperationId);
            protectionAnnouncement = acceptedAction == ProtectionAction.CompleteTenantConnection
                ? "Companion result accepted. The Gateway is checking its own Purview access under the original connection operation. This does not enable DLP protection."
                : "The Gateway accepted the reviewed operation. Follow its persisted progress below.";
            dialogKind = ConfirmationDialogKind.None;
            pendingProfileId = null;
            await LoadActiveOperationAsync();
            if (!IsCurrent(generation))
                return;
            await LoadConnectionAsync();
            if (!IsCurrent(generation))
                return;
            if (acceptedAction == ProtectionAction.CompleteTenantConnection &&
                ConnectionIsReady)
            {
                await LoadProtectionJourneyAsync();
            }
        }
        catch (OperationCanceledException) when (disposeCts.IsCancellationRequested)
        {
        }
        catch (Exception exception)
        {
            if (IsCurrent(generation))
            {
                protectionActionError = UiErrorInfo.FromException(exception);
                protectionOutcomeUnknown = mutationDispatched &&
                    (exception is not GatewayApiException apiError || apiError.IsTransient);
                pendingProfileId = null;
            }
            else
                LogSupersededRead();
        }
        finally
        {
            review.Discard();
            confirmed?.Discard();
            if (IsCurrent(generation))
                protectionActionBusy = false;
        }
    }

    private Task LoadActiveOperationAsync() =>
        ReadActiveOperationAsync(refreshContext: !reloading && !protectionActionBusy, disposeCts.Token);

    private async Task ReadActiveOperationAsync(bool refreshContext, CancellationToken cancellationToken)
    {
        if (activeOperationId is not { } operationId || operationLoading)
        {
            return;
        }

        operationLoading = true;
        var generation = contextGeneration;
        var wasUnknown = protectionOutcomeUnknown;
        var previousStatus = ActiveOperation?.Status;
        operationError = null;
        try
        {
            var response = await Api.GetProtectionAdminOperationAsync(
                operationId,
                cancellationToken).WaitAsync(cancellationToken);
            cancellationToken.ThrowIfCancellationRequested();
            if (!IsCurrent(generation) || activeOperationId != operationId)
                return;
            if (response.Value.Operation.Id != operationId ||
                response.Value.Operation.TenantId != signedInTenantId)
            {
                operationResource = null;
                companionLaunch = null;
                protectionOutcomeUnknown = true;
                operationError = new UiErrorInfo("The operation response did not match the retained operation and tenant.");
                return;
            }
            if (response.Value.Operation is
                { Type: "CompletePurviewTenantConnection", Status: "Submitted" } completion)
            {
                operationResource = null;
                companionLaunch = null;
                protectionOutcomeUnknown = true;
                if (completion.ReadbackReferenceId is not { } sourceId ||
                    sourceId == Guid.Empty || sourceId == completion.Id ||
                    completion.TargetType != "PurviewTenantConnection" ||
                    !Guid.TryParseExact(completion.TargetIdentifier, "D", out var connectionTarget) ||
                    connectionTarget == Guid.Empty ||
                    completion.TargetIdentifier != connectionTarget.ToString("D"))
                {
                    operationError = new UiErrorInfo("The completion readback did not match this connection. Keep the retained operation and contact a Gateway Administrator; do not submit the result again.");
                    return;
                }
                var sourceResponse = await Api.GetProtectionAdminOperationAsync(sourceId, cancellationToken)
                    .WaitAsync(cancellationToken);
                cancellationToken.ThrowIfCancellationRequested();
                if (!IsCurrent(generation) || activeOperationId != operationId)
                    return;
                var source = sourceResponse.Value.Operation;
                if (source.Id != sourceId || source.TenantId != signedInTenantId ||
                    source.ActorObjectId != completion.ActorObjectId ||
                    source.Type != "ConnectPurviewTenant" ||
                    source.TargetType != completion.TargetType ||
                    source.TargetIdentifier != completion.TargetIdentifier ||
                    source.Status is not ("Pending" or "Running" or "PendingPropagation" or "Completed" or "Failed" or "RequiresManualIntervention" or "Cancelled"))
                {
                    operationError = new UiErrorInfo("The completion readback did not match its original connection operation. Keep the retained operation and contact a Gateway Administrator; do not submit the result again.");
                    return;
                }
                response = sourceResponse;
                activeOperationId = operationId = sourceId;
                PersistActiveOperationInLocation(sourceId);
            }
            operationResource = response;
            operationLastCheckedAtUtc = Clock.GetUtcNow().UtcDateTime;
            companionLaunch = null;
            if (ActiveOperation is { Type: "ConnectPurviewTenant", Status: "AwaitingAdministrator" } &&
                ActiveOperation.ActorObjectId == signedInObjectId.ToString("D"))
            {
                companionLaunch = response.Value.CompanionLaunch;
                if (companionLaunch?.OperationId != operationId)
                    companionLaunch = null;
            }
            else if (ActiveOperation is { Type: "ConnectPurviewTenant" })
                ClearCompanionEvidence();
            if (ActiveOperation is { Type: not CompletePurviewTenantConnectionAction } &&
                ActiveOperation.Status is "AwaitingConfirmation" or "AwaitingAdministrator" or "Pending" or "Running" or "PendingPropagation" or
                    "AwaitingBlueprint" or "Completed" or "Failed" or "RequiresManualIntervention" or "Cancelled")
                protectionOutcomeUnknown = false;
            else
                protectionOutcomeUnknown = true;
            if (wasUnknown && !protectionOutcomeUnknown)
                protectionActionError = null;
            if (ProtectionOperationPresentation.IsInProgress(previousStatus) &&
                !ProtectionOperationPresentation.IsInProgress(ActiveOperation?.Status) && !reloading)
                operationContextRefreshNeeded = true;
            if (refreshContext && operationContextRefreshNeeded && !protectionOutcomeUnknown)
                await RefreshOperationContextAsync(cancellationToken);
            else if (wasUnknown && !protectionOutcomeUnknown && canReadProtectionGovernance &&
                ActiveOperation is { Type: "ConnectPurviewTenant" } &&
                (ActiveOperation.Status != "AwaitingAdministrator" || Connection?.Status != "AwaitingAdministrator"))
                await LoadConnectionAsync(cancellationToken);
        }
        catch (OperationCanceledException) when (disposeCts.IsCancellationRequested)
        {
        }
        catch (OperationCanceledException) when (cancellationToken.IsCancellationRequested) { throw; }
        catch (Exception exception)
        {
            SetReadError(generation, exception, error => operationError = error);
        }
        finally
        {
            if (IsCurrent(generation))
                operationLoading = false;
        }
    }

