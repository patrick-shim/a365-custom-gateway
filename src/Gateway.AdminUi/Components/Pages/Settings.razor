                RateLimitPerAgent: RateLimitPerAgent,
                RateLimitGlobal: RateLimitGlobal,
                ReconciliationEnabled: null,
                ReconciliationIntervalHours: null,
                StuckTransitionTimeoutDays: null,
                UseGraphAgentRegistration: null,
                UseCliProvisioningFallback: null,
                DefaultAgent365ObservabilityEnabled: DefaultAgent365ObservabilityEnabled,
                DefaultAzureMonitorExportEnabled: DefaultAzureMonitorExportEnabled,
                DefaultPromptShieldEnabled: DefaultPromptShieldEnabled,
                IdempotencyKey: hasRowVersion ? idempotencyKey : null,
                ExpectedRowVersion: hasRowVersion ? RowVersion : null);
