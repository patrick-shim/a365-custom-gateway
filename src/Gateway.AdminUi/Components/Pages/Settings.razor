    private void ReadOperationFromLocation()
    {
        var query = Microsoft.AspNetCore.WebUtilities.QueryHelpers.ParseQuery(
            Navigation.ToAbsoluteUri(Navigation.Uri).Query);
        var supplied = query.TryGetValue("operation", out var values);
        var reference = OperationReference ?? (supplied && values.Count == 1 ? values[0] : null);
        if (!supplied && OperationReference is null)
            return;
        if ((!supplied || values.Count == 1) &&
            Guid.TryParse(reference, out var operationId) &&
            operationId != Guid.Empty)
        {
            activeOperationId = operationId;
        }
        else
            operationError = new UiErrorInfo("The retained operation reference is invalid. Open the original operation URL before taking another action.");
    }

    private void PersistActiveOperationInLocation(Guid operationId)
    {
        var uri = Navigation.GetUriWithQueryParameter(
            "operation",
            operationId.ToString("D"));
        lastLocation = $"{TaskName}|{operationId:D}|{ProfileReference}";
        Navigation.NavigateTo(uri, replace: true);
    }

