    private void AcceptCompanionOutput(string output)
    {
        try
        {
            if (StrictUtf8.GetByteCount(output) > MaximumCompanionEvidenceBytes)
            {
                companionEvidenceError = "This result is larger than the supported 512 KB limit. Copy only the companion's result line, not the full console history.";
                return;
            }
        }
        catch (EncoderFallbackException)
        {
            companionEvidenceError = "This result contains invalid text. Copy the original A365GW_CONNECTION_RESULT: line again without editing it.";
            return;
        }
        if (!TryDecodeCompanionOutput(output, out var decodedOutput))
        {
            companionEvidenceError = "Paste only the complete line beginning A365GW_CONNECTION_RESULT:, including the text after the colon. Do not paste commands, sign-in messages, handcrafted JSON, or PURVIEW_REFERENCE_REGISTRATION output. You can copy the existing console result again; no new sign-in is needed just to copy it.";
            return;
        }
        if (!ValidateCompanionOutput(decodedOutput))
        {
            companionEvidenceError = "This is not the single fresh result for this signed-in tenant, administrator, and operation, or it has expired. Use the result from this operation's command. If the launch has expired, review a new connection; do not edit or resubmit old evidence.";
            return;
        }
        companionEvidence = new PurviewTenantConnectionEvidenceDto(
            decodedOutput.TenantId,
            decodedOutput.AdministratorObjectId,
            decodedOutput.AuthorizedCapabilities,
            decodedOutput.ObservedAtUtc,
            decodedOutput.InventoryExpiresAtUtc,
            decodedOutput.SensitiveInformationTypes);
        companionInventoryGenerationId = decodedOutput.InventoryGenerationId;
        companionEvidenceDigest = PurviewTenantConnectionEvidenceDigest.Compute(
            decodedOutput.OperationId, decodedOutput.InventoryGenerationId, companionEvidence);
    }

    private async Task ReadCompanionEvidenceAsync(InputFileChangeEventArgs args)
    {
        if (!CanReadCompanionEvidence)
        {
            companionEvidenceError = "Open this administrator's current, unexpired connection operation before adding a result.";
            return;
        }
        var generation = contextGeneration;
        CancelDialog();
        ClearCompanionEvidence();
        var readGeneration = companionReadGeneration;
        protectionActionError = null;

        if (args.FileCount != 1)
        {
            companionEvidenceError = "Choose exactly one fresh Gateway companion evidence file.";
            return;
        }

        var file = args.File;
        if (file.Size is < 1 or > MaximumCompanionEvidenceBytes)
        {
            companionEvidenceError = "The companion evidence file is empty or larger than the supported 512 KB limit.";
            return;
        }

        try
        {
            await using var stream = file.OpenReadStream(
                MaximumCompanionEvidenceBytes,
                disposeCts.Token);
            using var reader = new StreamReader(
                stream,
                StrictUtf8,
                detectEncodingFromByteOrderMarks: false,
                leaveOpen: false);
            var output = await reader.ReadToEndAsync(disposeCts.Token);
            if (!IsCurrent(generation) || readGeneration != companionReadGeneration)
                return;
            if (!CanReadCompanionEvidence)
            {
                companionEvidenceError = "This connection can no longer accept a result. Refresh its existing operation before taking another action.";
                return;
            }
            AcceptCompanionOutput(output);
        }
        catch (OperationCanceledException) when (disposeCts.IsCancellationRequested)
        {
        }
        catch (Exception exception) when (exception is IOException or DecoderFallbackException or JSException or
                                         InvalidOperationException or OperationCanceledException or TimeoutException)
        {
            if (IsCurrent(generation) && readGeneration == companionReadGeneration)
                companionEvidenceError =
                    "The Gateway could not read this file. Paste the existing A365GW_CONNECTION_RESULT: line into the box instead, or choose a UTF-8 text file containing only that line.";
            else
                LogSupersededRead();
        }
    }

    private static bool TryDecodeCompanionOutput(
        string output,
        out PurviewCompanionOutput decodedOutput)
    {
        decodedOutput = default!;
        var line = output.Trim();
        if (line.Length <= CompanionResultPrefix.Length ||
            line.Contains('\r') ||
            line.Contains('\n') ||
            !line.StartsWith(CompanionResultPrefix, StringComparison.Ordinal) ||
            line.IndexOf(
                CompanionResultPrefix,
                CompanionResultPrefix.Length,
                StringComparison.Ordinal) >= 0)
        {
            return false;
        }

        var encodedPayload = line[CompanionResultPrefix.Length..];
        if (encodedPayload.Length % 4 != 0 ||
            encodedPayload.Any(character => !IsBase64Character(character)))
        {
            return false;
        }

        byte[] payload;
        try
        {
            payload = Convert.FromBase64String(encodedPayload);
        }
        catch (FormatException)
        {
            return false;
        }

        if (payload.Length is < 1 or > MaximumCompanionPayloadBytes ||
            !string.Equals(
                Convert.ToBase64String(payload),
                encodedPayload,
                StringComparison.Ordinal))
        {
            return false;
        }

        try
        {
            decodedOutput =
                JsonSerializer.Deserialize<PurviewCompanionOutput>(
                    payload,
                    CompanionJsonOptions)!;
            return decodedOutput is not null;
        }
        catch (JsonException)
        {
            return false;
        }
    }

    private static bool IsBase64Character(char character) =>
        character is >= 'A' and <= 'Z' or
        >= 'a' and <= 'z' or
        >= '0' and <= '9' or
        '+' or
        '/' or
        '=';

    private bool ValidateCompanionOutput(PurviewCompanionOutput? output)
    {
        if (output is null ||
            output.OperationId != activeOperationId ||
            output.InventoryGenerationId == Guid.Empty ||
            companionLaunch is null ||
            (output.OperationId != companionLaunch.OperationId ||
             output.InventoryGenerationId !=
                 companionLaunch.InventoryGenerationId ||
             output.InventoryExpiresAtUtc !=
                 companionLaunch.ExpiresAtUtc) ||
            output.TenantId != signedInTenantId ||
            output.AdministratorObjectId != signedInObjectId ||
            output.ObservedAtUtc > Clock.GetUtcNow() ||
            output.ObservedAtUtc.Offset != TimeSpan.Zero ||
            output.InventoryExpiresAtUtc.Offset != TimeSpan.Zero ||
            output.InventoryExpiresAtUtc <= Clock.GetUtcNow() ||
            output.InventoryExpiresAtUtc <= output.ObservedAtUtc ||
            output.InventoryExpiresAtUtc > output.ObservedAtUtc.AddMinutes(15) ||
            output.AuthorizedCapabilities is null ||
            !output.AuthorizedCapabilities.SequenceEqual(RequiredCompanionCapabilities) ||
            output.SensitiveInformationTypes is null ||
            output.SensitiveInformationTypes.Count is < 1 or > 2048)
        {
            return false;
        }

        var ids = new HashSet<Guid>();
        var names = new HashSet<string>(StringComparer.Ordinal);
        return output.SensitiveInformationTypes.All(item =>
            item is not null &&
            item.Id != Guid.Empty &&
            ids.Add(item.Id) &&
            IsBoundedCompanionText(item.ExactName, 255) &&
            names.Add(item.ExactName) &&
            IsBoundedCompanionText(item.Publisher, 200));
    }

    private bool HasExpectedCompanionBinding(PurviewCompanionLaunchDto launch)
    {
        if (launch.OperationId == Guid.Empty ||
            launch.OperationId != activeOperationId ||
            launch.InventoryGenerationId == Guid.Empty ||
            launch.ExpiresAtUtc.Offset != TimeSpan.Zero ||
            !string.Equals(
                launch.ScriptRelativePath,
                CompanionLaunchScriptRelativePath,
                StringComparison.Ordinal) ||
            launch.Arguments is null ||
            launch.Arguments.Count != 14 ||
            launch.Arguments.Any(argument =>
                !IsBoundedCompanionText(argument, 1_024)) ||
            !ContainsExactFileBinding(
                launch.Arguments,
                launch.ScriptRelativePath) ||
            !ContainsExactArgumentBinding(
                launch.Arguments,
                "-OperationId",
                launch.OperationId.ToString("D")) ||
            !ContainsExactArgumentBinding(launch.Arguments, "-TenantId", signedInTenantId.ToString("D")) ||
            !ContainsExactArgumentBinding(launch.Arguments, "-AdministratorObjectId", signedInObjectId.ToString("D")) ||
            !ContainsExactArgumentBinding(
                launch.Arguments,
                "-InventoryGenerationId",
                launch.InventoryGenerationId.ToString("D")) ||
            !ContainsExactArgumentBinding(
                launch.Arguments,
                "-ExpiresAtUtc",
                launch.ExpiresAtUtc.ToString("O")))
        {
            return false;
        }
        var expectedArguments = new[]
        {
            "-NoLogo", "-NoProfile", "-File", CompanionLaunchScriptRelativePath,
            "-OperationId", launch.OperationId.ToString("D"),
            "-TenantId", signedInTenantId.ToString("D"),
            "-AdministratorObjectId", signedInObjectId.ToString("D"),
            "-InventoryGenerationId", launch.InventoryGenerationId.ToString("D"),
            "-ExpiresAtUtc", launch.ExpiresAtUtc.ToString("O")
        };
        return launch.Arguments.SequenceEqual(expectedArguments, StringComparer.Ordinal);
    }

    private bool TryBuildCompanionCommand(
        PurviewCompanionLaunchDto? launch,
        out string command)
    {
        command = string.Empty;
        if (launch is null ||
            launch.ExpiresAtUtc <= Clock.GetUtcNow() ||
            !HasExpectedCompanionBinding(launch))
            return false;

        var localArguments = launch.Arguments.ToArray();
        for (var index = 0; index + 1 < localArguments.Length; index++)
        {
            if (string.Equals(
                    localArguments[index],
                    "-File",
                    StringComparison.Ordinal))
            {
                localArguments[index + 1] = LocalCompanionScriptPath;
                break;
            }
        }

        command = "pwsh " + string.Join(
            " ",
            localArguments.Select(QuotePowerShellArgument));
        return command.Length <= 16_384;
    }

    private static bool ContainsExactFileBinding(
        IReadOnlyList<string> arguments,
        string scriptRelativePath)
    {
        var matchingFileBindings = 0;
        for (var index = 0; index + 1 < arguments.Count; index++)
        {
            if (string.Equals(
                    arguments[index],
                    "-File",
                    StringComparison.Ordinal))
            {
                matchingFileBindings++;
                if (!string.Equals(
                        arguments[index + 1],
                        scriptRelativePath,
                        StringComparison.Ordinal))
                {
                    return false;
                }
            }
        }

        return matchingFileBindings == 1;
    }

    private static bool ContainsExactArgumentBinding(
        IReadOnlyList<string> arguments,
        string name,
        string value)
    {
        var matches = 0;
        for (var index = 0; index + 1 < arguments.Count; index++)
        {
            if (string.Equals(arguments[index], name, StringComparison.Ordinal))
            {
                matches++;
                if (!string.Equals(
                        arguments[index + 1],
                        value,
                        StringComparison.Ordinal))
                {
                    return false;
                }
            }
        }

        return matches == 1;
    }

    private static string QuotePowerShellArgument(string value) =>
        $"'{value.Replace("'", "''", StringComparison.Ordinal)}'";

    private static bool IsBoundedCompanionText(string? value, int maximumLength) =>
        !string.IsNullOrWhiteSpace(value) &&
        value.Length <= maximumLength &&
        value.All(character => character > '\u001f' && character != '\u007f');

    private void RequestSettingsSave()
    {
        if (!isAdministrator || ControlsDisabled || settingsSaveOutcomeUnknown ||
            dialogKind != ConfirmationDialogKind.None ||
            !LimitsAreOrdered || !ProtectionDefaultsAreReady)
        {
            return;
        }

        settingsSaved = false;
        settingsSaveError = null;
        pendingSettingsSaveRequest = form?.ToRequest(Guid.NewGuid());
        confirmationGeneration++;
        dialogKind = ConfirmationDialogKind.SystemSettings;
    }

    private async Task SaveSettingsAsync()
    {
        if (form is null ||
            pendingSettingsSaveRequest is null ||
            !LimitsAreOrdered ||
            !ProtectionDefaultsAreReady ||
            saving)
        {
            return;
        }

        var request = pendingSettingsSaveRequest;
        var generation = contextGeneration;
        saving = true;
        settingsSaveError = null;
        try
        {
            var response = await Api.UpdateSystemConfigAsync(request, cancellationToken: disposeCts.Token);
            if (!IsCurrent(generation))
                return;
            form = SettingsForm.From(response);
            settingsSaved = true;
            pendingSettingsSaveRequest = null;
            settingsSaveOutcomeUnknown = false;
            dialogKind = ConfirmationDialogKind.None;
        }
        catch (OperationCanceledException) when (disposeCts.IsCancellationRequested)
        {
        }
        catch (Exception exception)
        {
            if (!IsCurrent(generation))
            {
                LogSupersededRead();
                return;
            }
            settingsSaveError = UiErrorInfo.FromException(exception);
            if (request.IdempotencyKey is not null &&
                IsAmbiguousSettingsSaveFailure(exception))
            {
                settingsSaveOutcomeUnknown = true;
            }
            else
            {
                pendingSettingsSaveRequest = null;
                settingsSaveOutcomeUnknown = false;
            }
            dialogKind = ConfirmationDialogKind.None;
        }
        finally
        {
            if (IsCurrent(generation))
                saving = false;
        }
    }

    private Task RetryAmbiguousSettingsSaveAsync() =>
        settingsSaveOutcomeUnknown
            ? SaveSettingsAsync()
            : Task.CompletedTask;

    private static bool IsAmbiguousSettingsSaveFailure(Exception exception) =>
        exception is GatewayApiTransportException or GatewayApiProtocolException ||
        exception is GatewayApiException { IsTransient: true };

    private void CancelDialog()
    {
        confirmationGeneration++;
        if (dialogKind == ConfirmationDialogKind.ProtectionReview)
            protectionAnnouncement = "Review cancelled. No mutation was sent from this review; previously accepted work is unchanged.";
        if (dialogKind == ConfirmationDialogKind.SystemSettings &&
            !settingsSaveOutcomeUnknown)
        {
            pendingSettingsSaveRequest = null;
        }

        protectionReview?.Discard();
        protectionReview = null;
        reviewContextSignature = null;
        pendingProfileId = null;
        dialogKind = ConfirmationDialogKind.None;
        pendingProtectionAction = ProtectionAction.None;
    }

    private void SetRole(ClaimsPrincipal user)
    {
        isAdministrator = user.IsInRole("Gateway.Administrator");
        var isOperator = user.IsInRole("Gateway.Operator");
        canReadProtectionGovernance = isAdministrator || isOperator;
        roleLabel = isOperator
            ? "Operator"
            : user.IsInRole("Gateway.Auditor")
                ? "Auditor"
                : user.IsInRole("Gateway.SupportReader")
                    ? "Support Reader"
                    : isAdministrator ? "Administrator" : "Gateway";

        var tenantClaim = user.FindFirst("tid")?.Value ??
            user.FindFirst("http://schemas.microsoft.com/identity/claims/tenantid")?.Value;
        _ = Guid.TryParse(tenantClaim, out signedInTenantId);
        var objectIdClaim = user.FindFirst("oid")?.Value ??
            user.FindFirst("http://schemas.microsoft.com/identity/claims/objectidentifier")?.Value;
        _ = Guid.TryParse(objectIdClaim, out signedInObjectId);
    }

