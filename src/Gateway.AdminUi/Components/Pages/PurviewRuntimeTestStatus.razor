@page "/protection/runtime-tests/{OperationId:guid}"
@attribute [Authorize(Roles = "Gateway.Administrator")]
@rendermode InteractiveServer
@implements IAsyncDisposable
@inject IGatewayApiClient Api
@inject ILogger<PurviewRuntimeTestStatus> Logger
@inject AuthenticationStateProvider AuthenticationStateProvider

<PageTitle>Protection runtime report · A365 Gateway</PageTitle>
<PageHeader Title="Protection runtime report" Description="Safe GET recovery only. This page never collects or replays sample content.">
    <Actions>
        <a href="@(profileId is { } id ? $"/settings/runtime?profile={id:D}" : "/settings/runtime")" class="text-link">Back to policy behavior tests</a>
    </Actions>
</PageHeader>
@if (loading)
{
    <LoadingState Label="Reading the saved runtime report..." />
}
@if (report is not null)
{
    <ProtectionRuntimeOutcome Report="report" CurrentProfile="currentProfile" Busy="loading"
        OnRecover="RefreshAsync" OnRefreshReadiness="RefreshAsync" />
    <PurviewRuntimeTestReport Report="report" />
    @if (currentProfile is not null)
    {
        <ProtectionSnapshot Profile="currentProfile" />
        <ProtectionReadinessPanel Readiness="currentProfile.Readiness" Label="Current saved protection"
            PolicyMode="@currentProfile.PolicyMode" ProfileStatus="@currentProfile.Status"
            EvidenceExpiresAtUtc="currentProfile.RuntimeBehaviorVerifiedUntilUtc" />
    }
    @if (readinessError is not null)
    {
        <p class="readiness-blockers" role="status">@readinessError</p>
    }
}
@if (error is not null)
{
    <ErrorState Message="@error" />
}
<FluentButton Type="ButtonType.Button" Appearance="Appearance.Neutral"
              Disabled="@(loading || !RendererInfo.IsInteractive)" OnClick="RefreshAsync">Refresh safe report</FluentButton>

@code {
    [Parameter] public Guid OperationId { get; set; }
    private readonly CancellationTokenSource disposal = new();
    private PurviewRuntimeTestResultResponse? report;
    private PurviewDlpProfileDto? currentProfile;
    private Guid? profileId;
    private Guid signedInTenantId;
    private string? readinessError;
    private bool loading;
    private bool disposed;
    private string? error;
    private long revision;

    protected override async Task OnInitializedAsync()
    {
        var identity = await AuthenticationStateProvider.GetAuthenticationStateAsync().WaitAsync(disposal.Token);
        Guid.TryParse(identity.User.FindFirst("tid")?.Value, out signedInTenantId);
    }

    protected override Task OnParametersSetAsync() => LoadAsync();
    private Task RefreshAsync() => RendererInfo.IsInteractive && !loading && !disposed ? LoadAsync() : Task.CompletedTask;

    private async Task LoadAsync()
    {
        var currentRevision = ++revision;
        var operationId = OperationId;
        report = null;
        currentProfile = null;
        profileId = null;
        readinessError = error = null;
        if (operationId == Guid.Empty)
        {
            error = "A valid saved operation reference is required.";
            return;
        }
        loading = true;
        try
        {
            var recovered = await Api.GetPurviewRuntimeTestAsync(operationId, disposal.Token).WaitAsync(disposal.Token);
            if (!IsCurrent(currentRevision, operationId))
                return;
            if (!RuntimeTestUiProtocol.IsSafeReport(recovered, operationId))
                throw new InvalidOperationException("The report did not match the requested operation.");
            report = recovered;
            try
            {
                var operation = (await Api.GetProtectionAdminOperationAsync(operationId, disposal.Token).WaitAsync(disposal.Token)).Value.Operation;
                if (!IsCurrent(currentRevision, operationId))
                    return;
                if (operation.Id != operationId || operation.TenantId != signedInTenantId || signedInTenantId == Guid.Empty ||
                    operation.Type != "TestDlpRuntime" || operation.TargetType != "DlpProfile" ||
                    !Guid.TryParseExact(operation.TargetIdentifier, "D", out var targetProfileId) || targetProfileId == Guid.Empty)
                    throw new InvalidOperationException("The report's profile binding was not confirmed.");
                profileId = targetProfileId;
                var profiles = await Api.GetPurviewDlpProfilesAsync(disposal.Token).WaitAsync(disposal.Token);
                if (IsCurrent(currentRevision, operationId))
                    currentProfile = profiles.Value.Items.Single(item => item.Id == targetProfileId);
            }
            catch (OperationCanceledException) when (disposal.IsCancellationRequested) { }
            catch (Exception)
            {
                if (IsCurrent(currentRevision, operationId))
                    readinessError = "Current saved-profile readiness could not be verified. The historical receipt alone does not establish current enforcement.";
                else
                    LogSupersededRead();
            }
        }
        catch (OperationCanceledException) when (disposal.IsCancellationRequested) { }
        catch (Exception)
        {
            if (IsCurrent(currentRevision, operationId))
                error = "This safe report could not be retrieved. Check access and the operation ID; do not replay sample content.";
            else
                LogSupersededRead();
        }
        finally
        {
            if (IsCurrent(currentRevision, operationId))
                loading = false;
        }
    }

    private bool IsCurrent(long value, Guid id) => !disposed && revision == value && OperationId == id;
    private void LogSupersededRead() => Logger.LogDebug("A runtime report read failed after its route was superseded.");
    public ValueTask DisposeAsync()
    {
        disposed = true;
        revision++;
        disposal.Cancel();
        disposal.Dispose();
        return ValueTask.CompletedTask;
    }
}
