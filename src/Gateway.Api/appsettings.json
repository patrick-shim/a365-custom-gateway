{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "GatewayIngress": {
    "TrustedProxyNetworks": []
  },
  "EntraId": {
    "Instance": "https://login.microsoftonline.com/",
    "TenantId": "",
    "ClientId": "",
    "Audience": "",
    "ClientCredentials": [
      {
        "SourceType": "ClientSecret",
        "ClientSecret": ""
      }
    ]
  },
  "ConnectionStrings": {
    "GatewayDb": ""
  },
  "OutboxRelay": {
    "PollingIntervalSeconds": 5,
    "BatchSize": 50,
    "MaxRetryCount": 5,
    "InitialRetryDelaySeconds": 5,
    "MaxRetryDelaySeconds": 300,
    "ClaimLeaseSeconds": 120
  },
  "Provisioning": {
    "ExecutionEnabled": false,
    "AllowContinuousDevelopmentAccess": false
  },
  "AgentIngressCredentials": {
    "LifetimeDays": 365
  },
  "Agent365": {
    "TenantId": "",
    "DelegatedRegistry": {
      "Enabled": false,
      "AllowContinuousDevelopmentAccess": false,
      "Scopes": [
        "https://graph.microsoft.com/AgentRegistration.ReadWrite.All",
        "https://graph.microsoft.com/AgentRegistration.Read.All"
      ]
    }
  },
  "Purview": {
    "Enabled": false,
    "DefaultMode": "AuditOnly",
    "ProtectionScopeCacheMinutes": 30,
    "RequestTimeoutSeconds": 15,
    "AppName": "A365 Gateway",
    "AppVersion": "1.0"
  },
  "PromptShield": {
    "Enabled": false,
    "Endpoint": "",
    "ApiVersion": "2024-09-01",
    "RequestTimeoutSeconds": 10,
    "ReceiptLifetimeSeconds": 300
  },
  "Observability": {
    "ApplicationInsightsConnectionString": ""
  },
  "AllowedHosts": "*",
  "Infrastructure": {
    "Provider": "Runtime"
  }
}
