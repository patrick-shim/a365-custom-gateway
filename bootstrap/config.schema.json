{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://a365gateway.local/bootstrap/config.schema.json",
  "title": "A365 Custom Gateway bootstrap configuration",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "subscriptionId",
    "tenantId",
    "environment",
    "location",
    "projectName",
    "resourceGroupName",
    "alertEmail",
    "capabilityPreset",
    "sql",
    "agent365",
    "promptShield",
    "purview"
  ],
  "properties": {
    "$schema": { "type": "string" },
    "subscriptionId": {
      "type": "string",
      "format": "uuid",
      "not": { "const": "00000000-0000-0000-0000-000000000000" }
    },
    "tenantId": {
      "type": "string",
      "format": "uuid",
      "not": { "const": "00000000-0000-0000-0000-000000000000" }
    },
    "environment": { "enum": ["dev", "staging", "prod"] },
    "location": { "type": "string", "pattern": "^[a-z0-9]+$" },
    "projectName": { "type": "string", "pattern": "^[a-z][a-z0-9]{1,7}$" },
    "resourceGroupName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 90,
      "pattern": "^(?=.{1,90}$)[A-Za-z0-9._()\\-]*[A-Za-z0-9_()\\-]$"
    },
    "alertEmail": { "type": "string", "format": "email" },
    "capabilityPreset": {
      "enum": ["fullEvaluation", "coreGateway", "custom"]
    },
    "sql": {
      "type": "object",
      "additionalProperties": false,
      "required": ["skuName", "skuTier"],
      "properties": {
        "skuName": { "enum": ["Basic", "S0", "S1", "S2", "S3", "P1", "P2", "GP_S_Gen5_1", "GP_S_Gen5_2"] },
        "skuTier": { "enum": ["Basic", "Standard", "Premium", "GeneralPurpose"] }
      },
      "oneOf": [
        {
          "properties": {
            "skuName": { "const": "Basic" },
            "skuTier": { "const": "Basic" }
          }
        },
        {
          "properties": {
            "skuName": { "enum": ["S0", "S1", "S2", "S3"] },
            "skuTier": { "const": "Standard" }
          }
        },
        {
          "properties": {
            "skuName": { "enum": ["P1", "P2"] },
            "skuTier": { "const": "Premium" }
          }
        },
        {
          "properties": {
            "skuName": { "enum": ["GP_S_Gen5_1", "GP_S_Gen5_2"] },
            "skuTier": { "const": "GeneralPurpose" }
          }
        }
      ]
    },
    "agent365": {
      "type": "object",
      "additionalProperties": false,
      "required": ["seedBlueprintName", "allowDevelopmentRegistryPreview", "registryBetaAcknowledged", "reviewedManagerApplicationIds"],
      "properties": {
        "seedBlueprintName": { "type": "string", "minLength": 1, "maxLength": 100 },
        "allowDevelopmentRegistryPreview": { "type": "boolean" },
        "registryBetaAcknowledged": { "type": "boolean" },
        "reviewedManagerApplicationIds": {
          "type": "array",
          "minItems": 1,
          "maxItems": 10,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[0-9a-fA-F]{8}-(?:[0-9a-fA-F]{4}-){3}[0-9a-fA-F]{12}$"
          }
        }
      }
    },
    "promptShield": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "skuName", "costAndQuotaAcknowledged"],
      "properties": {
        "enabled": { "type": "boolean" },
        "skuName": { "enum": ["F0", "S0"] },
        "costAndQuotaAcknowledged": { "type": "boolean" }
      }
    },
    "purview": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "authorityRequirementsAcknowledged"],
      "properties": {
        "enabled": { "type": "boolean" },
        "authorityRequirementsAcknowledged": { "type": "boolean" },
        "collectionPolicyName": { "type": "string", "minLength": 1, "deprecated": true },
        "dlpPolicyName": { "type": "string", "minLength": 1, "deprecated": true },
        "dlpRuleName": { "type": "string", "minLength": 1, "deprecated": true },
        "sensitiveInformationTypeId": {
          "type": "string",
          "pattern": "^(?:|[0-9a-fA-F]{8}-(?:[0-9a-fA-F]{4}-){3}[0-9a-fA-F]{12})$",
          "deprecated": true
        },
        "sensitiveInformationType": { "type": "string", "maxLength": 255, "deprecated": true },
        "activateGatewayAdapterAfterPolicyReadback": { "type": "boolean", "deprecated": true },
        "policyProvisioningEnabled": { "type": "boolean", "deprecated": true },
        "policyProvisioningOrganization": { "type": "string", "deprecated": true },
        "policyProvisioningApplicationId": { "type": "string", "deprecated": true },
        "policyProvisioningCertificateSecretUri": { "type": "string", "deprecated": true }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "agent365": {
            "properties": {
              "allowDevelopmentRegistryPreview": { "const": true }
            },
            "required": ["allowDevelopmentRegistryPreview"]
          }
        },
        "required": ["agent365"]
      },
      "then": {
        "properties": {
          "environment": { "const": "dev" },
          "agent365": {
            "properties": {
              "registryBetaAcknowledged": { "const": true }
            },
            "required": ["registryBetaAcknowledged"]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "promptShield": {
            "properties": {
              "enabled": { "const": true }
            },
            "required": ["enabled"]
          }
        },
        "required": ["promptShield"]
      },
      "then": {
        "properties": {
          "promptShield": {
            "properties": {
              "costAndQuotaAcknowledged": { "const": true }
            },
            "required": ["costAndQuotaAcknowledged"]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "purview": {
            "properties": {
              "enabled": { "const": true }
            },
            "required": ["enabled"]
          }
        },
        "required": ["purview"]
      },
      "then": {
        "properties": {
          "purview": {
            "properties": {
              "authorityRequirementsAcknowledged": { "const": true }
            },
            "required": ["authorityRequirementsAcknowledged"]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "purview": {
            "properties": {
              "sensitiveInformationType": { "minLength": 1 }
            },
            "required": ["sensitiveInformationType"]
          }
        },
        "required": ["purview"]
      },
      "then": {
        "properties": {
          "purview": {
            "properties": {
              "sensitiveInformationTypeId": {
                "pattern": "^[0-9a-fA-F]{8}-(?:[0-9a-fA-F]{4}-){3}[0-9a-fA-F]{12}$"
              }
            },
            "required": ["sensitiveInformationTypeId"]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "purview": {
            "required": ["sensitiveInformationTypeId"]
          }
        },
        "required": ["purview"]
      },
      "then": {
        "properties": {
          "purview": {
            "required": ["sensitiveInformationType"]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "purview": {
            "properties": {
              "policyProvisioningEnabled": { "const": true }
            },
            "required": ["policyProvisioningEnabled"]
          }
        },
        "required": ["purview"]
      },
      "then": {
        "properties": {
          "purview": {
            "properties": {
              "enabled": { "const": true },
              "policyProvisioningOrganization": {
                "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9.-]*[A-Za-z0-9])?\\.[A-Za-z]{2,}$"
              },
              "policyProvisioningApplicationId": {
                "format": "uuid",
                "not": { "const": "00000000-0000-0000-0000-000000000000" }
              },
              "policyProvisioningCertificateSecretUri": {
                "pattern": "^https://[A-Za-z0-9-]+\\.vault\\.azure\\.net/secrets/[A-Za-z0-9-]{1,127}$"
              }
            },
            "required": [
              "enabled",
              "policyProvisioningOrganization",
              "policyProvisioningApplicationId",
              "policyProvisioningCertificateSecretUri"
            ]
          }
        }
      }
    }
  ]
}
